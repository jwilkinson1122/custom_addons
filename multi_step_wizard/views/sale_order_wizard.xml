<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.wizard.form</field>
        <field name="model">sale.order.wizard</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="multi_step_wizard.multi_step_wizard_form" />
        <field name="arch" type="xml">
            <xpath expr="//footer" position="inside">
                <button name="reset_section" string="Reset Section" type="object" class="btn-secondary" />
            </xpath>
            <xpath expr="//footer" position="before">
                <field name="current_category_id" invisible="1" />
                <field name="available_product_ids" invisible="1"/>
                <field name="available_attribute_values" invisible="1" />

                <group name="dynamic_section" invisible="state not in ('shell_foundation', 'arch_height', 'top_cover', 'bottom_cover', 'cushion', 'extension', 'options')">
                    <div class="oe_title">
                        <h3>
                            <field name="state_display" readonly="1" nolabel="1"/>
                        </h3>
                    </div>
                    <group>
                        <field name="laterality" widget="radio" options="{'horizontal': true}"/>
                        <!-- <field name="section_product_id"/> -->
                        <!-- <field name="section_product_id" invisible="state in ['summary', 'final']" required="state not in ['summary', 'final']" options="{'no_create': True, 'no_open': True}"/> -->
                        <field name="section_product_id" invisible="state in ['summary', 'final']" required="state not in ['summary', 'final']" options="{'no_create': True, 'no_open': True}" context="{'default_categ_id': current_category_id}"/>



                        <field name="section_attribute_ids" widget="many2many_tags" domain="[('id', 'in', available_attribute_values)]"/>
                        <field name="section_price" readonly="1"/>
                    </group>
                    <div class="oe_title">
                        <h3>Running Total</h3>
                    </div>
                    <field name="formatted_total_price" readonly="1" />
                </group>
                <group name="summary" invisible="state != 'summary'">
                    <div class="oe_title">
                        <h3>Summary</h3>
                    </div>
                    <field name="summary" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- Action for the Wizard -->
    <record id="action_open_sale_order_wizard" model="ir.actions.act_window">
        <field name="name">Configure Sales Order</field>
        <field name="res_model">sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_sale_order_id': active_id}</field>
    </record>

</odoo>
