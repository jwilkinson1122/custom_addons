<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.wizard.form</field>
        <field name="model">sale.order.wizard</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="multi_step_wizard.multi_step_wizard_form" />
        <field name="arch" type="xml">
            <!-- Hidden Fields -->
            <xpath expr="//form" position="inside">
                <field name="current_category_id" invisible="1" />
                <field name="available_product_ids" invisible="1"/>
                <field name="available_attribute_values" invisible="1" />
                <field name="state" invisible="1"/>
                <field name="total_price" invisible="1"/>
                <field name="currency_id" invisible="1"/>
            </xpath>

            <!-- Dynamic Section Content -->
            <xpath expr="//footer" position="before">
                <!-- Product Configuration Section -->
                <group name="dynamic_section" invisible="state not in ('shell_foundation', 'arch_height', 'top_cover', 'bottom_cover', 'cushion', 'extension', 'options')" class="oe_edit_only">
                    <!-- Section Header -->
                    <div class="oe_title mb16">
                        <h2>
                            <field name="state_display" readonly="1" nolabel="1" class="text-center"/>
                        </h2>
                    </div>

                    <!-- Main Configuration Group -->
                    <group col="4">
                        <!-- Laterality Selection -->
                        <group string="Orientation" colspan="2">
                            <field name="laterality" widget="radio" options="{'horizontal': true}" required="state not in ['summary', 'final']"/>
                        </group>

                        <!-- Product Selection -->
                        <group string="Product Details" colspan="2">
                            <field name="section_product_id" invisible="state in ['summary', 'final']" required="state not in ['summary', 'final']" options="{'no_create': True, 'no_open': True}" domain="[('id', 'in', available_product_ids)]"/>
                            <field name="section_attribute_ids" widget="many2many_tags" domain="[('id', 'in', available_attribute_values)]"/>
                        </group>
                    </group>

                    <!-- Price Information -->
                    <group string="Price Information" class="mt16">
                        <group>
                            <field name="section_price" readonly="1" widget="float" digits="[16,2]"/>
                            <field name="total_price" readonly="1" widget="float" digits="[16,2]"/>
                        </group>
                    </group>
                </group>

                <!-- Summary Section -->
                <group name="summary" invisible="state != 'summary'">
                    <div class="oe_title mb16">
                        <h2>Order Summary</h2>
                    </div>
                    <field name="summary" readonly="1" nolabel="1"/>
                    <group class="mt16">
                        <group>
                            <field name="summary_total" readonly="1" widget="float" digits="[16,2]"/>
                        </group>
                    </group>
                </group>
            </xpath>

            <!-- Footer Buttons -->
            <xpath expr="//footer" position="inside">
                <button name="reset_section" string="Reset Section" type="object" class="btn btn-secondary" invisible="state in ['summary', 'final']"/>
                <button name="action_debug_products" string="Debug Products" type="object" class="btn btn-secondary" groups="base.group_system"/>
            </xpath>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_open_sale_order_wizard" model="ir.actions.act_window">
        <field name="name">Configure Sales Order</field>
        <field name="res_model">sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_sale_order_id': active_id,
            'form_view_initial_mode': 'edit'
        }</field>
    </record>
</odoo>
