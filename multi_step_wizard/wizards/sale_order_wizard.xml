<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="sale_order_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.wizard.form</field>
        <field name="model">sale.order.wizard</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="multi_step_wizard.multi_step_wizard_form" />
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <!-- Start Step -->
                <group name="start" invisible="state != 'start'">
                    <group>
                        <field name="product_id" string="Select Product" options="{'no_create': True}" />
                        <field name="field1" placeholder="Enter Configuration 1" string="Configuration 1" />
                    </group>
                </group>
                <!-- Configure Step -->
                <group name="configure" invisible="state != 'configure'">
                    <group>
                        <field name="product_id" string="Select Top Cover Product" options="{'no_create': True}" />
                        <!-- <field name="selected_attribute_value_ids" widget="many2many_tags" domain="[('id', 'in', available_attribute_values)]" string="Select Attributes" /> -->
                        <field name="field2" placeholder="Enter Configuration 2" string="Configuration 2" />
                    </group>
                </group>
                <!-- <group name="configure" invisible="state != 'configure'">
                    <field name="product_id" string="Select Top Cover Product" options="{'no_create': True}" />
                    <field name="selected_attribute_value_ids" widget="many2many_tags" domain="[('id', 'in', available_attribute_values)]" string="Select Attributes" />
                    <field name="field2" placeholder="Enter Configuration 2" string="Configuration 2" />
                </group> -->

                <!-- Customize Step -->
                <group name="custom" invisible="state != 'custom'">
                    <group>
                        <field name="field3" placeholder="Enter Customization" string="Customization" />
                    </group>
                </group>
                <!-- Summary Step -->
                <group name="summary" invisible="state != 'summary'">
                    <field name="summary" readonly="1" string="Summary of Selections" />
                </group>
            </xpath>
        </field>
    </record>


    <!-- Action for the Wizard -->
    <record id="action_open_sale_order_wizard" model="ir.actions.act_window">
        <field name="name">Configure Sales Order</field>
        <field name="res_model">sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_sale_order_id': active_id}</field>
    </record>
</odoo>
