<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit the sale report template for adding the section wise subtotal -->
    <template id="inherit_report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <!-- Initialize the section subtotal -->
        <xpath expr="//td[@name='td_section_line']" position="before">
            <t t-set="section_subtotal" t-value="0"/>
        </xpath>

        <!-- Loop through order lines and calculate subtotals -->
        <xpath expr="//tbody" position="inside">
            <t t-foreach="doc.order_line" t-as="line">
                <t t-if="line.display_type == 'line_section'">
                    <!-- Print the section name and reset the subtotal -->
                    <tr>
                        <td colspan="99">
                            <span t-field="line.name"/>
                            <span t-if="section_subtotal" t-esc="section_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="float: right;"/>
                        </td>
                    </tr>
                    <t t-set="section_subtotal" t-value="0"/>
                </t>
                <t t-else="">
                    <!-- Add the line's subtotal to the section subtotal -->
                    <t t-set="section_subtotal" t-value="section_subtotal + line.price_subtotal"/>
                </t>
            </t>
        </xpath>

        <!-- Replace the td_section_line with updated logic -->
        <xpath expr="//td[@name='td_section_line']" position="replace">
            <td name="td_section_line" colspan="99">
                <span t-field="line.name"/>
                <span t-esc="section_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="float: right;"/>
            </td>
        </xpath>
    </template>
