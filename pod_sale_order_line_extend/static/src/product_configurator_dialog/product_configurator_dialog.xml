<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
	<t t-name="sale_order_customization.dialog_inherit_custom" t-inherit="sale_product_configurator.dialog" t-inherit-mode="extension">
		<xpath expr="//t[@t-set-slot='footer']" position="replace">
            <t t-set-slot="footer">
<!--                <button-->
<!--                    class="btn btn-primary"-->
<!--                    t-on-click="onConfirm"-->
<!--                    t-att-disabled="!isPossibleConfiguration()">-->
<!--                    Confirm-->
<!--                </button>-->
                <button class="btn btn-primary" t-on-click="onContinue">
                    Add to sale order
                </button>
                <button class="btn btn-secondary" t-on-click="onDiscard">
                    Cancel
                </button>
            </t>
		</xpath>
	</t>
	<t t-name="sale_order_customization.product_inherit_custom" t-inherit="sale_product_configurator.product" t-inherit-mode="extension">
		<xpath expr="//td[hasclass('o_sale_product_configurator_qty')]" position="replace">
			<td class="o_sale_product_configurator_qty py-3 px-0 text-end">
                <div t-if="!this.props.optional" class="input-group justify-content-end">
                    <div class="d-flex flex-column align-items-end">
                        <div class="d-flex mb-2">
                            <button class="btn btn-secondary d-none d-md-inline-block" aria-label="Remove one" t-on-click="decreaseQuantity">
                                <i class="fa fa-minus"/>
                            </button>
                            <input class="form-control quantity border-bottom border-top text-center"
                                   style="min-width: 30px;"
                                   name="product_quantity"
                                   type="number"
                                   t-att-value="this.props.quantity"
                                   t-on-change="setQuantity"/>
                            <button class="btn btn-secondary d-none d-md-inline-block" aria-label="Add one" t-on-click="increaseQuantity">
                                <i class="fa fa-plus"/>
                            </button>
                        </div>
                        <div class="d-flex">
                            <label for="user_price" style="margin-right: 5px;">Price: </label>
                            <input id="user_price" class="form-control js_user_ptice"  t-on-change="updateUserPrice"
                                   style="min-width: 110px;text-align: right;" t-att-value="this.props.price"
                                   name="custom_product_price"
                                   type="number"/>
                        </div>
                    </div>
                </div>
                <div t-else="">
                    <h5 class="text-nowrap" t-out="getFormattedPrice()"/>
                </div>
                <a class="d-block mt-2" role="button" t-if="!this.props.optional &amp;&amp; this.env.mainProductTmplId !== this.props.product_tmpl_id" t-on-click="() => this.env.removeProduct(this.props.product_tmpl_id)">
                    Remove product
                </a>
            </td>
		</xpath>
	</t>
</templates>
