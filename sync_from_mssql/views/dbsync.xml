                <filter string="Errors Only" domain="[('log_type', '=', 'error')]"/>
                <filter string="Info Only" domain="[('log_type', '=', 'info')]"/>
            </search>
        </field>
    </record> -->

        <!-- Action for MSSQL Sync -->
        <record id="action_dbsync" model="ir.actions.act_window">
            <field name="name">Sync From MSSQL</field>
            <field name="res_model">base.db.sync.mssql</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Action for Table Mapping -->
        <record id="action_dbsync_table" model="ir.actions.act_window">
            <field name="name">MSSQL Table Mappings</field>
            <field name="res_model">base.db.sync.mssql.table</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Action for Managing Field Mappings -->
        <record id="action_dbsync_field" model="ir.actions.act_window">
            <field name="name">MSSQL Field Mappings</field>
            <field name="res_model">base.db.sync.mssql.field</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Action for Sync Logs -->
        <record id="action_dbsync_log" model="ir.actions.act_window">
            <field name="name">Database Sync Logs</field>
            <field name="res_model">base.db.sync.log</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_external_db_root" name="External DB Sync" parent="base.next_id_9" />
        <menuitem id="menu_external_db_source" name="Database Sources" parent="menu_external_db_root" action="action_dbsource" sequence="0"/>
        <menuitem id="menu_external_db_sync" name="Sync From MSSQL" parent="menu_external_db_root" action="action_dbsync" sequence="1"/>
        <menuitem id="menu_external_db_sync_table" name="Table Mappings" parent="menu_external_db_root" action="action_dbsync_table" sequence="2"/>
        <menuitem id="menu_external_db_sync_field" name="Field Mappings" parent="menu_external_db_root" action="action_dbsync_field" sequence="3"/>
        <menuitem id="menu_external_db_sync_log" name="Sync Logs" parent="menu_external_db_root" action="action_dbsync_log" sequence="4"/>

    </data>
</odoo>
