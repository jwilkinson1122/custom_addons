<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View for Database Sources -->
        <record model="ir.ui.view" id="view_dbsource_tree">
            <field name="name">base.db.source.tree</field>
            <field name="model">base.db.source</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="source_name"/>
                    <field name="source_host"/>
                    <field name="source_db_name"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Database Sources -->
        <record model="ir.ui.view" id="view_dbsource_form">
            <field name="name">base.db.source.form</field>
            <field name="model">base.db.source</field>
            <field name="arch" type="xml">
                <form string="External DB Source">
                    <sheet>
                        <group>
                            <field name="source_name"/>
                            <field name="source_host"/>
                            <field name="source_db_name"/>
                            <field name="source_user_id"/>
                            <field name="source_password" password="True"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <button name="test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Database Sources -->
        <record id="action_dbsource" model="ir.actions.act_window">
            <field name="name">Database Sources</field>
            <field name="res_model">base.db.source</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Tree View for MSSQL Sync -->
        <record model="ir.ui.view" id="view_dbsync_tree">
            <field name="name">base.db.sync.mssql.tree</field>
            <field name="model">base.db.sync.mssql</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree decoration-success="last_updated" decoration-danger="not active">
                    <field name="sync_name"/>
                    <field name="source"/>
                    <field name="last_updated"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Form View for MSSQL Sync -->
        <record model="ir.ui.view" id="view_dbsync_form">
            <field name="name">base.db.sync.mssql.form</field>
            <field name="model">base.db.sync.mssql</field>
            <field name="arch" type="xml">
                <form string="MSSQL Sync">
                    <header>
                        <button name="process_sync" type="object" string="Run Sync Now" class="oe_highlight"/>
                        <button name="action_resync_all" type="object" string="Re-Sync All Records" class="oe_highlight"/>

                        <!-- <button name="start_wash" class="oe_highlight" string="Start" type="object" states="draft"/>
                        <button name="set_to_done" class="oe_highlight" string="Set to Done" type="object" states="process"/> -->
                        <!-- <field name="state" widget="statusbar" statusbar_visible="draft,process,done"/> -->
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sync_name"/>
                                <field name="source"/>
                            </group>
                            <group>
                                <field name="last_updated" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <!-- <button name="process_sync" type="object" string="Run Sync Now" class="oe_highlight"/>
                        <button name="action_resync_all" type="object" string="Re-Sync All Records" class="oe_highlight"/> -->
                        <!-- <div class="oe_button_box" name="button_box" style="margin-bottom: 10px;">
                            <button name="process_sync" type="object" string="🔄 Run Sync Now" class="oe_stat_button oe_highlight"/>
                            <button name="action_resync_all" type="object" string="🔁 Re-Sync All Records" class="oe_stat_button btn-primary" style="margin-left: 10px;"/>
                        </div> -->
                        <!-- <div>
                            <button name="process_sync" type="object" string="🔄 Run Sync Now" class="oe_stat_button oe_highlight"/>
                            <button name="action_resync_all" type="object" string="🔁 Re-Sync All Records" class="oe_stat_button btn-primary" style="margin-left: 10px;"/>
                        </div> -->

                        <notebook>
                            <page string="Tables">
                                <field name="table_ids" widget="one2many">
                                    <tree editable="bottom">
                                        <field name="source_table"/>
                                        <field name="destination_model" options="{'no_create': True}"/>
                                        <!-- ModifiedOn -->
                                        <field name="modified_stamp_field"/>
                                        <field name="update_all" widget="boolean_toggle"/>
                                        <button name="action_show_details" type="object" icon="fa-list" title="Show Details"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Sync Logs">
                                <field name="sync_logs" widget="text" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for Table Mapping - This will be used inside the One2many field (table_ids) in Sync From MSSQL. -->
        <record model="ir.ui.view" id="view_dbsync_table_tree">
            <field name="name">base.db.sync.mssql.table.tree</field>
            <field name="model">base.db.sync.mssql.table</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="source_table"/>
                    <field name="destination_model" options="{'no_create': True}"/>
                    <field name="modified_stamp_field"/>
                    <field name="update_all" widget="boolean_toggle"/>
                    <button name="action_show_details" type="object" icon="fa-list" title="Show Details"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Table Mapping - This is used when opening an individual table record. -->
        <record model="ir.ui.view" id="view_dbsync_table_form">
            <field name="name">base.db.sync.mssql.table.form</field>
            <field name="model">base.db.sync.mssql.table</field>
            <field name="arch" type="xml">
                <form string="MSSQL Table Mapping">
                    <sheet>
                        <group>
                            <field name="source_table"/>
                            <field name="destination_model"/>
                            <field name="modified_stamp_field"/>
                            <field name="update_all"/>
                            <field name="sync_all" />
                        </group>
                        <notebook>
                            <page string="Field Mappings">
                                <field name="field_ids" widget="one2many" context="{'default_dt_id': id}" options="{'no_create': False, 'no_delete': False}">
                                    <tree editable="bottom">
                                        <field name="source_field"/>
                                        <field name="destination_field"/>
                                        <field name="is_pk"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <!-- <notebook>
                            <page string="Field Mappings">
                                <field name="field_ids" widget="one2many" context="{'default_dt_id': active_id}">
                                    <tree editable="bottom">
                                        <field name="source_field"/>
                                        <field name="destination_field"/>
                                        <field name="is_pk"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook> -->
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Tree View for Field Mapping - This will be used inside the One2many field (field_ids) in MSSQL Table Mapping.-->
        <record model="ir.ui.view" id="view_dbsync_field_tree">
            <field name="name">base.db.sync.mssql.field.tree</field>
            <field name="model">base.db.sync.mssql.field</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="sequence" widget="handle" />
                    <field name="source_field"/>
                    <field name="destination_field"/>
                    <field name="is_pk"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Field Mapping - This allows editing of individual field mappings.-->
        <record model="ir.ui.view" id="view_dbsync_field_form">
            <field name="name">base.db.sync.mssql.field.form</field>
            <field name="model">base.db.sync.mssql.field</field>
            <field name="arch" type="xml">
                <form string="MSSQL Field Mapping">
                    <sheet>
                        <group>
                            <field name="dt_id" invisible="1"/>
                            <field name="source_field"/>
                            <field name="destination_field"/>
                            <field name="is_pk"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>





        <!-- <record model="ir.ui.view" id="view_dbsync_search">
        <field name="name">base.db.sync.mssql.search</field>
        <field name="model">base.db.sync.mssql</field>
        <field name="arch" type="xml">
