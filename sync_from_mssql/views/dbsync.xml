<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Database Source -->
        <record id="view_db_source_tree" model="ir.ui.view">
            <field name="name">base.db.source.tree</field>
            <field name="model">base.db.source</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="source_name"/>
                    <field name="source_host"/>
                    <field name="source_db_name"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_db_source_form" model="ir.ui.view">
            <field name="name">base.db.source.form</field>
            <field name="model">base.db.source</field>
            <field name="arch" type="xml">
                <form string="External DB Source">
                    <sheet>
                        <group>
                            <field name="source_name"/>
                            <field name="source_host"/>
                            <field name="source_db_name"/>
                            <field name="source_user_id"/>
                            <field name="source_password" password="True"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <button name="test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Database Sync -->
        <record id="view_db_sync_tree" model="ir.ui.view">
            <field name="name">base.db.sync.mssql.tree</field>
            <field name="model">base.db.sync.mssql</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree decoration-success="last_updated" decoration-danger="not active">
                    <field name="sync_name"/>
                    <field name="source"/>
                    <field name="last_updated"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_db_sync_form" model="ir.ui.view">
            <field name="name">base.db.sync.mssql.form</field>
            <field name="model">base.db.sync.mssql</field>
            <field name="arch" type="xml">
                <form string="MSSQL Sync">
                    <header>
                        <button name="process_sync" type="object" string="Run Sync Now" class="oe_highlight"/>
                        <button name="action_resync_all" type="object" string="Re-Sync All Records" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sync_name"/>
                                <field name="source"/>
                            </group>
                            <group>
                                <field name="last_updated" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <!-- <page string="Tables">
                                <field name="table_ids" widget="one2many">
                                    <tree editable="bottom">
                                        <field name="source_table"/>
                                        <field name="destination_model" options="{'no_create': True}"/>
                                        <field name="modified_stamp_field"/>
                                        <field name="update_all" widget="boolean_toggle"/>
                                        <button name="action_show_details" type="object" icon="fa-list" title="Show Details"/>
                                    </tree>
                                </field>
                            </page> -->
                            <page string="Tables">
                                <field name="table_ids" widget="one2many"/>
                            </page>

                            <page string="Sync Logs">
                                <field name="sync_logs" widget="text" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Sync Logs -->
        <record id="view_db_sync_log_tree" model="ir.ui.view">
            <field name="name">base.db.sync.log.tree</field>
            <field name="model">base.db.sync.log</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="log_time"/>
                    <field name="sync_id"/>
                    <field name="log_type"/>
                    <field name="message"/>
                </tree>
            </field>
        </record>

        <record id="view_db_sync_log_form" model="ir.ui.view">
            <field name="name">base.db.sync.log.form</field>
            <field name="model">base.db.sync.log</field>
            <field name="arch" type="xml">
                <form string="Database Sync Log">
                    <sheet>
                        <group>
                            <field name="sync_id" readonly="1"/>
                            <field name="log_type" readonly="1"/>
                            <field name="log_time" readonly="1"/>
                        </group>
                        <group>
                            <field name="message" widget="text" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Table Mappings -->
        <record id="view_db_sync_table_tree" model="ir.ui.view">
            <field name="name">base.db.sync.mssql.table.tree</field>
            <field name="model">base.db.sync.mssql.table</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="source_table"/>
                    <field name="destination_model" options="{'no_create': True}"/>
                    <field name="modified_stamp_field"/>
                    <field name="update_all" widget="boolean_toggle"/>
                    <button name="action_show_details" type="object" icon="fa-list" title="Show Details"/>
                </tree>
            </field>
        </record>

        <record id="view_db_sync_table_form" model="ir.ui.view">
            <field name="name">base.db.sync.mssql.table.form</field>
            <field name="model">base.db.sync.mssql.table</field>
            <field name="arch" type="xml">
                <form string="MSSQL Table Mapping">
                    <sheet>
                        <group>
                            <field name="ds_id" context="{'default_ds_id': active_id}" />
                            <field name="source_table"/>
                            <field name="destination_model"/>
                            <field name="modified_stamp_field"/>
                            <field name="update_all"/>
                            <field name="sync_all"/>
                        </group>
                        <notebook>
                            <page string="Field Mappings">
                                <field name="field_ids" widget="one2many" context="{'default_dt_id': active_id}" />
                            </page>
                            <page string="Selective Sync">
                                <group>
                                    <field name="selected_columns" placeholder="Example: name, email, phone"/>
                                    <field name="custom_row_filter" placeholder="Example: Status = 'Active'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Field Mappings -->
        <record id="view_db_sync_field_tree" model="ir.ui.view">
            <field name="name">base.db.sync.mssql.field.tree</field>
            <field name="model">base.db.sync.mssql.field</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle" />
                    <field name="source_field"/>
                    <field name="destination_field"/>
                    <field name="is_pk"/>
                </tree>
            </field>
        </record>

        <record id="view_db_sync_field_form" model="ir.ui.view">
            <field name="name">base.db.sync.mssql.field.form</field>
            <field name="model">base.db.sync.mssql.field</field>
            <field name="arch" type="xml">
                <form string="MSSQL Field Mapping">
                    <sheet>
                        <group>
                            <field name="dt_id" invisible="1"/>
                            <field name="source_field"/>
                            <field name="destination_field"/>
                            <field name="is_pk"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <!-- Database Source -->
        <record id="action_db_source" model="ir.actions.act_window">
            <field name="name">External Database Source</field>
            <field name="res_model">base.db.source</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                No database sources found
                </p>
                <p>
                Connect to an external database source to synchronize data into Odoo.
                </p>
            </field>
        </record>

        <record id="action_db_source_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_db_source_tree"/>
            <field name="act_window_id" ref="action_db_source"/>
        </record>

        <record id="action_db_source_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_db_source_form"/>
            <field name="act_window_id" ref="action_db_source"/>
        </record>

        <!-- Database Sync -->
        <record id="action_db_sync" model="ir.actions.act_window">
            <field name="name">External Database Sync</field>
            <field name="res_model">base.db.sync.mssql</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_db_sync_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_db_sync_tree"/>
            <field name="act_window_id" ref="action_db_sync"/>
        </record>

        <record id="action_db_sync_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_db_sync_form"/>
            <field name="act_window_id" ref="action_db_sync"/>
        </record>

        <!-- Sync Logs -->
        <record id="action_db_sync_log" model="ir.actions.act_window">
            <field name="name">Database Sync Logs</field>
            <field name="res_model">base.db.sync.log</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_db_sync_log_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_db_sync_log_tree"/>
            <field name="act_window_id" ref="action_db_sync_log"/>
        </record>

        <record id="action_db_sync_log_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_db_sync_log_form"/>
            <field name="act_window_id" ref="action_db_sync_log"/>
        </record>

        <!-- Table Mappings -->
        <record id="action_db_sync_table" model="ir.actions.act_window">
            <field name="name">Database Sync Table</field>
            <field name="res_model">base.db.sync.mssql.table</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- <record id="action_db_sync_table" model="ir.actions.act_window">
            <field name="name">Database Sync Table</field>
            <field name="res_model">base.db.sync.mssql.table</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode': 'tree', 'view_id': ref('view_db_sync_table_tree')}),
            (0,0,{'view_mode': 'form', 'view_id': ref('view_db_sync_table_form')})]"/>
        </record> -->


        <record id="action_db_sync_table_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_db_sync_table_tree"/>
            <field name="act_window_id" ref="action_db_sync_table"/>
        </record>

        <record id="action_db_sync_table_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_db_sync_table_form"/>
            <field name="act_window_id" ref="action_db_sync_table"/>
        </record>



        <!-- Field Mappings -->
        <record id="action_db_sync_field" model="ir.actions.act_window">
            <field name="name">Database Sync Field</field>
            <field name="res_model">base.db.sync.mssql.field</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_db_sync_field_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_db_sync_field_tree"/>
            <field name="act_window_id" ref="action_db_sync_field"/>
        </record>

        <record id="action_db_sync_field_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_db_sync_field_form"/>
            <field name="act_window_id" ref="action_db_sync_field"/>
        </record>


        <!-- Menus -->
        <menuitem id="menu_external_db_root" name="External DB Sync" parent="base.next_id_9" />
        <menuitem id="menu_external_db_source" name="Database Sources" parent="menu_external_db_root" action="action_db_source" sequence="0"/>
        <menuitem id="menu_external_db_sync" name="Sync From MSSQL" parent="menu_external_db_root" action="action_db_sync" sequence="1"/>
        <menuitem id="menu_external_db_sync_log" name="Sync Logs" parent="menu_external_db_root" action="action_db_sync_log" sequence="2"/>
        <menuitem id="menu_external_db_sync_table" name="Table Mappings" parent="menu_external_db_root" action="action_db_sync_table" sequence="3"/>
        <menuitem id="menu_external_db_sync_field" name="Field Mappings" parent="menu_external_db_root" action="action_db_sync_field" sequence="4"/>

    </data>

</odoo>

 