        <record model="ir.ui.view" id="view_dbsync_table_form">
            <field name="name">base.db.sync.mssql.table.form</field>
            <field name="model">base.db.sync.mssql.table</field>
            <field name="arch" type="xml">
                <form string="MSSQL Table Mapping">
                    <sheet>
                        <group>
                            <field name="ds_id" context="{'default_ds_id': active_id}" />
                            <field name="source_table"/>
                            <field name="destination_model"/>
                            <field name="modified_stamp_field"/>
                            <field name="update_all"/>
                            <field name="sync_all"/>
                        </group>
                        <notebook>
                            <page string="Field Mappings">
                                <field name="field_ids" widget="one2many" context="{'default_dt_id': active_id}" />
                            </page>
                            <page string="Selective Sync">
                                <group>
                                    <field name="selected_columns" placeholder="Example: name, email, phone"/>
                                    <field name="custom_row_filter" placeholder="Example: Status = 'Active'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for Field Mapping - This will be used inside the One2many field (field_ids) in MSSQL Table Mapping.-->
        <record model="ir.ui.view" id="view_dbsync_field_tree">
            <field name="name">base.db.sync.mssql.field.tree</field>
            <field name="model">base.db.sync.mssql.field</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="sequence" widget="handle" />
                    <field name="source_field"/>
                    <field name="destination_field"/>
                    <field name="is_pk"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Field Mapping - This allows editing of individual field mappings.-->
        <record model="ir.ui.view" id="view_dbsync_field_form">
            <field name="name">base.db.sync.mssql.field.form</field>
            <field name="model">base.db.sync.mssql.field</field>
            <field name="arch" type="xml">
                <form string="MSSQL Field Mapping">
                    <sheet>
                        <group>
                            <!-- <field name="dt_id" context="{'default_dt_id': id}" options="{'no_create': False, 'no_delete': False}" invisible="1"/> -->
                            <field name="dt_id" invisible="1"/>
                            <field name="source_field"/>
                            <field name="destination_field"/>
                            <field name="is_pk"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for MSSQL Sync -->
        <record id="action_dbsync" model="ir.actions.act_window">
            <field name="name">Sync From MSSQL</field>
            <field name="res_model">base.db.sync.mssql</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Action for Table Mapping -->
        <record id="action_dbsync_table" model="ir.actions.act_window">
            <field name="name">MSSQL Table Mappings</field>
            <field name="res_model">base.db.sync.mssql.table</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Action for Managing Field Mappings -->
        <record id="action_dbsync_field" model="ir.actions.act_window">
            <field name="name">MSSQL Field Mappings</field>
            <field name="res_model">base.db.sync.mssql.field</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Action for Sync Logs -->
        <record id="action_dbsync_log" model="ir.actions.act_window">
            <field name="name">Database Sync Logs</field>
            <field name="res_model">base.db.sync.log</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_external_db_root" name="External DB Sync" parent="base.next_id_9" />
        <menuitem id="menu_external_db_source" name="Database Sources" parent="menu_external_db_root" action="action_dbsource" sequence="0"/>
        <menuitem id="menu_external_db_sync" name="Sync From MSSQL" parent="menu_external_db_root" action="action_dbsync" sequence="1"/>
        <menuitem id="menu_external_db_sync_table" name="Table Mappings" parent="menu_external_db_root" action="action_dbsync_table" sequence="2"/>
        <menuitem id="menu_external_db_sync_field" name="Field Mappings" parent="menu_external_db_root" action="action_dbsync_field" sequence="3"/>
        <menuitem id="menu_external_db_sync_log" name="Sync Logs" parent="menu_external_db_root" action="action_dbsync_log" sequence="4"/>

    </data>
</odoo>
