<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="contact_name" inherit_id="base.contact_name">
        <xpath expr="//span[@t-esc='name']" position="replace">
            <div class="o_row align-items-center">
                <t t-if="object.customer_code and 'customer_code' in fields">
                    <span class="fw-bold text-muted">Customer ID:</span>
                    <span itemprop="customerCode" class="badge bg-info text-dark ms-2" t-esc="object.customer_code"/>
                    <br/>
                </t>
                <t t-if="object.parent_id.is_company and object.parent_name">
                    <span itemprop="name" class="text-muted fw-bold" t-esc="object.parent_name"/>
                    <br/>
                </t>
                <span itemprop="name" class="fw-bold" t-esc="object.name"/>
            </div>
        </xpath>
    </template>

 
 

</odoo>
