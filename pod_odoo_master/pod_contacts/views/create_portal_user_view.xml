<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_create_user_wizard_form" model="ir.ui.view">
            <field name="name">view.create.user.wizard.form</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <form string="Create Login">
                    <group>
                        <field name="login" string="Email" required="1"/>
                        <field name="password" string="Password" password="True" required="1"/>
                        <field name="partner_id" invisible="1"/>
                    </group>
                </form>
            </field>
        </record>
    </data>
</odoo>
