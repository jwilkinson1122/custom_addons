<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="partner_contact_association_view_form" model="ir.ui.view">
        <field name="name">partner.contact.association.view.form</field>
        <field name="model">res.association</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" position="inside">
                        <button name="action_view_members" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="member_count" string="Members" widget="statinfo" />
                        </button>
                    </div>
                    <h1>
                        <field name="name" />
                    </h1>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_contact_association_view_tree" model="ir.ui.view">
        <field name="name">partner.contact.association.view.tree</field>
        <field name="model">res.association</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="contact_association_action" model="ir.actions.act_window">
        <field name="name">Associations</field>
        <field name="res_model">res.association</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- <menuitem name="Associations" id="partner_contact_association.menu_association" parent="contacts.res_partner_menu_config" action="partner_contact_association.action_view_partner_contact_associations" /> -->

</odoo>
