<odoo>
    <record id="view_product_supplier_info_type_inherit" model="ir.ui.view">
        <field name="name">view.product.supplier.info.type.inherit</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='price']" position="before">
                <field name="supplier_type_id" options="{'no_create_edit': True, 'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>