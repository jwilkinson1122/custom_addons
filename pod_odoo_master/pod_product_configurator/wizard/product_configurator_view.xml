<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_configurator_form" model="ir.ui.view">
        <field name="name">product.configurator</field>
        <field name="model">product.configurator</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" clickable="True"/>
                    <button name="action_reset" string="Reset" type="object" class="oe_highlight" special="no_save" confirm="Are you sure? This will remove your current configuration for this template!" invisible="state == 'select'" />
                    <!-- <button name="action_reset" string="Reset" type="object" class="oe_highlight" special="no_save" confirm="Are you sure? This will remove your current configuration for this template!" invisible="not product_tmpl_id or state == 'select'" /> -->
                    <button name="action_review_differences" string="Review Differences" type="object" class="oe_highlight" invisible="laterality != 'bilateral'" />
                    <button name="action_copy_left_to_right" string="Copy Left to Right" type="object" class="oe_highlight" invisible="laterality != 'bilateral'" />
                    <button name="action_copy_right_to_left" string="Copy Right to Left" type="object" class="oe_highlight" invisible="laterality != 'bilateral'" />
                    <button name="action_customize_laterality" string="Customize Section" type="object" class="oe_highlight" invisible="laterality != 'bilateral' or custom_laterality"/>
                </header>
                <sheet>
                    <field name="product_img" readonly="1" nolabel="1" widget="image" invisible="not product_img"/>
                    <group col="3">
                        <group name="static_form" readonly="state != 'select'" colspan="2">
                            <field name="config_session_id" invisible="1" />
                            <field name="product_id" invisible="1" />
                            <field name="currency_id" invisible="1" />
                            <field name="product_tmpl_id" placeholder="Product Template" readonly="context.get('product_tmpl_id_readonly', False)" required="True" options="{'no_create': True}" force_save="1"/>
                            <field name="laterality" widget="radio" required="True" options="{'horizontal': true}"/>
                            <field name="custom_laterality"/>
                            <field name="product_preset_id" placeholder="Product Preset" invisible="not context.get('allow_preset_selection')" options="{'no_create': True}"/>
                    
                            <separator string="To reset/change the Preset, please close and start the configuration again" invisible="context.get('allow_preset_selection')" colspan="2"/>
                             
                             <field name="attribute_line_ids" invisible="state != 'select'">
                                <tree string="Attributes" editable="bottom">
                                    <field name="attribute_id" />
                                    <field name="multi" id="multi"/>
                                    <field name="custom" id="custom"/>
                                    <field name="required" id="required"/>
                                </tree>
                            </field>
                             <field name="laterality_config_ids" invisible="not custom_laterality">
                                <tree string="Side Configuration" editable="bottom">
                                    <field name="side" />
                                    <field name="attribute_id" />
                                    <field name="value_id" />
                                </tree>
                            </field>
                        </group>
                        <group colspan="1">
                            <field name="quantity"/>
                            <field name="price" widget='monetary' options="{'currency_field': 'currency_id', 'field_digits': True}" />
                            <field name="weight" invisible="1"/>
                        </group>
                    </group>
                    <!-- ADD THE DYNAMIC FORM GROUP HERE -->
                    <group name="dynamic_form" colspan="2">
                        <!-- Dynamic attributes will be inserted here -->
                    </group>
            
                    <!-- <group string="Laterality Configuration" invisible="not custom_laterality">
                        <field name="laterality_config_ids">
                            <tree string="Side Configuration" editable="bottom">
                                <field name="side" />
                                <field name="attribute_id" />
                                <field name="value_id" />
                            </tree>
                        </field>
                    </group>

                    <group string="Attributes" invisible="laterality == 'bilateral' and custom_laterality">
                        <field name="attribute_line_ids" invisible="state != 'select'">
                            <tree string="Attributes" editable="bottom">
                                <field name="attribute_id" />
                                <field name="multi" id="multi"/>
                                <field name="custom" id="custom"/>
                                <field name="required" id="required"/>
                            </tree>
                        </field>
                    </group> -->

                    <notebook>
                        <!-- Comparison Tab (Only for Bilateral) -->
                        <page string="Compare Left vs Right" invisible="laterality != 'bilateral'">
                            <field name="laterality_comparison" widget="text" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- FOOTER -->
                <footer>
                    <field name="value_ids" readonly="1" force_save="1" invisible="1"/>
                    <button type="object" name="action_previous_step" string="Back" invisible="state == 'select'" />
                    <button type="object" name="action_next_step" class="oe_highlight" string="Next" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_product_configurator_template_tree" model="ir.ui.view">
        <field name="name">product.configurator.template.tree</field>
        <field name="model">product.configurator.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="laterality"/>
            </tree>
        </field>
    </record>

    <record id="view_product_configurator_template_form" model="ir.ui.view">
        <field name="name">product.configurator.template.form</field>
        <field name="model">product.configurator.template</field>
        <field name="arch" type="xml">
            <form string="Configuration Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="laterality"/>
                    </group>

                    <group>
                        <field name="laterality_config_ids">
                            <tree editable="bottom">
                                <field name="side"/>
                                <field name="attribute_id"/>
                                <field name="value_id"/>
                            </tree>
                        </field>
                    </group>
                </sheet>

                <footer>
                    <button string="Save" type="object" name="action_save_template" class="oe_highlight"/>
                    <button string="Delete" type="object" name="unlink" class="btn-danger"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_configurator_template" model="ir.actions.act_window">
        <field name="name">Configuration Templates</field>
        <field name="res_model">product.configurator.template</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- <menuitem id="menu_product_configurator_root" name="Product Configurator" sequence="10" />
    <menuitem id="menu_product_configurator_templates" name="Configuration Templates" parent="menu_product_configurator_root" action="action_product_configurator_template"/> -->


</odoo>
