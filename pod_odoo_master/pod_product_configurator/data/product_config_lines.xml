<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<!-- Configuration Restriction Lines -->
  <record id="product_config_line_vinyl_colors" model="product.config.line">
      <field name="product_tmpl_id" ref="product_template_superglass_flex" />
      <field name="attribute_line_id" ref="ptal_superglass_flex_top_cover_color" />
      <field name="value_ids" eval="[(6, 0, [
      ref('pav_top_cover_color_charcoal'),
      ref('pav_top_cover_color_dark_brown'), 
      ref('pav_top_cover_color_gray_tan'),
      ref('pav_top_cover_color_blue_gray')
      ])]" />
      <field name="domain_id" ref="product_config_domain_vinyl" />
  </record>
  <record id="product_config_line_leather_colors" model="product.config.line">
      <field name="product_tmpl_id" ref="product_template_superglass_flex" />
      <field name="attribute_line_id" ref="ptal_superglass_flex_top_cover_color" />
      <field name="value_ids" eval="[(6, 0, [
      ref('pav_top_cover_color_black')
      ])]" />
      <field name="domain_id" ref="product_config_domain_leather" />
  </record>
  <record id="product_config_line_microsuede_colors" model="product.config.line">
      <field name="product_tmpl_id" ref="product_template_superglass_flex" />
      <field name="attribute_line_id" ref="ptal_superglass_flex_top_cover_color" />
      <field name="value_ids" eval="[(6, 0, [
      ref('pav_top_cover_color_black'),
      ref('pav_top_cover_color_gray')
      ])]" />
      <field name="domain_id" ref="product_config_domain_microsuede" />
  </record>
  
</odoo>
