<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Predefined Contact Roles -->
    <record id="role_admin" model="res.partner.role">
        <field name="name">Administrator</field>
        <field name="description">Responsible for administrative tasks and decisions.</field>
    </record>
    <record id="role_provider" model="res.partner.role">
        <field name="name">Service Provider</field>
        <field name="description">Responsible for providing services to clients.</field>
    </record>
    <record id="role_accountant" model="res.partner.role">
        <field name="name">Accountant</field>
        <field name="description">Manages financial records and transactions.</field>
    </record>
    <record id="role_technician" model="res.partner.role">
        <field name="name">Technician</field>
        <field name="description">Handles technical tasks and issues.</field>
    </record>
</odoo>
