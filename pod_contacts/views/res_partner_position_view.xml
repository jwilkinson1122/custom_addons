<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_position_tree_view" model="ir.ui.view">
        <field name="name">res.partner.position.tree</field>
        <field name="model">res.partner.position</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>
    <record id="res_partner_position_form_view" model="ir.ui.view">
        <field name="name">res.partner.position.form</field>
        <field name="model">res.partner.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="res_partner_position_action" model="ir.actions.act_window">
        <field name="name">Contact Positions</field>
        <field name="res_model">res.partner.position</field>
        <field name="view_mode">tree,form</field>
    </record>

