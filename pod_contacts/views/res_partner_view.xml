<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">Is a Company Parent Partner Form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button name="action_view_company_group_members" type="object" string="Company Groups" class="oe_stat_button" icon="fa-users">
                    <field name="company_group_member_ids" widget="statinfo" />
                </button>
                <button name="create_contacts" type="object" string="Create Portal Contact" class="oe_highlight" icon="fa-address-card-o" context="{'default_is_contact': True}" invisible="not is_contact"/>
                <button name="create_contacts" type="object" string="Create Portal Patient" class="oe_highlight" icon="fa-address-card-o" context="{'default_is_patient': True}" invisible="not is_patient"/>
            </div>
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="readonly">not is_company and parent_id</attribute>
            </xpath>
            <xpath expr="//field[@name='vat']" position="before">
                <field name="tz" />
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_company_parent"/>
                <field name="is_company"/>
                <field name="is_contact"/>
                <field name="is_patient"/>

                <field name="highest_parent_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='city']" position="before">
                <field name="zip_id" options="{'create_name_field': 'city', 'no_open': True, 'no_create': True}" placeholder="Location completion" readonly="type == 'contact' and parent_id != False" />
            </xpath>
            <xpath expr="/form/sheet/group/group/div/field[@name='street2']" position="after">
                <field name="street3" placeholder="Street 3..." class="o_address_street" readonly="type == 'contact' and parent_id != False" />
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="company_group_id" widget="res_partner_many2one" invisible="not is_company" />
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='function']" position="before">
                <field name="contact_role_ids" widget="many2many_tags" invisible="is_company" />
                <field name="contact_position_id" invisible="is_company" options='{"no_open": True}'/>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="fax" placeholder="Fax..." widget="phone" />
            </xpath>

            <!-- Contacts & Addresses -->
            <!-- Modify the contact_addresses page attributes -->
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="autofocus"></attribute>
                <attribute name="string">Contacts</attribute>
                <attribute name="invisible">not is_company</attribute>
            </xpath>
            <!-- Modify the child_ids field context -->
            <xpath expr="//page[@name='contact_addresses']//field[@name='child_ids']" position="attributes">
                <attribute name="context">{'default_parent_id': active_id, 'default_is_company':
                    False, 'default_type':'contact', 'search_default_parent_id': active_id}</attribute>
                <attribute name="options">{'kanban_view': {'create': True}}</attribute>
            </xpath>
            <!-- Add an alert to the contact_addresses page -->
            <xpath expr="//page[@name='contact_addresses']//field[@name='child_ids']" position="before">
                <separator name="contacts" string="Contacts List" />
                <div name="alert_no_contacts" class="oe_read_only alert alert-info mb8" role="alert" invisible="not child_ids">
                    No Contacts Available
                </div>
            </xpath>

            <xpath expr="//field[@name='child_ids']" position="before">
                <group>
                    <group>
                        <field name="use_parent_invoice_address" invisible="not parent_id" />
                    </group>
                </group>
                <newline/>
                <group>
                    <group>
                        <field name="partner_delivery_id" domain="[('id', 'child_of', commercial_partner_id), ('type', '=', 'delivery')]" options="{'no_open': True, 'no_create': True}" />
                        <field name="partner_invoice_id" domain="[('id', 'child_of', commercial_partner_id), ('type', '=', 'invoice')]" options="{'no_open': True, 'no_create': True}" />
                    </group>
                    <group>
                        <field name="partner_contact_id" domain="[('id', 'child_of', commercial_partner_id), ('type', '=', 'contact')]" options="{'no_open': True, 'no_create': True}" />
                    </group>
                </group>
                <newline/>
            </xpath>

            <!-- Contacts & Addresses Modal Popup View -->

            <xpath expr="//field[@name='child_ids']/form//field[@name='name']" position="before">
                <field name="is_company" invisible="True" />
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='title']" position="after">
                <field name="contact_position_id" invisible="is_company == True" options='{"no_open": True}'/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='city']" position="before">
                <field name="zip_id" options="{'create_name_field': 'city', 'no_open': True, 'no_create': True}" placeholder="City completion" />
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='mobile']" position="after">
                <field name="fax" placeholder="Fax..." widget="phone" />
            </xpath>
            <xpath expr="/form//field[@name='child_ids']/form//field[@name='street2']" position="after">
                <field name="street3" placeholder="Street 3..." class="o_address_street" />
            </xpath>
            <xpath expr="/form//field[@name='child_ids']/kanban/field[@name='street2']" position="after">
                <field name="street3" />
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//group" position="after">
                <group string="Force addresses" invisible="type != 'contact'">
                    <group colspan="4">
                        <field name="commercial_partner_id" invisible="1" />
                        <div class="oe_grey" colspan="4">
                            <p
                            >You can force contact, delivery and invoice address for this contact.
                            If you keep these fields empty, Odoo's default behavior will apply.</p>
                        </div>
                    </group>
                    <group colspan="4">
                        <field name="partner_delivery_id" domain="[('id', 'child_of', commercial_partner_id), ('type', '=', 'delivery')]" />
                    </group>
                    <group colspan="4">
                        <field name="partner_invoice_id" domain="[('id', 'child_of', commercial_partner_id), ('type', '=', 'invoice')]" />
                    </group>
                    <group colspan="4">
                        <field name="partner_contact_id" domain="[('id', 'child_of', commercial_partner_id), ('type', '=', 'contact')]" />
                    </group>
                </group>
            </xpath>

            <!-- Personal Information -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="personal_information_page" string="Personal Information" invisible="is_company">
                    <group name="personal_information_group">
                        <!-- <field name='gender' />
                        <field name='birthdate_date' />
                        <field name="age" invisible="not birthdate_date"/> -->
                    </group>
                </page>
            </xpath>

            <!-- Sales & Purchase -->
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="picking_policy" />
            </xpath>
        </field>
    </record>

    <!-- Show always parent_id plus add affiliates -->
    <record id="view_partner_form_add_affiliate" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field eval="1" name="priority" />
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="readonly">id != False and not is_company</attribute>
            </xpath>
            <xpath expr="/form/sheet//div[hasclass('o_row')]/field[@name='parent_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <!-- Child Companies -->
            <xpath expr='//page[@name="contact_addresses"]' position="before">
                <page string="Affiliates" invisible="not is_company" autofocus="autofocus">
                    <separator name="affiliates" string="Affiliates List" />
                    <div name="alert_no_affiliates" class="oe_read_only alert alert-info mb8" role="alert" invisible="not affiliate_ids">
                        No Affiliates Available
                    </div>
                    <!-- <field name="affiliate_ids" context="{'default_parent_id': active_id, 'default_is_company': True}" mode="kanban"> -->

                    <field name="affiliate_ids" context="{'default_parent_id': active_id, 'default_is_company': True, 'default_type':''}" mode="kanban">
                        <kanban on_create="base.view_partner_form">
                            <field name="id" />
                            <field name="color" />
                            <field name="name" />
                            <field name="title" />
                            <field name="type" />
                            <field name="email" />
                            <field name="is_company" />
                            <field name="function" />
                            <field name="contact_role_ids" />
                            <field name="contact_position_id" />
                            <field name="phone" />
                            <field name="street" />
                            <field name="street2" />
                            <field name="zip" />
                            <field name="city" />
                            <field name="country_id" />
                            <field name="mobile" />
                            <field name="state_id" />
                            <field name="image_128" />
                            <field name="lang" />
                            <!-- fields in form x2many view to diminish requests -->
                            <field name="comment" />
                            <field name="display_name" />
                            <templates>
                                <t t-name="kanban-box">
                                    <t t-set="color" t-value="kanban_color(record.color.raw_value)" />
                                    <div t-att-class="color + (record.title.raw_value == 1 ? ' oe_kanban_color_alert' : '') + ' oe_kanban_global_click'">
                                        <div class="o_kanban_image">
                                            <img alt="Contact image" t-if="record.image_128.raw_value" t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)" />
                                            <t t-if="!record.image_128.raw_value">
                                                <img alt="Delivery" t-if="record.type.raw_value === 'delivery'" t-att-src='_s + "/base/static/img/truck.png"'/>
                                                <img alt="Invoice" t-if="record.type.raw_value === 'invoice'" t-att-src='_s + "/base/static/img/money.png"'/>
                                                <t t-if="record.type.raw_value !== 'invoice' &amp;&amp; record.type.raw_value !== 'delivery'">
                                                    <img alt="Logo" t-if="record.is_company.raw_value === true" t-att-src='_s + "/base/static/img/company_image.png"'/>
                                                    <img alt="Avatar" t-if="record.is_company.raw_value === false" t-att-src='_s + "/base/static/img/avatar_grey.png"'/>
                                                </t>
                                            </t>
                                        </div>
                                        <div class="oe_kanban_details">
                                            <field name="name" />
                                            <button class="btn btn-link" type="object" name="open_affiliate_form" title="Open full form">
                                                <i class="fa fa-caret-right fa-2x" style="position:absolute;top:-4px;right:5px;transform:rotateY(0deg) rotate(-45deg);" />
                                            </button>
                                            <!-- <div t-if="record.function.raw_value">
                                                <field name="function" />
                                            </div> -->
                                            <div t-if="record.contact_role_ids.raw_value">
                                                <field name="contact_role_ids" />
                                            </div>
                                            <div t-if="record.contact_position_id.raw_value">
                                                <field name="contact_position_id" />
                                            </div>
                                            <div t-if="record.email.raw_value">
                                                <field name="email" widget="email" />
                                            </div>
                                            <div t-if="record.type.raw_value != 'contact'">
                                                <div>
                                                    <field name="zip" />
                                                    <field name="city" />
                                                </div>
                                                <field t-if="record.state_id.raw_value" name="state_id" />
                                                <field name="country_id" />
                                            </div>
                                            <div t-if="record.phone.raw_value">Phone: <t t-esc="record.phone.value" />
                                            </div>
                                            <div t-if="record.mobile.raw_value">Mobile: <t t-esc="record.mobile.value" />
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_with_change_company_button" model="ir.ui.view">
        <field name="name">Partner Form With Button To Change Company</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button type="action" name="%(action_res_partner_change_parent)d" string="Change Parent Entity" class="oe_highlight" invisible="not id or is_company or type != 'contact'" />
                </header>
            </sheet>
        </field>
    </record>

    <record id="view_partner_form_company_not_editable" model="ir.ui.view">
        <field name="name">Partner Form With Parent Company Not Editable</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="id" invisible="1"/>
            </field>
            <field name="parent_id" position="attributes">
                <attribute name="readonly">id != False and not is_company</attribute>
            </field>
        </field>
    </record>

    <record id="view_partner_simple_form_company_not_editable" model="ir.ui.view">
        <field name="name">Partner Simple Form With Parent Company Not Editable</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="id" invisible="1"/>
            </field>
            <field name="parent_id" position="attributes">
                <attribute name="readonly">id != False</attribute>
            </field>
            <field name="function" position="after">
                <field name="fax" placeholder="Fax..." />
            </field>
        </field>
    </record>

    <record id="view_partner_short_form_company_not_editable" model="ir.ui.view">
        <field name="name">Partner Short Form With Parent Company Not Editable</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_address_form"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="id" invisible="1"/>
            </field>
            <field name="parent_id" position="attributes">
                <attribute name="readonly">id != False</attribute>
            </field>
            <field name="street2" position="after">
                <field name="street3" placeholder="Street 3..." class="o_address_street" />
            </field>
        </field>
    </record>

    <record id="res_partner_kanban_view" model="ir.ui.view">
        <field name="name">add street 3 in kanban</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view" />
        <field name="arch" type="xml">
            <field name="street2" position="after">
                <field name="street3" />
            </field>
        </field>
    </record>

    <record id="res_partner_view_form_private" model="ir.ui.view">
        <field name="name">add street 3 in res.partner.form.private</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_view_form_private" />
        <field name="arch" type="xml">
            <field name="street2" position="after">
                <field name="street3" placeholder="Street 3..." class="o_address_street" />
            </field>
        </field>
    </record>

    <record id="view_partner_search" model="ir.ui.view">
        <field name="name">Is a Company Parent Partner Search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="company_group_id" />
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="contact_role_ids" />
                <field name="contact_position_id" />
            </xpath>
            <xpath expr="//filter[@name='group_company']" position="before">
                <filter name="group_company_group" string="Company Group" context="{'group_by': 'company_group_id'}" />
            </xpath>
            <xpath expr="//filter[@name='type_company']" position="after">
                <filter string="Parent Company" name="is_company_parent" domain="[('is_company_parent','=',True)]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='group_country']" position="after">
                <filter name="group_parent_company" string="Parent Company" context="{'group_by': 'highest_parent_id'}"/>
            </xpath>
            <xpath expr="//filter[@name='salesperson']" position="after">
                <filter string="Contact Roles" name="contact_role_filter" domain="[('is_company','!=', True)]" context="{'group_by': 'contact_role_ids'}" />
                <filter string="Contact Positions" name="contact_position_filter" domain="[('is_company','!=', True)]" context="{'group_by': 'contact_position_id'}" />
            </xpath>
        </field>
    </record>

    <record id="action_open_group_members" model="ir.actions.act_window">
        <field name="name">Company group members</field>
        <field name="res_model">res.partner</field>
        <field name="binding_model_id" ref="model_res_partner" />
        <field name="view_mode">tree</field>
        <field name="target">current</field>
        <field name="context">{'create': False}</field>
        <field name="domain">[('company_group_id', 'in', context.get('active_ids'))]</field>
    </record>


    <!-- Actions -->

    <record id="res_partner_companies_action" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_company', '=', True), ('is_company_parent', '=', True), ('id', '!=', 1)]</field>
        <field name="context">
        {
            'default_company_type': 'company',
            'default_is_company': True,
            'default_is_company_parent': True, 
            'default_type': '',
        }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new customer company
            </p>
            <p>
                An company is the parent entity of affiliates and establishes the hierarchical relationship.
            </p>
        </field>
    </record>

    <record id="res_partner_affiliates_action" model="ir.actions.act_window">
        <field name="name">Affiliates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <!-- <field name="domain">[('is_company', '=', True), ('is_company_parent', '=', False), ('id', '!=', 1)]</field> -->
        <field name="domain">[('is_company', '=', True), ('is_company_parent', '=', False), ('parent_id', '!=', False), ('id', '!=', 1)]</field>

        <field name="context">{'default_company_type': 'company', 'default_is_company': True, 'default_is_company_parent':False, 'default_type': ''}
        </field>

        <!-- <field name="context">
        {
            'default_is_company': True,
            'default_is_company_parent': False,
            'default_parent_id': active_id,
            'default_type': 'contact'
        }
        </field> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Add a new company affiliate
            </p>
            <p>
            An affiliate is a child entity of companies and is a physical place where services are provided and resources and participants may be stored, found, contained or accommodated.
            </p>
        </field>
    </record>

    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="domain">[('is_contact', '=', True)]</field>
        <field name="context">{'default_is_contact': True, 'default_company_type':'person', 'default_type':'contact'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a Contact in your address book
            </p>
            <p>Contacts covers all individuals who are engaged in the healthcare process and healthcare-related services as part of their formal responsibilities.</p>
        </field>
    </record>

    <record id="res_partner_patients_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{'default_is_patient': True, 'default_company_type':'person', 'default_type':'contact'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new patient
            </p>
            <p>
                A Patient is a person receiving or registered to receive medical treatment.
            </p>
        </field>
    </record>


    <!-- Main Contacts Navbar Menu -->
    <menuitem name="Customers" id="contacts.menu_contacts" sequence="20" web_icon="contacts,static/description/icon.png" groups="base.group_user,base.group_partner_manager"/>

    <!-- Root Menu Items -->
    <menuitem id="company_accounts_menu" name="Companies" parent="contacts.menu_contacts" action="res_partner_companies_action" sequence="1"/>
    <menuitem id="company_affiliates_menu" name="Affiliates" parent="contacts.menu_contacts" action="res_partner_affiliates_action" sequence="2"/>
    <menuitem id="contacts.res_partner_menu_contacts" name="Contacts" parent="contacts.menu_contacts" action="contacts.action_contacts" sequence="3"/>
    <menuitem id="company_patients_menu" name="Patients" parent="contacts.menu_contacts" action="res_partner_patients_action" sequence="4"/>
    <!-- <menuitem id="contact_suppliers_menu" name="Suppliers" parent="contacts.menu_contacts" action="res_partner_suppliers_action" sequence="5"/> -->

    <!-- Configuration Menu -->
    <menuitem id="contacts.res_partner_menu_config" name="Configuration" parent="contacts.menu_contacts" sequence="5" groups="base.group_system"/>

    <!-- Configuration: Accounts -->
    <menuitem id="res_partner_accounts_menu_config" name="Companies" parent="contacts.res_partner_menu_config" sequence="1"/>
    <menuitem id="contacts.res_partner_industry_menu" name="Industries" action="base.res_partner_industry_action" parent="contacts.res_partner_menu_config" sequence="2"/>

    <!-- Configuration: Contacts -->
    <menuitem id="res_partner_contacts_menu_config" name="Contacts" parent="contacts.res_partner_menu_config" sequence="10"/>
    <menuitem id="res_partner_role_menu" name="Roles" action="res_partner_role_action" parent="res_partner_contacts_menu_config" sequence="10"/>
    <menuitem id="res_partner_position_menu" name="Positions" action="res_partner_position_action" parent="res_partner_contacts_menu_config" sequence="20"/>
    <menuitem id="contacts.menu_partner_title_contact" name="Titles" action="base.action_partner_title_contact" parent="res_partner_contacts_menu_config" sequence="30"/>
    <menuitem id="contacts.menu_partner_category_form" name="Tags" action="base.action_partner_category_form" parent="res_partner_contacts_menu_config" sequence="40"/>

    <!-- Configuration: Localization -->
    <menuitem id="contacts.menu_localisation" name="Localization" parent="contacts.res_partner_menu_config" sequence="20"/>
    <menuitem id="contacts.menu_config_bank_accounts" name="Bank Accounts" parent="contacts.res_partner_menu_config" sequence="30"/>

</odoo>
