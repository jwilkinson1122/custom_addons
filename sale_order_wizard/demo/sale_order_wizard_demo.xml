<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Product Categories -->

        <record id="product_category_custom_device" model="product.category">
            <field name="parent_id" ref="product.product_category_all" />
            <field name="name">Custom</field>
        </record>

        <record id="product_category_otc_device" model="product.category">
            <field name="parent_id" ref="product.product_category_all" />
            <field name="name">OTC</field>
        </record>

        <record id="product_category_brace_device" model="product.category">
            <field name="parent_id" ref="product.product_category_all" />
            <field name="name">Brace</field>
        </record>

        <!-- Sale Order Sections -->

        <record id="sale_order_section_shell_foundation" model="sale.order.section">
            <field name="section_name">shell_foundation</field>
            <field name="product_category_id" ref="product_category_custom_device"/>
        </record>

        <record id="sale_order_section_arch_height" model="sale.order.section">
            <field name="section_name">arch_height</field>
            <field name="product_category_id" ref="product_category_custom_device"/>
        </record>

        <record id="sale_order_section_top_cover" model="sale.order.section">
            <field name="section_name">top_cover</field>
            <field name="product_category_id" ref="product_category_custom_device"/>
        </record>

        <record id="sale_order_section_bottom_cover" model="sale.order.section">
            <field name="section_name">bottom_cover</field>
            <field name="product_category_id" ref="product_category_custom_device"/>
        </record>

        <record id="sale_order_section_cushion" model="sale.order.section">
            <field name="section_name">cushion</field>
            <field name="product_category_id" ref="product_category_custom_device"/>
        </record>

        <record id="sale_order_section_extension" model="sale.order.section">
            <field name="section_name">extension</field>
            <field name="product_category_id" ref="product_category_custom_device"/>
        </record>

        <record id="sale_order_section_options" model="sale.order.section">
            <field name="section_name">options</field>
            <field name="product_category_id" ref="product_category_custom_device"/>
        </record>

    </data>

</odoo>
