<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="product_options_view_form" model="ir.ui.view">
        <field name="name">product.options.form</field>
        <field name="model">product.options</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="is_required" />
                        </group>
                        <group>
                            <field name="input_type" />
                            <field name="price" invisible="input_type in ('radio','checkbox','drop_down','multiple')"/>
                        </group>
                    </group>
                    <group name="Option Values" string="Option Values" invisible="input_type not in ('radio','checkbox','drop_down','multiple')">
                        <field name="product_options_value_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name='name'/>
                                <field name='price'/>
                                <field name='is_default'/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_options_view_tree" model="ir.ui.view">
        <field name="name">product.options.tree</field>
        <field name="model">product.options</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="input_type"/>
            </tree>
        </field>
    </record>

    <record id="sale_product_options_view_form" model="ir.ui.view">
        <field name="name">sale.product.options.form</field>
        <field name="model">sale.product.options</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_option_id" />
                        </group>
                        <group>
                            <field name="input_data" />
                            <field name="file_data" invisible="file_data == False"/>
                            <!-- <field name="file_preview" widget='image' class="oe_avatar" invisible="file_data == False"/> -->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_product_options_view_tree" model="ir.ui.view">
        <field name="name">sale.product.options.tree</field>
        <field name="model">sale.product.options</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <tree>
                <field name="product_option_id"/>
                <field name="input_data"/>
                <field name="price"/>
                <button name="remove" type="object" class="fa fa-trash-o btn-link" aria-label="Remove" title="Remove"/>
            </tree>
        </field>
    </record>
</odoo>
