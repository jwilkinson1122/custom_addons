<odoo>
  <record id="view_form_cpq_product_preferences" model="ir.ui.view">
    <field name="name">cpq.product.preferences.form</field>
    <field name="model">cpq.product.preferences</field>
    <field name="arch" type="xml">
      <form string="Customer Product Preference">
        <sheet>
          <group>
            <field name="partner_id"/>
            <field name="product_tmpl_id"/>
            <field name="attribute_id"/>
            <field name="value_id" domain="[('attribute_id', '=', attribute_id)]"/>
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_tree_cpq_product_preferences" model="ir.ui.view">
    <field name="name">cpq.product.preferences.tree</field>
    <field name="model">cpq.product.preferences</field>
    <field name="arch" type="xml">
      <tree string="Customer Product Preferences">
        <field name="partner_id"/>
        <field name="product_tmpl_id"/>
        <field name="attribute_id"/>
        <field name="value_id"/>
        <field name="note"/>
      </tree>
    </field>
  </record>

  <record id="action_cpq_product_preferences" model="ir.actions.act_window">
    <field name="name">Customer Preferences</field>
    <field name="res_model">cpq.product.preferences</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create saved attribute preferences for customers, per product.
      </p>
    </field>
  </record>

</odoo>
