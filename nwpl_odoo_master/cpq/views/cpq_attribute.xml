<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Form View: cpq.attribute -->
  <!-- TODO: Set default attributes -->
  <record id="view_cpq_attribute_form" model="ir.ui.view">
    <field name="name">cpq.attribute.form</field>
    <field name="model">cpq.attribute</field>
    <field name="priority" eval="1"/>
    <field name="arch" type="xml">
      <form string="Custom Attribute">
        <sheet>
          <div class="oe_button_box" name="button_box"/>
          <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
          <field name="avatar_128" invisible="1"/>
          <field name="image_128" widget='image' class="oe_avatar" options='{"preview_image": "avatar_128"}'/>
          <div class="oe_title mb24">
            <h1>
              <field name="name" id="attribute" options="{'line_breaks': False}" class="text-break" default_focus="1" placeholder="e.g. Arch Height" required="1"/>
            </h1>
          </div>
          <group name="display">
            <field name="active" invisible="1"/>
            <field name="code" placeholder="ID"/>
            <field name="sequence"/>
            <field name="display_type"/>
            <field name="is_group"/>
            <field name="parent_id" string="Parent Group" domain="[('is_group', '=', True)]" context="{'default_is_group': True}"/>
            <field name="note"/>
          </group>
          <notebook colspan="4">
            <page string="Attribute Values" invisible="is_group" autofocus="autofocus">
              <field name="value_ids">
                <tree editable="bottom" class="cpq_value_tree o_tree_no_wrap">
                  <field name="sequence" widget="handle"/>
                  <field name="image_128" widget="image" options="{'size': [70, 70]}" class="cpq-image"/>
                  <field name="name"/>
                  <field name="code"/>
                  <field name="price_extra"/>
                  <field name="is_custom" class="text-center"/>
                  <field name="cpq_custom_type" invisible="not is_custom"/>
                  <field name="linked_option_id" invisible="not is_custom or cpq_custom_type != 'options'" help="Select a predefined product option this attribute value should be associated with. Used to map free-form or selectable values to structured configuration options under Custom Options (e.g., 'Heel Options', 'Top Cover Options')."/>
                  <field name="cpq_options_relaxed_validation" class="text-center" invisible="not is_custom or cpq_custom_type != 'options'"/>
                  <field name="triggers_child_attribute_ids" widget="many2many_tags"/>
                  <field name="active" column_invisible="1"/>
                </tree>
              </field>
            </page>
            <page string="Sub-Groups" invisible="not is_group">
              <field name="subgroup_ids">
                <tree editable="bottom" class="cpq_value_tree o_tree_no_wrap">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="code"/>
                  <field name="is_group"/>
                  <field name="parent_id"/>
                  <field name="display_type"/>
                  <field name="active" column_invisible="1"/>
                </tree>
              </field>
            </page>
            <page string="Sub-Attributes" invisible="is_group">
              <field name="subattribute_ids">
                <tree editable="bottom" class="cpq_value_tree o_tree_no_wrap">
                  <field name="sequence" widget="handle"/>
                  <field name="image_128" string="Image" widget="image" options="{'size': [70, 70]}" class="cpq-image"/>
                  <field name="name"/>
                  <field name="code"/>
                  <field name="parent_id"/>
                  <field name="is_group"/>
                  <field name="note"/>
                  <field name="display_type"/>
                  <field name="active" column_invisible="1"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Tree View: cpq.attribute -->
  <record id="view_cpq_attribute_tree" model="ir.ui.view">
    <field name="name">cpq.attribute.tree</field>
    <field name="model">cpq.attribute</field>
    <field name="arch" type="xml">
      <tree string="Custom Attributes" class="cpq_value_tree o_tree_no_wrap">
        <field name="name"/>
        <field name="code"/>
        <field name="parent_id"/>
        <field name="child_ids" widget="many2many_tags" options="{'no_create': True}"/>
        <field name="display_type"/>
        <field name="sequence"/>
        <field name="is_group"/>
        <field name="sub_attribute_count"/>
        <field name="note"/>
        <field name="active" column_invisible="1"/>
      </tree>
    </field>
  </record>

  <!-- Kanban View: cpq.attribute -->
  <record id="view_cpq_attribute_kanban" model="ir.ui.view">
    <field name="name">cpq.attribute.kanban</field>
    <field name="model">cpq.attribute</field>
    <field name="arch" type="xml">
    <kanban default_group_by="group_label" default_order="group_order asc" class="oe_kanban_content o_kanban_cpq_attribute">
        <field name="name"/>
        <field name="note"/>
        <field name="is_group"/>
        <field name="group_label"/>
        <field name="code"/>
        <field name="child_badge_info"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill position-relative">
              <t t-set="placeholder" t-value="'/product/static/img/placeholder.png'" />
              <div class="o_kanban_image_fill_left o_kanban_image_full" t-attf-style="background-image: url(#{kanban_image('cpq.attribute', 'image_128', record.id.raw_value, placeholder)})" role="img" />
              <div class="ribbon ribbon-top-right">
                <span t-att-class="record.is_group.raw_value ? 'ribbon-group' : 'ribbon-attribute'">
                  <t t-esc="record.is_group.raw_value ? 'Group' : 'Attribute'" />
                </span>
              </div>
              <div class="oe_kanban_details" t-attf-id="{{record.id.value}}">
                <div class="o_kanban_record_top mb-0">
                  <div class="o_kanban_record_headings">
                    <strong class="o_kanban_record_title">
                      <t t-esc="record.name.value"/>
                    </strong>
                    <t t-if="record.code.value">
                      <span class="ms-2">[<t t-esc="record.code.value"/>]</span>
                    </t>
                  </div>
                </div>
                <div class="o_kanban_record_body">
                  <t t-if="record.note.value">
                    <p class="text-muted">
                      <t t-esc="record.note.value"/>
                    </p>
                  </t>
                  <t t-if="record.child_badge_info.value">
                    <div class="mt-2 d-flex flex-wrap gap-1">
                      <t t-foreach="record.child_badge_info.value.split(', ')" t-as="label" t-key="label">
                        <span class="badge bg-light border text-dark">
                          <t t-esc="label"/>
                        </span>
                      </t>
                    </div>
                  </t>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>


  <record id="view_cpq_attribute_search" model="ir.ui.view">
    <field name="name">cpq.attribute.search</field>
    <field name="model">cpq.attribute</field>
    <field name="arch" type="xml">
      <search string="Search Custom Attributes">
        <field name="name"/>
        <field name="is_group"/>
        <filter name="is_group" string="Is Group" domain="[('is_group','=',True)]"/>
        <group expand="0" string="Group By">
          <filter name="group_by_parent" string="Parent Group" domain="[]" context="{'group_by':'parent_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Form View: cpq.attribute.value -->
  <record id="view_cpq_attribute_value_form" model="ir.ui.view">
    <field name="name">cpq.attribute.value.form</field>
    <field name="model">cpq.attribute.value</field>
    <field name="arch" type="xml">
      <form string="Attribute Value">
        <sheet>
          <group>
            <field name="image_128" widget="image" options="{'size': [70, 70]}" class="cpq-image"/>
            <field name="name" required="1"/>
            <field name="code"/>
            <field name="price_extra"/>
            <field name="attribute_id"/>
            <field name="child_attribute_id"/>
            <field name="is_custom"/>
            <field name="cpq_custom_type" invisible="not is_custom"/>
            <field name="linked_option_id" invisible="not is_custom or cpq_custom_type != 'options'"/>
            <field name="cpq_options_relaxed_validation" invisible="not is_custom or cpq_custom_type != 'options'"/>
            <field name="triggers_child_attribute_ids" widget="many2many_tags"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Tree View: cpq.attribute.value -->
  <record id="view_cpq_attribute_value_tree" model="ir.ui.view">
    <field name="name">cpq.attribute.value.tree</field>
    <field name="model">cpq.attribute.value</field>
    <field name="arch" type="xml">
      <tree editable="bottom" class="cpq_value_tree o_tree_no_wrap">
        <field name="image_128" widget="image" options="{'size': [70, 70]}" class="cpq-image"/>
        <field name="name"/>
        <field name="code"/>
        <field name="price_extra"/>
        <field name="is_custom"/>
        <field name="cpq_custom_type" invisible="is_custom == False"/>
        <field name="linked_option_id" invisible="is_custom == False or cpq_custom_type != 'options'"/>
        <field name="cpq_options_relaxed_validation" invisible="is_custom == False or cpq_custom_type != 'options'"/>
        <field name="triggers_child_attribute_ids" widget="many2many_tags"/>
      </tree>
    </field>
  </record>

  <!-- Actions -->
  <record id="action_cpq_attribute" model="ir.actions.act_window">
    <field name="name">Custom Attributes</field>
    <field name="res_model">cpq.attribute</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[]</field>
    <field name="search_view_id" ref="view_cpq_attribute_search"/>
  </record>

  <record id="action_cpq_attribute_values" model="ir.actions.act_window">
    <field name="name">Custom Attribute Values</field>
    <field name="res_model">cpq.attribute.value</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
