<odoo>
    <record id="view_res_config_settings_cpq" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cpq</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='product_setting_container']" position="inside">
                <setting id="cpq_code_prefix_setting" string="Prefix for Custom Product Codes" help="Set the prefix for Custom product codes. Used to generate internal references.">
                    <field name="cpq_code_prefix" placeholder="CP-"/>
                    <field name="cpq_code_preview" readonly="1" nolabel="1" class="text-muted"/>
                    <div class="alert alert-warning" role="alert" style="margin-top: 8px;">
            Changing the prefix only affects <b>new</b> Custom products. Existing products are unchanged.
                    </div>
                </setting>

                <setting id="cpq_sync_from_product_setting" string="Sync Product → CPQ" help="When enabled, new/updated Product attributes and values are mirrored into CPQ.">
                    <field name="cpq_sync_from_product"/>
                    <!-- Run Autosync button -->
                    <div class="mt16">
                        <button name="action_cpq_run_autosync"
                                type="object"
                                class="btn btn-primary"
                                string="Run CPQ Autosync Now"/>
                        <span class="text-muted ms-2">
                            Links missing Product attributes/values to CPQ and refreshes names/images for linked items.
                        </span>
                    </div>
                </setting>

            </xpath>
        </field>
    </record>

    
    
    <!-- Fallback: if Stock not installed, add to General Settings -->
    <record id="view_res_config_settings_cpq_base" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cpq.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//form[hasclass('oe_form_configuration')]" position="inside">
                <div class="app_settings_block" data-string="CPQ" string="CPQ" data-key="cpq">
                    <h2>CPQ</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="cpq_code_prefix"/>
                                <div class="content-group">
                                    <field name="cpq_code_prefix" placeholder="CP-"/>
                                    <field name="cpq_code_preview" readonly="1" nolabel="1" class="text-muted"/>
                                    <div class="alert alert-warning" role="alert" style="margin-top: 8px;">
                    Changing the prefix only affects <b>new</b> Custom products. Existing products are unchanged.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="cpq_sync_from_product"/>
                                <div class="content-group">
                                    <field name="cpq_sync_from_product"/>
                                    <div class="text-muted">Mirror Product attributes/values to CPQ on create/update.</div>
                                </div>
                                <!-- Run Autosync button -->
                                <div class="mt16">
                                    <button name="action_cpq_run_autosync"
                                            type="object"
                                            class="btn btn-primary"
                                            string="Run CPQ Autosync Now"/>
                                    <span class="text-muted ms-2">
                                        Links missing Product attributes/values to CPQ and refreshes names/images for linked items.
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>


