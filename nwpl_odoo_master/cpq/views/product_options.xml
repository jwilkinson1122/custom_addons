<?xml version='1.0' encoding='utf-8' ?>
<odoo>

    <record id="product_options_tree" model="ir.ui.view">
        <field name="name">product.options.tree</field>
        <field name="model">product.options</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="display_name" />
                <field name="code" />
                <field name="depth" />
                <field name="child_count" />
                <field name="is_leaf" optional="hide" />
                <field name="active" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="product_options_form" model="ir.ui.view">
        <field name="name">product.options.form</field>
        <field name="model">product.options</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1" />
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_children" icon="fa-clone">
                            <field string="Children" name="child_count" widget="statinfo" />
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True" />

                    <div class="oe_title">
                        <label for="name" string="Option" />
                        <h1>
                            <field name="name" placeholder="e.g. Top Cover Options" />
                        </h1>
                    </div>

                    <group name="first" colspan="2">
                        <field name="parent_id" placeholder="Option" class="oe_inline" />
                        <field name="code" placeholder="ID" class="oe_inline" />
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="comment" />
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <field name="depth" />
                                <field name="is_leaf" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_options_kanban" model="ir.ui.view">
        <field name="name">product.options.kanban</field>
        <field name="model">product.options</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <kanban default_group_by="group_label" default_order="group_order asc" class="oe_kanban_content o_kanban_cpq_options">
            <field name="name"/>
            <field name="display_name"/>
            <field name="parent_id"/>
            <field name="sequence"/>
            <field name="depth"/>
            <field name="child_count"/>
            <field name="child_badge_info"/>
            <field name="is_leaf"/>
            <field name="active"/>
            <field name="code"/>
            <field name="comment"/>
            <field name="group_label"/>
            <field name="group_order"/>
            <field name="image_128"/>
            <templates>
                <t t-name="kanban-box">
                <div class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill position-relative">
                    <t t-set="placeholder" t-value="'/product/static/img/placeholder.png'"/>
                    <div class="o_kanban_image_fill_left o_kanban_image_full"
                        t-attf-style="background-image: url(#{kanban_image('product.options', 'image_128', record.id.raw_value, placeholder)})"
                        role="img"/>

                    <!-- Ribbon identical to CPQ, just different labels/colors if you want -->
                    <!-- <div class="ribbon ribbon-top-right">
                        <span t-att-class="record.is_leaf.raw_value ? 'ribbon-leaf' : 'ribbon-option'">
                            <t t-esc="record.is_leaf.raw_value ? 'Option' : 'Group'"/>
                        </span>
                    </div> -->

                    <div class="oe_kanban_details" t-attf-id="{{record.id.value}}">
                    <div class="o_kanban_record_top mb-0">
                        <div class="o_kanban_record_headings">
                            <strong class="o_kanban_record_title">
                                <t t-esc="record.display_name.value or record.name.value"/>
                            </strong>
                            <t t-if="record.code.value">
                                <span class="ms-2">[<t t-esc="record.code.value"/>]</span>
                            </t>
                        </div>
                    </div>
                    <!-- Inside your existing product_options_kanban template -->
                    <t t-if="!record.is_leaf.raw_value">
                        <div class="mt-2">
                            <button type="object"
                                    name="action_view_children"
                                    class="btn btn-link p-0">
                            Open children
                            </button>
                        </div>
                    </t>

                    <!-- <t t-if="record.child_badge_info.value">
                        <div class="cpq-badges">
                            <t t-foreach="record.child_badge_info.value.split(', ')" t-as="label" t-key="label">
                                <span class="badge bg-light border text-dark"><t t-esc="label"/></span>
                            </t>
                        </div>
                    </t> -->
                    <!-- Replace your badge block in product_options_kanban -->
                    <t t-if="record.child_badge_info.value and !record.is_leaf.raw_value">
                        <details class="mt-2">
                            <summary class="text-muted small">Children (<t t-esc="record.child_badge_info.value.split(', ').length"/>)</summary>
                            <div class="mt-2 d-flex flex-wrap gap-1">
                            <t t-foreach="record.child_badge_info.value.split(', ')" t-as="label" t-key="label">
                                <span class="badge bg-light border text-dark"><t t-esc="label"/></span>
                            </t>
                            </div>
                        </details>
                    </t>

                    <div class="o_kanban_record_body">
                        <!-- <div class="text-muted">
                        <t t-if="record.parent_id.value">Parent: <t t-esc="record.parent_id.value"/><span class="mx-2">•</span></t>
                        Depth: <t t-esc="record.depth.value or 0"/><span class="mx-2">•</span>
                        Children: <t t-esc="record.child_count.value or 0"/>
                        </div> -->
                        <t t-if="record.comment.value">
                            <p class="text-muted">
                                <t t-esc="record.comment.value"/>
                            </p>
                        </t>
                    </div>
                    </div>
                </div>
                </t>
            </templates>
            </kanban>
        </field>
    </record>
    <!-- NEW Kanban: “Options by Parent” -->
    <record id="product_options_by_parent_kanban" model="ir.ui.view">
        <field name="name">product.options.by_parent.kanban</field>
        <field name="model">product.options</field>
        <field name="arch" type="xml">
            <!-- only leaf options; columns are parents -->
            <kanban default_group_by="parent_id" class="o_kanban_cpq_options">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="is_leaf"/>
                <field name="code"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <t t-esc="record.name.value"/>
                                </strong>
                                <t t-if="record.code.value">
                                    <div class="text-muted">[<t t-esc="record.code.value"/>]</div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
                <filters>
                    <!-- enforce leaf-only in this view -->
                    <filter string="Leaf only" domain="[('is_leaf','=',True)]" context="{}" help="Show only final options"/>
                </filters>
            </kanban>
        </field>
    </record>

    <!-- Optional separate action to open this view quickly -->
    <record id="product_options_by_parent_action" model="ir.actions.act_window">
        <field name="name">Options by Parent</field>
        <field name="res_model">product.options</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="product_options_by_parent_kanban"/>
        <field name="domain">[('is_leaf','=',True)]</field>
    </record>

    <record id="view_product_options_search" model="ir.ui.view">
        <field name="name">product.options.search</field>
        <field name="model">product.options</field>
        <field name="arch" type="xml">
            <search string="Search Product Options">
                <field name="name"/>
                <filter name="filter_root" string="Root Level" domain="[('parent_id','=',False)]"/>
                <filter name="filter_groups" string="Groups" domain="[('is_leaf','=',False)]"/>
                <filter name="filter_options" string="Options" domain="[('is_leaf','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'group_label'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="product_options_action" model="ir.actions.act_window">
        <field name="name">Product Options</field>
        <field name="res_model">product.options</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'kanban','view_id': ref('product_options_kanban')}),
            (0,0,{'view_mode':'tree','view_id': ref('product_options_tree')}),
            (0,0,{'view_mode':'form','view_id': ref('product_options_form')})]"/>
        <field name="search_view_id" ref="view_product_options_search"/>
    </record>


    
</odoo>
