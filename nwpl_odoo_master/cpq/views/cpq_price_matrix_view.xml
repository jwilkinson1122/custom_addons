<odoo>
  <!-- Tree View -->
  <record id="view_cpq_price_matrix_tree" model="ir.ui.view">
    <field name="name">cpq.price.matrix.tree</field>
    <field name="model">cpq.price.matrix</field>
    <field name="arch" type="xml">
      <tree string="Price Matrix Entries">
        <field name="name"/>
        <field name="product_tmpl_id"/>
        <field name="ptav_ids" widget="many2many_tags"/>
        <field name="price_extra" widget="monetary" options="{'currency_field': 'currency_id'}"/>

      </tree>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_cpq_price_matrix_form" model="ir.ui.view">
    <field name="name">cpq.price.matrix.form</field>
    <field name="model">cpq.price.matrix</field>
    <field name="arch" type="xml">
      <form string="Price Matrix Entry">
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="product_tmpl_id"/>
            <field name="ptav_ids" widget="many2many_tags"/>
            <field name="price_extra" widget="monetary" options="{'currency_field': 'currency_id'}"/>

          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_cpq_price_matrix_search" model="ir.ui.view">
    <field name="name">cpq.price.matrix.search</field>
    <field name="model">cpq.price.matrix</field>
    <field name="arch" type="xml">
      <search string="Search Price Matrix">
        <field name="name"/>
        <field name="product_tmpl_id"/>
        <field name="ptav_ids"/>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_cpq_price_matrix" model="ir.actions.act_window">
    <field name="name">Price Matrix</field>
    <field name="res_model">cpq.price.matrix</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_cpq_price_matrix_search"/>
  </record>

  <record id="action_cpq_price_matrix_line" model="ir.actions.act_window">
    <field name="name">Add Price Matrix Line</field>
    <field name="res_model">cpq.price.matrix.line</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
