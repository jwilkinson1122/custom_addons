        <record id="ir_cron_cpq_backfill_links" model="ir.cron">
            <field name="name">CPQ: Backfill Links</field>
            <field name="model_id" ref="nwpl_odoo_master.model_cpq_sync_service"/>
            <field name="state">code</field>
            <field name="code">model.backfill_cpq_value_links()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
