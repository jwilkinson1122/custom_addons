<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="ir_cron_cpq_autosync" model="ir.cron">
            <field name="name">CPQ: Auto Sync Product → CPQ</field>
            <field name="model_id" ref="nwpl_odoo_master.model_cpq_sync_service"/>
            <field name="state">code</field>
            <field name="code">model.run_autosync(refresh_existing=True, push_images=True)</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

