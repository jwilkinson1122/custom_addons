<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Custom Product Sequence -->
    <record id="seq_product_default_code_cpq" model="ir.sequence">
        <field name="name">CPQ Default Code</field>
        <field name="code">product.product.default_code.cpq</field>
        <field name="prefix"></field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Non-Custom Product Sequence -->
    <record id="seq_product_default_code_non_cpq" model="ir.sequence">
        <field name="name">CPQ Default Code</field>
        <field name="code">product.product.default_code.non_cpq</field>
        <field name="prefix"></field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

