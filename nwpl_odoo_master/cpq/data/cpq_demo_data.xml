<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Demo Partner and Practitioner -->
    <record id="partner_demo_customer_account" model="res.partner">
        <field name="name">Fab Foot Clinic</field>
        <field name="is_account">1</field>
    </record>

    <record id="partner_demo_practitioner" model="res.partner">
        <field name="name">Doogie Howser</field>
        <field name="parent_id" ref="partner_demo_customer_account"/>
        <field name="is_contact">1</field>
    </record>

    <!-- Demo Product Template -->
    <record id="product_demo_orthotic" model="product.template">
        <field name="name">Superglass Everyday</field>
        <field name="type">product</field>
        <field name="list_price">59.25</field>
        <field name="sale_ok">1</field>
        <field name="cpq_ok">1</field>
    </record>

    <!-- Demo CPQ Attribute and Value -->
    <record id="cpq_attr_arch_height" model="cpq.attribute">
        <field name="name">Arch Height</field>
    </record>

    <record id="cpq_val_arch_high" model="cpq.attribute.value">
        <field name="name">High</field>
        <field name="attribute_id" ref="cpq_attr_arch_height"/>
        <field name="price_extra">15.0</field>
    </record>

    <!-- Product Attribute Preference Rule -->
    <record id="demo_rule_product_preference" model="cpq.rules.product">
        <field name="partner_id" ref="partner_demo_customer_account"/>
        <field name="contact_id" ref="partner_demo_practitioner"/>
        <field name="product_tmpl_id" ref="product_demo_orthotic"/>
        <field name="attribute_id" ref="cpq_attr_arch_height"/>
        <field name="value_id" ref="cpq_val_arch_high"/>
        <field name="scope">product_specific</field>
        <field name="note">Prefers high arch support for this product.</field>
    </record>

    <!-- Order Instruction Rule -->
    <record id="demo_rule_order_note" model="cpq.rules.order.note">
        <field name="partner_id" ref="partner_demo_customer_account"/>
        <field name="contact_id" ref="partner_demo_practitioner"/>
        <field name="scope">partner</field>
        <field name="note">Please label as urgent and ship with cold pack.</field>
        <field name="condition_json">{}</field>
    </record>

    <!-- Logic Rule -->
    <record id="demo_rule_logic" model="cpq.rules.logic">
        <field name="partner_id" ref="partner_demo_customer_account"/>
        <field name="scope">global</field>
        <field name="note">Only apply heel raise if quantity ≥ 2</field>
        <field name="condition_json">
            {"quantity_to_make": {"gte": 2}}
        </field>
    </record>

    <!-- Global Non-Product Instruction -->
    <record id="demo_rule_nonproduct" model="cpq.rules.nonproduct">
        <field name="partner_id" ref="partner_demo_customer_account"/>
        <field name="scope">global</field>
        <field name="note">Add clinic name on label: Fab Foot Clinic</field>
    </record>

</odoo>
