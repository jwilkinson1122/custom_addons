<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shell_foundation_options" model="product.options">
        <field name="name">Shell / Foundation</field>
        <field name="is_leaf">False</field> <!-- Only 'leaf' options are actual choices -->
    </record>
    <record id="arch_height_options" model="product.options">
        <field name="name">Arch Height Options</field>
        <field name="parent_id" ref="shell_foundation_options"/>
        <field name="is_leaf">True</field>
    </record>

</odoo>