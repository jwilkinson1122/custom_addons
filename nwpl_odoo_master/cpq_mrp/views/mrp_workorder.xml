<odoo>
    <record id="mrp_production_workorder_tree_editable_view_cpq" model="ir.ui.view">
        <field name="name">mrp.workorder.tree.view.cpq</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <!-- <field name="state" position="before">
                <field name="sale_primary_id" optional="show"/>
            </field> -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="sale_primary_id" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_workorder_form_view_cpq" model="ir.ui.view">
        <field name="name">mrp.workorder.form.cpq</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <group string="CPQ">
                    <field name="ptav_ids" widget="many2many_tags"/>
                    <field name="cpq_configuration_summary"/>
                    <field name="cpq_qr_code_image" widget="image"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="CPQ Summary" name="cpq_summary_wo">
                    <group>
                        <field name="cpq_qr_code_image" widget="image" invisible="not cpq_qr_code_image"/>
                    </group>
                    <group>
                        <field name="cpq_configuration_summary" readonly="1" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
