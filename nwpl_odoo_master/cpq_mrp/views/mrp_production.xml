<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_production_tree_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.tree.sale.primary</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <!-- <field name="origin" position="after">
                <field name="sale_primary_id" optional="show"/>
            </field> -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sale_primary_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="partner_id" optional="show" />
                <field name="commitment_date" optional="hide" />
                <field name="client_order_ref" optional="hide" />
            </xpath>
        </field>
    </record>
    <!-- <report id="action_cpq_mo_qr_label" model="mrp.production" string="CPQ QR Label" report_type="qweb-pdf" name="cpq_mrp.report_cpq_mo_qr_label" file="cpq_mrp.report_cpq_mo_qr_label" print_report_name="'CPQ_QR_Label_%s' % object.name" /> -->
    <record id="view_mrp_production_form_inherit_cpq" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.cpq</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- <button name="action_cancel" position="after">
                <button name="action_return_to_draft" type="object" class="oe_stat_button" string="Return to Draft" invisible="state not in ['confirmed', 'cancel']">
                </button>
            </button> -->
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_return_to_draft" invisible="state not in ['confirmed', 'cancel']" string="Return to Draft" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='button_unplan']" position="before">
                <button name="action_create_repair_order" invisible="state != 'done' or repair_id" string="Create Repair Order" type="object" class="oe_highlight" data-hotkey="q" />
            </xpath>
            <xpath expr="//button[@name='action_view_mo_delivery']" position="after">
                <field name="repair_id" readonly="1" invisible="1" />
                <button class="oe_stat_button" name="action_view_mrp_production_repair_orders" type="object" icon="fa-wrench" invisible="not repair_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Repair order</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="CPQ">
                    <field name="sale_line_id"/>
                    <field name="sale_primary_id" />
                    <field name="cpq_config_hash" readonly="1"/>
                    <field name="cpq_label_qty"/>
                    <field name="cpq_qr_code_image" widget="image"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='components']" position="before">
                <page string="CPQ Summary" name="cpq_summary">
                    <group>
                        <field name="sale_line_id" readonly="1"/>
                        <field name="cpq_config_hash" readonly="1"/>
                        <field name="cpq_configuration_json" widget="text" readonly="1"/>
                    </group>
                    <group>
                        <field name="cpq_qr_code_image" widget="image" class="oe_avatar" invisible="not cpq_qr_code_image" options='{"zoom": true, "size": [128, 128]}'/>
                    </group>
                    <group>
                        <field name="cpq_configuration_summary" widget="html" colspan="4" style="white-space: normal;" readonly="1" nolabel="1"/>
                    </group>
                    <footer>
                        <button type="object" name="action_refresh_cpq_from_sale" string="Refresh from Sale Line" class="btn-secondary" invisible="not sale_line_id"/>
                    </footer>
                </page>
            </xpath>
            <!-- <xpath expr="//page[@name='miscellaneous']//field[@name='origin']" position="after">
                <group>
                    <field name="sale_primary_id" />
                    <field name="partner_id" />
                    <field name="commitment_date" />
                    <field name="client_order_ref" />
                </group>
            </xpath> -->
        </field>
    </record>
</odoo>



