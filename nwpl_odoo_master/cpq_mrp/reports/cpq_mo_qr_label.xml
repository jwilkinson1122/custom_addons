<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="report_cpq_mo_qr_label">
    <t t-call="web.basic_layout">
      <div class="container">
        <div class="row">
          <t t-foreach="docs" t-as="doc">
            <div class="col-6" style="page-break-inside: avoid; border: 1px solid #ddd; padding: 10px; margin: 5px;">
              <h5 t-out="doc.product_id.display_name or 'Custom Product'"/>
              <p style="margin: 0;">
                <strong>SO:</strong>
                <t t-out="doc.origin"/>
              </p>

              <t t-if="doc.cpq_configuration_summary">
                <div class="mb-2 o_not_editable">
                  <t t-out="doc.cpq_configuration_summary"/>
                </div>
              </t>

              <t t-if="doc.cpq_qr_url">
                <!-- <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', doc['cpq_qr_url'], 128, 128)"/> -->
                <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', doc.cpq_qr_url, 128, 128)'"/>

              </t>
            </div>
          </t>
        </div>
      </div>
    </t>
  </template>

</odoo>


