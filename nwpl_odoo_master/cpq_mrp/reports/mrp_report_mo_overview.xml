<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="report_mo_overview_inherit_cpq" inherit_id="mrp.report_mo_overview" priority="20">
    <!-- Add QR(s) before the standard body -->
    <xpath expr="//div[hasclass('page')]/t[@t-call='mrp.mo_overview_content']" position="before">
      <t t-if="doc.get('cpq_qr_url') or doc.get('cpq_order_qr_url')">
        <div class="row mt-3">
          <div class="col-6" t-if="doc.get('cpq_qr_url')">
            <strong>Line QR:</strong><br/>
            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', doc['cpq_qr_url'], 128, 128)"/>
          </div>
          <div class="col-6" t-if="doc.get('cpq_order_qr_url')">
            <strong>Order QR:</strong><br/>
            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', doc['cpq_order_qr_url'], 128, 128)"/>
          </div>
        </div>
      </t>
    </xpath>

    <!-- Show CPQ configuration summary after the standard body -->
    <xpath expr="//div[hasclass('page')]/t[@t-call='mrp.mo_overview_content']" position="after">
      <t t-if="doc.get('cpq_configuration_summary')">
        <div class="alert alert-info mb-3">
          <h4>Configuration Summary</h4>
          <div t-out="doc['cpq_configuration_summary']"/>
        </div>
      </t>
    </xpath>
  </template>
</odoo>

