<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_inherit_multi_configurator" model="ir.ui.view">
        <field name="name">product.template.view.form.multi.configurator</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']/group" position="after">
                <group name="product_qty_mode" invisible="not has_configurable_attributes">
                    <group string="Qty Mode">
                        <field name="has_configurable_attributes" invisible="1"/>
                        <field name="allow_qty_mode" widget="boolean_toggle"/>
                    </group>
                </group>
                <group string="Laterality">
                    <field name="laterality_enabled"/>
                    <field name="laterality_default" invisible="not laterality_enabled"/>
                    <field name="bilateral_default_type" invisible="not laterality_enabled"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">attributes.product.normal.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/../.." position="after">
                <div>
                    <!-- <label for="attribute_set_id" class="oe_edit_only" /> -->
                    <field name="attribute_set_id" force_save="1" />
                </div>
            </xpath>
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="product_attributes" string="Attributes" invisible="not attribute_set_id">
                    <separator name="attributes_placeholder" />
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_template_search_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_upcoming_all']" position="after">
                <field name="attribute_set_id" />
                <separator />
                <filter name="group_attribute_set" string="Attribute Set" context="{'group_by': 'attribute_set_id'}" />
            </xpath>
        </field>
    </record>
</odoo>
