<odoo>
  <record id="action_product_attribute_sets" model="ir.actions.act_window">
    <field name="name">Attribute Sets</field>
    <field name="res_model">product.attribute.set</field>
    <field name="view_mode">tree,form</field>
  </record>
    <!-- <menuitem id="menu_product_attribute_group_root" name="Attribute Groups" parent="sale.prod_config_main" action="action_product_attribute_groups" sequence="5"/> -->

  <menuitem id="menu_product_attribute_set_root"
            name="Attribute Sets"
            parent="sale.prod_config_main"
            action="action_product_attribute_sets" sequence="6"/>

  <!-- Category: default attribute set -->
  <record id="view_product_category_inherit_attrset" model="ir.ui.view">
    <field name="name">product.category.form.attrset</field>
    <field name="model">product.category</field>
    <field name="inherit_id" ref="product.product_category_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//group[1]" position="inside">
        <field name="attribute_set_id"/>
      </xpath>
    </field>
  </record>

  <!-- Template: attribute set -->
  <record id="product_template_form_view_attrset" model="ir.ui.view">
    <field name="name">product.template.form.attrset</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//group[1]" position="inside">
        <field name="attribute_set_id" options="{'no_create': False}"/>
      </xpath>
    </field>
  </record>
</odoo>
