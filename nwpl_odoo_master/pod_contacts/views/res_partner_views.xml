    <record id="res_partner_view_tree" model="ir.ui.view">
        <field name="name">res.partner.view.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="legacy_customer_code"/>
                <field name='customer_code'/>
                <field name="parent_id" column_invisible="context.get('default_is_parent_company', False)"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    

    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="create_portal_user" type="object" string="Create Portal User" class="oe_highlight" icon="fa-address-card-o" context="{'default_is_contact': True}" invisible="not is_contact"/>
                <button name="create_portal_user" type="object" string="Create Portal Patient" class="oe_highlight" icon="fa-address-card-o" context="{'default_is_patient': True}" invisible="not is_patient"/>
            </div>
            <xpath expr="//button[@name='action_view_sale_order']" position="before">
                <button class="oe_stat_button" type="object" name="open_sale_from_view_action" icon="fa-pencil-square-o" invisible="reorder_count == 0">
                    <field name="reorder_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='parent_id']" position="after">
                <field name="is_partner" invisible="1"/>
                <field name="is_company" invisible="1"/>
                <field name="is_parent_company" invisible="1"/>
                <field name="is_affiliate_company" invisible="1"/>
                <field name="is_supplier" invisible="1"/>
                <field name="is_contact" invisible="1"/>
                <field name="is_patient" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <h2>
                    <field name="ref" invisible="1"/>
                    <field name="legacy_customer_code" readonly="1"/>
                    <field name="customer_code" readonly="1"/>
                </h2>
                <div class="oe_title mb24">
                    <field name="is_partner" invisible="1"/>
                    <field name="is_company" invisible="1"/>
                    <field name="is_parent_company" invisible="1"/>
                    <field name="is_affiliate_company" invisible="1"/>
                    <field name="is_supplier" invisible="1"/>
                    <field name="is_contact" invisible="1"/>
                    <field name="is_patient" invisible="1"/>
                    <h1>
                        <field id="company" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="e.g. Fab Foot Clinic" invisible="not is_company" required="is_company"/>
                        <field id="individual" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="e.g. Brandon Freeman" invisible="is_company" required="not is_company"/>
                    </h1>
                    <div class="o_row" style="margin-top:10px; margin-bottom:10px">
                        <field name="parent_id" widget="res_partner_many2one" placeholder="Parent Company" domain="[('is_parent_company', '=', True), ('id', '!=', 1)]" invisible="not is_affiliate_company" required="is_affiliate_company" class="fw-bold"/>
                        <field name="parent_id" widget="res_partner_many2one" placeholder="Company / Affiliate" domain="[('is_company', '=', True), ('is_supplier', '=', False), ('id', '!=', 1)]" invisible="is_company" required="is_contact or is_patient" class="fw-bold"/>
                        <field name="contact_id" class="o_address_street fw-bold" invisible="not is_patient" placeholder="Search Contact" required="1"/>
                        <field name="active" invisible="1"/>
                        <label for="is_commercial_partner" string="Commercial Partner"/>
                        <field name="is_commercial_partner"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//group" position="replace">
                <separator name="contact_info" string="Contact Information"/>
                <group>
                    <group>
                        <span class="o_form_label o_td_label" name="address_name">
                            <field name="type" placeholder="Address Type" invisible="1" class="fw-bold"/>
                            <field name="company_address_type" placeholder="Address Type" invisible="not is_company" required="is_company" readonly="is_supplier" class="fw-bold"/>
                            <field name="contact_address_type" placeholder="Address Type" invisible="is_company" required="not is_company" readonly="is_contact or is_patient" class="fw-bold"/>
                            <field name="partner_type" placeholder="Company Type" invisible="is_supplier or is_contact or is_patient" required="not is_supplier or is_company" class="fw-bold"/>
                        </span>
                        <div class="o_address_format">
                            <field name="street" placeholder="Street..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
                            <field name="street2" placeholder="Street 2..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
                            <field name="city" placeholder="City" class="o_address_city" readonly="type == 'contact' and parent_id"/>
                            <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" readonly="type == 'contact' and parent_id" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                            <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="type == 'contact' and parent_id"/>
                            <div name="partner_address_country" class="d-flex justify-content-between">
                                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}' readonly="type == 'contact' and parent_id"/>
                            </div>
                        </div>
                        <field name="vat" placeholder="e.g. BE0477472701" readonly="parent_id" invisible="1"/>
                        <field name="hide_parent" invisible="not parent_id"/>
                    </group>
                    <group>
                        <field name="function" placeholder="e.g. Sales Director" invisible="1"/>
                        <field name="contact_role_ids" placeholder='Roles' widget="many2many_tags" required="not is_patient or is_contact" invisible="not is_contact" options="{'no_create': True}" class="fw-bold"/>
                        <field name="phone" placeholder='Phone' widget="phone"/>
                        <field name="mobile" placeholder='Mobile' widget="phone"/>
                        <field name="fax_number" placeholder='Fax' widget="phone" invisible="is_patient"/>
                        <field name="user_ids" placeholder='User' invisible="1"/>
                        <field name="email" placeholder='Email' widget="email" context="{'gravatar_image': True}" required="user_ids"/>
                        <field name="website" placeholder="e.g. https://www.odoo.com" string="Website" widget="url" invisible="is_patient"/>
                        <field name="title" options='{"no_open": True}' placeholder="e.g. Mister" invisible="is_company"/>
                        <field name="active_lang_count" placeholder="Active Language" invisible="1"/>
                        <field name="ref" invisible="1"/>
                        <field name="legacy_customer_code"/>
                        <field name="customer_code"/>
                        <field name="lang" placeholder="Language" invisible="active_lang_count &lt;= 1"/>
                        <field name="category_id" placeholder='Tags' widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>
                </group>
            </xpath>
            <xpath expr='//page[@name="contact_addresses"]' position="before">
                    <page string="Affiliates" name="affiliates" invisible="not is_company" autofocus="autofocus">
                        <separator name="affiliates" string="Affiliates List" />
                        <div name="alert_no_affiliates" class="oe_read_only alert alert-info mb8" role="alert" invisible="not affiliate_ids">
                            No Affiliates Available
                        </div>
                        <!-- <field name="child_ids" mode="kanban" context="{'default_parent_id': id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type': 'other'}"> -->

                        <field name="affiliate_ids" context="{'default_parent_id': id, 'default_is_affiliate_company': True, 'default_type':''}" mode="kanban,tree"/>
                    </page>
            </xpath>
            <!-- Modify the contact_addresses page attributes -->
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="autofocus"></attribute>
                <attribute name="string">Contacts</attribute>
                <attribute name="invisible">is_patient</attribute>
            </xpath>
            <!-- Add an alert to the contact_addresses page -->
            <xpath expr="//page[@name='contact_addresses']//field[@name='child_ids']" position="before">
                <separator name="contacts" string="Contacts List" />
                <div name="alert_no_contacts" class="oe_read_only alert alert-info mb8" role="alert" invisible="not child_ids">
                    No Locations Available
                </div>
            </xpath>
            <!-- Modify the child_ids field context -->
            <xpath expr="//page[@name='contact_addresses']//field[@name='child_ids']" position="attributes">
                <attribute name="context">{'default_parent_id': id, 'default_is_contact': True, 'default_type':'contact', 'search_default_parent_id': id}</attribute>
                <attribute name="options">{'kanban_view': {'create': True}}</attribute>
            </xpath>

            <xpath expr='//page[@name="contact_addresses"]' position="after">
                <page string="Patients" invisible="is_supplier or is_patient">
                    <separator name="patients" string="Patients List"/>
                    <div name="alert_no_patients" class="oe_read_only alert alert-info mb8" role="alert" invisible="not patient_ids or patient_ids == ''">
                        No Patients Available
                    </div>
                    <field name="patient_ids" context="{'default_parent_id': id, 'default_is_patient': True, 'default_type':'patient'}" mode="kanban,tree">
                        <kanban on_create="base.view_partner_form">
                            <field name="id" />
                            <field name="color" />
                            <field name="name" />
                            <field name="title" />
                            <field name="type" />
                            <field name="email" />
                            <field name="is_company" />
                            <field name="function" />
                            <field name="phone" />
                            <field name="street" />
                            <field name="street2" />
                            <field name="zip" />
                            <field name="city" />
                            <field name="country_id" />
                            <field name="mobile" />
                            <field name="state_id" />
                            <field name="image_128" />
                            <field name="lang" />
                            <field name="comment" />
                            <field name="display_name" />
                            <templates>
                                <t t-name="kanban-box">
                                    <t t-set="color" t-value="kanban_color(record.color.raw_value)" />
                                    <div t-att-class="color + (record.title.raw_value == 1 ? ' oe_kanban_color_alert' : '') + ' oe_kanban_global_click'">
                                        <div class="o_kanban_image">
                                            <img alt="Contact image" t-if="record.image_128.raw_value" t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)" />
                                            <t t-if="!record.image_128.raw_value">
                                                <img alt="Delivery" t-if="record.type.raw_value === 'delivery'" t-att-src='_s + "/base/static/img/truck.png"'/>
                                                <img alt="Invoice" t-if="record.type.raw_value === 'invoice'" t-att-src='_s + "/base/static/img/money.png"'/>
                                                <t t-if="record.type.raw_value !== 'invoice' &amp;&amp; record.type.raw_value !== 'delivery'">
                                                    <img alt="Logo" t-if="record.is_company.raw_value === true" t-att-src='_s + "/base/static/img/company_image.png"'/>
                                                    <img alt="Avatar" t-if="record.is_company.raw_value === false" t-att-src='_s + "/base/static/img/avatar_grey.png"'/>
                                                </t>
                                            </t>
                                        </div>
                                        <div class="oe_kanban_details">
                                            <field name="name" />
                                            <button class="btn btn-link" type="object" name="open_partner_form" title="Open full form">
                                                <i class="fa fa-caret-right fa-2x" style="position:absolute;top:-4px;right:5px;transform:rotateY(0deg) rotate(-45deg);" />
                                            </button>
                                            <div t-if="record.function.raw_value">
                                                <field name="function" />
                                            </div>
                                            <div t-if="record.email.raw_value">
                                                <field name="email" widget="email" />
                                            </div>
                                            <div t-if="record.type.raw_value != 'contact'">
                                                <div>
                                                    <field name="zip" />
                                                    <field name="city" />
                                                </div>
                                                <field t-if="record.state_id.raw_value" name="state_id" />
                                                <field name="country_id" />
                                            </div>
                                            <div t-if="record.phone.raw_value">Phone: <t t-esc="record.phone.value" />
                                            </div>
                                            <div t-if="record.mobile.raw_value">Mobile: <t t-esc="record.mobile.value" />
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
            <xpath expr="//notebook/page[@name='internal_notes']" position="before">
                <page name="orders" string="Orders">
                    <group string="Current Orders">
                        <field name="current_sale_order_ids" readonly="True" domain="[('state', 'not in', ('cancel', 'done'))]">
                            <tree editable="bottom">
                                <field name="name" string="Order Reference" readonly="True"/>
                                <field name="date_order" widget="date" string="Date"/>
                                <field name="partner_id" string="Customer"/>
                                <field name="state" string="Status" readonly="True"/>
                                <field name="invoice_status"/>
                                <field name="activity_ids" String="Activities" widget="list_activity" optional="show"/>
                                <field name="amount_total"/>
                                <button string="View" name="action_open_sale_order" type="object" class="oe_highlight"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Historic Orders">
                        <field name="historic_sale_order_ids" readonly="True">
                            <tree>
                                <field name="name" string="Order Reference" readonly="True"/>
                                <field name="date_order" string="Order Date" readonly="True"/>
                                <field name="state" string="State" readonly="True"/>
                                <field name="is_reorder" string="Re-orderable" widget="boolean_toggle" readonly="True"/>
                                <button name="action_reorder" type="object" string="Reorder" title="Reorder" class="oe_highlight"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_form" model="ir.ui.view">
        <field name="name">customer_credits_box_res_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_payments_in_favor" groups="sales_team.group_sale_salesman" icon="fa-usd">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="credit_amount" widget="monetary" options="{'currency_field': 'currency_id'}" modifiers="{&quot;readonly&quot;: true}"/>
                        </span>
                        <span class="o_stat_text">Credits</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="partner_company_action" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_company', '=', True), ('is_parent_company', '=', True)]</field>
        <field name="context">{
            'default_is_company': True,
            'default_is_parent_company': True,
            'default_type': ''
        }</field>
    </record>

    <record id="partner_affiliate_action" model="ir.actions.act_window">
        <field name="name">Affiliates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_company', '=', True), ('is_affiliate_company', '=', True)]</field>
        <field name="context">{
            'default_is_company': True,
            'default_is_affiliate_company': True,
            'default_type': ''
        }</field>
    </record>


    <record id="partner_supplier_action" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_company', '=', True), ('is_supplier', '=', True), ('id', '!=', 1)]</field>
        <field name="context">{
            'default_is_company': True,
            'default_is_supplier': True,
            'default_type': 'supplier'
        }</field>
    </record>

    <record id="partner_contact_action" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_contact', '=', True)]</field>
        <field name="context">{
            'default_is_contact': True,
            'default_type': 'contact'
        }</field>
    </record>


    <record id="partner_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{
            'default_is_patient': True,
            'default_type': 'patient'
        }</field>
    </record>


</odoo>
