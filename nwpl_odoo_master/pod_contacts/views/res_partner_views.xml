<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_find" model="ir.actions.act_window">
        <field name="name">Find Partner</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">barcode.action</field>
        <field name="view_mode">form</field>
        <field name="context">{
            'default_model': 'res.partner', 
            'default_method': 'find_res_partner_by_ref_using_barcode', 
            'prevent_recursion': True
        }</field>
        <field name="target">new</field>
    </record>

    <record id="res_partner_view_kanban" model="ir.ui.view">
        <field name="name">res.partner.kanban.view.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="customer_code"/>
            </field>
            <field name="active" position="after">
                <field name="affiliate_count"/>
            </field>
            <xpath expr="//kanban//ul" position="inside">
                <li t-if="record.customer_code.raw_value">
                    <field name="customer_code"/>
                </li>
            </xpath>
            <xpath expr="//div[hasclass('oe_kanban_bottom_left')]" position="inside">
                <span t-if="record.is_company.raw_value and record.affiliate_count.value > 0" class="badge badge-pill">
                    <i class="fa fa-fw fa-sitemap" role="img" aria-label="Affiliates" title="Affiliates"/>
                    <t t-esc="record.affiliate_count.value"/>
                </span>
            </xpath>
        </field>
    </record>

