            <field name="name">res.users.form.user.inherit.tab.cleanup</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="view_res_user_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[field[@name='groups_id']]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='access_rights']//field[@name='groups_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//page[@name='access_rights']//field[@name='groups_id']" position="before">
                    <label for="groups_id" string="Groups are managed through Profile and Roles. Manual changes are discouraged." />
                </xpath>
                <xpath expr="//page[.//field[@name='role_line_ids']]//field[@name='role_line_ids']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
            </field>
        </record> -->
        
        <record id="view_res_users_form_inherit_company" model="ir.ui.view">
            <field name="name">res.users.form.inherit.company</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="view_res_user_form_inherit" />
            <field name="arch" type="xml">
                <field name="role_id" position="attributes">
                    <attribute name="domain">[]</attribute>
                </field>
                <xpath expr="//field[@name='role_line_ids']//field[@name='role_id']" position="after">
                    <field name="allowed_company_ids" invisible="1" />
                    <field name="company_id" groups="base.group_multi_company" />
                </xpath>
            </field>
        </record>

        <record id="view_res_users_form_inherit_remove_domain" model="ir.ui.view">
            <field name="name">res.users.form.inherit.remove.domain</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="view_res_user_form_inherit" />
            <field name="arch" type="xml">
                <field name="role_id" position="attributes">
                    <attribute name="domain">[]</attribute>
                </field>
            </field>
        </record>

        <record id="view_res_users_search_inherit" model="ir.ui.view">
            <field name="name">res.users.search.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_search" />
            <field name="arch" type="xml">
                <field name="company_ids" position="after">
                    <field name="role_ids" filter_domain="[('role_line_ids.role_id.name','ilike',self)]" />
                </field>
            </field>
        </record>

        <record id="base.action_res_users" model="ir.actions.act_window">
            <field name="domain" eval="[('id', '!=', ref('base.user_root')), ('id', '!=', ref('base.user_admin')), ('is_user_profile', '=', False)]" />
        </record>

        <record id="base.action_res_users_view2" model="ir.actions.act_window.view">
            <field name="view_id" ref="view_res_user_form_inherit" />
        </record>

        <record id="view_users_tree_inherit" model="ir.ui.view">
            <field name="name">res.users.tree.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree" />
            <field name="arch" type="xml">
                <field name="company_id" position="before">
                    <field name="role_ids" widget="many2many_tags" />
                </field>
                <field name="name" position="after">
                    <field name="user_profile_id" invisible="context.get('is_user_profile')" />
                </field>
                <xpath expr="//field[@name='login']" position="attributes">
                    <attribute name="column_invisible">context.get('is_user_profile', True)</attribute>
                </xpath>
                <xpath expr="//field[@name='login_date']" position="attributes">
                    <attribute name="column_invisible">context.get('is_user_profile', True)</attribute>
                </xpath>
            </field>
        </record>


        <!-- Profiles -->
        <!-- Add page for technical profile configuration-->
        <record id="action_res_users" model="ir.actions.act_window">
            <field name="name">Users</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="base.view_users_tree" />
            <field name="search_view_id" ref="base.view_users_search" />
            <field name="domain">[('user_profile_id', '=', active_id)]</field>
            <field name="context">{'default_user_profile_id': active_id}</field>
            <field name="help"></field>
        </record>

        <record id="view_user_profile_form" model="ir.ui.view">
            <field name="name">res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="mode">primary</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <data>
                    <field name="name" position="attributes">
                        <attribute name="placeholder">Profile ...</attribute>
                    </field>
                    <div name="button_box" position="inside">
                        <button class="oe_inline oe_stat_button" icon="fa-users" name="%(nwpl_odoo_master.action_res_users)d" type="action">
                            <field string="Users" name="users_count" widget="statinfo" />
                        </button>
                    </div>
                    <xpath expr="//widget[@name='web_ribbon']" position="attributes">
                        <attribute name="invisible">active or is_user_profile</attribute>
                    </xpath>
                    <xpath expr="//div[contains(@class, 'alert-info') and contains(@class, 'o_form_header')]" position="attributes">
                        <attribute name="invisible">is_user_profile or (active and active_partner) or (not active and not active_partner) or (active and not active_partner)</attribute>
                    </xpath>
                    <xpath expr="//label[@for='login']" position="attributes">
                        <attribute name="invisible">is_user_profile</attribute>
                    </xpath>
                    <xpath expr="//field[@name='login']" position="attributes">
                        <attribute name="readonly">is_user_profile</attribute>
                        <attribute name="required">not is_user_profile</attribute>
                        <attribute name="invisible">is_user_profile</attribute>
                    </xpath>
                    <xpath expr="//notebook/page[@name='access_rights']" position="before">
                        <page string="Roles">
                            <field name="role_ids" invisible="1" />
                            <div class="alert alert-info" role="alert">
                                Assign <b>user roles</b> that define sets of groups. Roles allow easier access control management and date-based enablement.
                            </div>
                            <field name="role_line_ids" nolabel="1">
                                <tree editable="bottom" decoration-muted="not is_enabled">
                                    <field name="role_id" domain="[('id', 'not in', parent.role_ids)]" />
                                    <field name="date_from" />
                                    <field name="date_to" />
                                    <field name="is_enabled" />
                                </tree>
                            </field>
                        </page>
                    </xpath>
                    <xpath expr="//notebook/page[@name='access_rights']" position="after">
                        <!-- Group Access Control -->
                        <page string="Group Access Control">
                            <div class="alert alert-warning" role="alert">
                                Directly assign <b>Odoo security groups</b> to this profile.<br/>
                                This is only needed for advanced use or group overrides not covered by roles.
                            </div>
                            <field name="groups_id" widget="many2many_tags" options="{'no_create': True}" context="{'default_category_id': 1}" />
                        </page>
                    </xpath>
                    <notebook position="inside">
                        <page string="Configuration">
                            <div class="alert alert-info" role="alert">
                                Configure this profile's behavior and sync options.<br/>
                                If <b>Sync to Linked Users</b> is enabled, changes to this profile will update all users linked to it.
                            </div>
                            <separator string="Options" colspan="4" />
                            <field name="is_user_profile" invisible="1" />
                            <field name="is_update_users" invisible="not is_user_profile" />
                            <label for="is_update_users" />
                            <separator string="Fields to update for linked users" colspan="4" />
                            <field name="field_ids" nolabel="1" colspan="4" />
                        </page>
                    </notebook>
                    <xpath expr="//header/button[2][@name='action_reset_password']" position="attributes">
                        <attribute name="invisible">is_user_profile</attribute>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_user_profile_form_inherit_tab_cleanup" model="ir.ui.view">
            <field name="name">res.users.form.profile.inherit.tab.cleanup</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="view_user_profile_form"/>
            <field name="arch" type="xml">
                <!-- Rename custom Groups tab -->
                <!-- <xpath expr="//notebook/page[field[@name='groups_id']]" position="attributes">
                    <attribute name="string">Group Access Control</attribute>
                </xpath> -->
                <!-- Hide Access Rights tab -->
                <xpath expr="//notebook/page[@name='access_rights']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>

        <record id="view_user_profile_hide_partner" model="ir.ui.view">
            <field name="name">res.users.form.profile.hide.partner</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="view_user_profile_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//div[contains(@class, 'oe_title')]//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>


        <record id="action_res_user_profiles" model="ir.actions.act_window">
            <field name="name">User Profiles</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="base.view_users_tree" />
            <field name="search_view_id" ref="base.view_users_search" />
            <field name="domain" eval="[('id', '!=', ref('base.user_root')), ('id', '!=', ref('base.user_admin')), ('is_user_profile', '=', True)]" />
            <field name="context">{'active_test': False, 'default_active': False, 'default_is_user_profile': True, 'is_user_profile': True,'no_reset_password': True}</field>
            <field name="help"/>
        </record>

        <record id="action_res_user_profiles_tree_view" model="ir.actions.act_window.view">
            <field eval="1" name="sequence" />
            <field name="view_mode">tree</field>
            <field name="view_id" ref="base.view_users_tree" />
            <field name="act_window_id" ref="action_res_user_profiles" />
        </record>

        <record id="action_res_user_profiles_form_view" model="ir.actions.act_window.view">
            <field eval="2" name="sequence" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_user_profile_form" />
            <field name="act_window_id" ref="action_res_user_profiles" />
        </record>

        <!-- Super Admin -->
        <!-- Hide Create button for Super Admin menu -->
        <record id="view_admin_form" model="ir.ui.view">
            <field name="name">res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//form" position="attributes">
                        <attribute name="create">false</attribute>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="action_administrators" model="ir.actions.act_window">
            <field name="name">Administrators</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="base.view_users_tree" />
            <field name="search_view_id" ref="base.view_users_search" />
            <field name="domain" eval="['|', ('id', '=', ref('base.user_root')), ('id', '=', ref('base.user_admin'))]" />
            <field name="context" eval="{'active_test': False, 'allow_manual_group_toggle': True, 'hide_access_rights_banner': True}"/>
            <field name="help"/>
        </record>

        <record id="action_administrators_tree_view" model="ir.actions.act_window.view">
            <field eval="1" name="sequence" />
            <field name="view_mode">tree</field>
            <field name="view_id" ref="base.view_users_tree" />
            <field name="act_window_id" ref="action_administrators" />
        </record>

        <record id="action_administrators_form_view" model="ir.actions.act_window.view">
            <field eval="2" name="sequence" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_admin_form" />
            <field name="act_window_id" ref="action_administrators" />
        </record>


        <menuitem action="action_res_user_profiles" id="menu_action_res_user_profiles" parent="base.menu_users" sequence="40" />
        <menuitem action="action_administrators" id="menu_action_administrators" parent="base.menu_users" sequence="50" />

        <record id="base.menu_action_res_groups" model="ir.ui.menu">
            <field name="sequence">60</field>
        </record>

    </data>
</odoo>
