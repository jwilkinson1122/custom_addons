<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">

        <!-- Users -->
        <!-- Add widget selection to choose a profile to apply -->
        <record id="view_res_user_form_inherit" model="ir.ui.view">
            <field name="name">res.users.form.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="mode">primary</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_title')]//field[@name='partner_id']" position="after">
                    <field name="superuser_id" invisible="1"/>
                    <field name="user_profile_id" domain="[('id','!=',superuser_id),('is_user_profile', '=', True), ('active', '=', False)]" context="{'active_test': False}" widget="selection" required="True" />
                </xpath>
                <xpath expr="//notebook/page[1]" position="after">
                    <page string="Roles">
                        <field name="role_ids" invisible="1" />
                        <field name="role_line_ids" nolabel="1">
                            <tree editable="bottom" decoration-muted="not is_enabled">
                                <field name="role_id" domain="[('id', 'not in', parent.role_ids)]" />
                                <field name="date_from" />
                                <field name="date_to" />
                                <field name="is_enabled" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_res_user_form_inherit_banner" model="ir.ui.view">
            <field name="name">res.users.form.inherit.banner</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <!-- Put the banner at the top of the Access Rights tab -->
                <xpath expr="//page[@name='access_rights']" position="inside">
                    <div class="alert alert-warning" role="alert"
                        invisible="context.get('hide_access_rights_banner')"
                        groups="!base.group_system">
                        ⚠️ <b>Groups are managed through Profiles and Roles.</b><br/>
                        Manual changes are disabled. Please assign a Profile or Role instead.
                    </div>
                </xpath>
            </field>
        </record>



