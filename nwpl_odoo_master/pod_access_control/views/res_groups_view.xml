<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="view_res_group_form" model="ir.ui.view">
            <field name="name">res.groups.form</field>
            <field name="model">res.groups</field>
            <field name="inherit_id" ref="base.view_groups_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet/group" position="before">
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" name="action_view_roles" type="object" icon="fa-gears" invisible="not role_count">
                            <field string="Roles" name="role_count" widget="statinfo" />
                        </button>
                    </div>
                </xpath>
                <field name="model_access" position="before">
                    <button type="object" name="button_complete_access_controls" string="Complete Access Controls" colspan="4" />
                </field>
                <field name="name" position="after">
                    <field name="active" />
                </field>
                <!-- <xpath expr="//field[@name='users']/tree" position="inside">
                    <field name="is_user_profile" invisible="1"/>
                </xpath> -->
            </field>
        </record>
        <record id="base.action_res_groups" model="ir.actions.act_window">
            <field name="context">{'active_test': False}</field>
        </record>
    </data>
</odoo>
