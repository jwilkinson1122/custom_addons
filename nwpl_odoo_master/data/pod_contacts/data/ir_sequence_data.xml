<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="seq_contact_partner" model="ir.sequence">
        <field name="name">Company Code</field>
        <field name="code">partner.internal.code</field>
        <field name="prefix">CO</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_contact_practice" model="ir.sequence">
        <field name="name">Medical Practice Code</field>
        <field name="code">contact.practice</field>
        <field name="prefix">MP</field>
        <field name="padding">6</field>
    </record>
    <record id="seq_contact_location" model="ir.sequence">
        <field name="name">Location Code</field>
        <field name="code">contact.location</field>
        <field name="prefix">LOC</field>
        <field name="padding">6</field>
    </record>
    <record id="seq_contact_practitioner" model="ir.sequence">
        <field name="name">Practitioner Code</field>
        <field name="code">contact.practitioner</field>
        <field name="prefix">PT</field>
        <field name="padding">6</field>
    </record>
    <record id="seq_contact_patient" model="ir.sequence">
        <field name="name">Patient Code</field>
        <field name="code">contact.patient</field>
        <field name="prefix">PAT</field>
        <field name="padding">6</field>
    </record>
    <record id="seq_contact_flag" model="ir.sequence">
        <field name="name">Flag Code</field>
        <field name="code">contact.flag</field>
        <field name="prefix">FL</field>
        <field name="padding">6</field>
    </record>
</odoo>
