                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-3 border-bottom" t-on-click="() => this.showNewSidebar('calender')">
                                        <img src="./nwpl_odoo_master/static/pod_user_utilities/static/src/img/weekend.png" aria-label="Calender" style="width: 26px; height: 26px;"/>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-3 border-bottom" t-on-click="() => this.showNewSidebar('contacts')">
                                        <img src="./nwpl_odoo_master/static/pod_user_utilities/static/src/img/support.png" aria-label="Contacts" style="width: 26px; height: 26px;"/>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

