<?xml version='1.0' encoding='utf-8' ?>
<templates xml:space="preserve">

    <!-- Base Attribute Component -->
    <t t-name="cpq.ProductTmplAttrib" owl="1">
        <div>
            <div class="mb-3">
                <t t-call="{{ getPTAVTemplate() }}" />
            </div>
            <div class="mb-3" t-if="props.attribute.values.some(e => e.is_custom and ['char', 'float', 'integer'].includes(e.cpq_custom_type))">
                <div t-foreach="props.attribute.values" t-as="ptav" t-key="ptav.id">
                    <t t-if="ptav.is_custom and props.selected[ptav.id] !== undefined and ['char', 'float', 'integer'].includes(ptav.cpq_custom_type)">
                        <strong t-esc="ptav.name" class="form-label" />
                        <p class="text-muted small mb-1">Enter custom value:</p>
                        <t t-if="[false, 'char'].includes(ptav.cpq_custom_type)">
                            <input type="text" class="form-control o_input" t-on-input="(ev) => props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]" />
                        </t>
                        <t t-elif="['float', 'integer'].includes(ptav.cpq_custom_type)">
                            <input type="number" class="form-control o_input" t-att-step="ptav.cpq_custom_type === 'float' ? 0.01 : 1" t-on-input="(ev) => props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]" />
                        </t>
                        <t t-elif="ptav.cpq_custom_type === 'options'">
                            <select class="form-control" t-on-change="(ev) => props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]">
                                <option />
                                <option t-foreach="ptav.cpq_selection_values" t-as="i" t-key="i[0]" t-att-value="i[0]" t-esc="i[1]" t-att-class="{ 'css_not_available': ptav.excluded }" />
                            </select>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>

    <!-- Select Template -->
    <t t-name="cpq.ProductTmplAttrib-select" owl="1">
        <t t-if="!props.hideLabel">
            <strong t-esc="props.attribute.name" class="form-label d-block mb-2" />
        </t>
        <select class="form-select" t-att-name="'ptal-' + props.attribute.id" t-on-change="props.onSelect">
            <option value="">Select...</option>
            <t t-foreach="getVisibleValues()" t-as="ptav" t-key="ptav.id">
                <option t-att-value="ptav.id" t-att-selected="props.selected[ptav.id] !== undefined" t-att-title="ptav.note or ''" t-att-class="ptav.isPreferred ? 'cpq-preferred-label' : ''">
                    <t t-if="ptav.image_128">
                        <img t-att-src="'data:image/png;base64,' + ptav.image_128" class="rounded me-2" style="max-height: 40px; max-width: 40px;" />
                    </t>
                    <t t-esc="ptav.name" />
                    <t t-if="props.side === 'left' and ptav.isPreferredLeft">★ LT</t>
                    <t t-elif="props.side === 'right' and ptav.isPreferredRight">★ RT</t>
                    <t t-elif="!props.side and ptav.isPreferred">★</t>
                </option>
            </t>
        </select>
        <div t-if="selectedValue?.note" class="small text-muted mt-1">
            <i class="fa fa-info-circle me-1" />
            <span t-esc="selectedValue.note" />
        </div>
    </t>

    <!-- Boolean Input Template -->
    <t t-name="cpq.ProductTmplAttrib-boolean" owl="1">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" t-att-id="'ptav-' + props.attribute.id" t-att-checked="Object.keys(props.selected or {}).length > 0" t-on-change="props.onToggle" t-att-title="selectedValue?.note or ''" />
            <label class="form-check-label" t-att-for="'ptav-' + props.attribute.id" t-att-class="selectedValue?.isPreferred ? 'cpq-preferred-label' : ''">
                <t t-esc="props.attribute.name" />
                <t t-if="props.side === 'left' and selectedValue?.isPreferredLeft">
                    <span class="cpq-preferred-badge ms-2">Preferred LT</span>
                </t>
                <t t-elif="props.side === 'right' and selectedValue?.isPreferredRight">
                    <span class="cpq-preferred-badge ms-2">Preferred RT</span>
                </t>
                <t t-elif="!props.side and selectedValue?.isPreferred">
                    <span class="cpq-preferred-badge ms-2">Preferred</span>
                </t>

            </label>
            <div t-if="selectedValue?.note" class="small text-muted mt-1">
                <i class="fa fa-info-circle me-1" />
                <span t-esc="selectedValue.note" />
            </div>
        </div>
    </t>

    <!-- Radio Button Template -->
    <t t-name="cpq.ProductTmplAttrib-radio" owl="1">
        <t t-if="!props.hideLabel">
            <strong t-esc="props.attribute.name" class="form-label d-block mb-2" />
        </t>
        <div class="container-fluid px-0">
            <div class="row row-cols-2 row-cols-md-2 g-2">
                <t t-foreach="getVisibleValues()" t-as="ptav" t-key="ptav.id">
                    <div class="col" t-att-class="!ptav.visible ? 'd-none' : ''">
                        <div class="form-check">
                            <input type="radio" class="form-check-input" 
                            t-att-id="'ptav-' + ptav.id + '-' + (props.side or 'shared')" 
                            t-att-value="ptav.id" 
                            t-att-checked="this.selectedIds.includes(ptav.id + '')"
                            t-att-name="'ptal-' + props.attribute.id + '-' + (props.side or 'shared')" 
                            t-on-change="props.onSelect" t-attf-style="accent-color: {{ ptav.html_color or '' }}" 
                            t-att-title="ptav.note or ''" />
                            <label class="form-check-label d-flex flex-column align-items-start" t-att-for="'ptav-' + ptav.id + '-' + (props.side or 'shared')" t-att-class="ptav.isPreferred ? 'cpq-preferred-label' : ''">
                                <div class="d-flex align-items-center gap-2">
                                    <t t-if="ptav.image_128">
                                        <img t-att-src="'data:image/png;base64,' + ptav.image_128" class="rounded me-2" style="max-height: 40px; max-width: 40px;" />
                                    </t>
                                    <span t-esc="ptav.name" />
                                    <t t-if="props.side === 'left' and ptav.isPreferredLeft">★ LT</t>
                                    <t t-elif="props.side === 'right' and ptav.isPreferredRight">★ RT</t>
                                    <t t-elif="!props.side and ptav.isPreferred">★</t>
                                </div>
                                <div t-if="ptav.note" class="small text-muted">
                                    <i class="fa fa-info-circle me-1" />
                                    <span t-esc="ptav.note" />
                                </div>
                            </label>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>


