<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="cpq_sale_product_template_only_form_view" model="ir.ui.view">
        <field name="name">cpq.sale.product.template.only.form.view</field>
        <field name="model">product.template</field>
        <!-- <field name="priority">75</field> -->
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='uom_id']" position="after">
                <field name="sale_secondary_uom_id"/>
            </xpath> -->
            <xpath expr="//field[@name='description_sale']/parent::group" position="after">
                <group string="Configurable Sale Description Template" name="cpq_sale_description" invisible="cpq_ok == False">
                    <field name="cpq_ok" invisible="1" />
                    <field name="cpq_description_sale_tmpl" nolabel="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>

