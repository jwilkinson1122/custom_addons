<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <!-- Sale Order Quotation -->
    <record id="inherit_cpq_view_quotation_tree" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.quotation.cpq</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <!-- Red row + bold for rush -->
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">rush_3day</attribute>
                <attribute name="decoration-bf">rush_3day</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="affiliate_id" string="Affiliate" context="{'show_clean_name': True}"/>
                <field name="contact_id" string="Contact" context="{'show_clean_name': True}"/>
                <field name="patient_id" string="Patient" context="{'show_clean_name': True}"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="rush_3day" string="RUSH" widget="boolean_toggle"/>
                <!-- <field name="rush_due_date"/> -->
                <field name="rush_due_date" widget="datetime"/>

            </xpath>
        </field>
    </record>


    <!-- Sale Order Form View -->
    <record id="inherit_cpq_view_sales_order_filter" model="ir.ui.view">
        <field name="name">sale.order.filter.inherit.cpq</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="rush_3day" string="3‑Day Rush" domain="[('rush_3day','=',True)]"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="current_revision_id" invisible="1" />
            </xpath>
        </field>
    </record>
    <!-- Sale Order Tree View -->
    <record id="inherit_cpq_view_order_tree" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.cpq</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="affiliate_id" string="Affiliate"/>
                <field name="contact_id" string="Contact"/>
                <field name="patient_id" string="Patient"/>
            </xpath>
            <xpath expr="//field[@name='amount_tax']" position="after">
                <field name="invoiced_amount" sum="Invoiced Amount" optional="hide" />
                <field name="uninvoiced_amount" sum="Uninvoiced Amount" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="rush_3day" string="RUSH" widget="boolean_toggle"/>
                <field name="rush_due_date"/>
            </xpath>
        </field>
    </record>
    <!-- Sale Order Kanban View -->
    <record id="inherit_cpq_view_sale_order_kanban" model="ir.ui.view">
        <field name="name">sale.order.kanban.inherit.cpq</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="after">
                <div class="text-muted mt8" groups="base.group_user">
                    <t t-if="record.affiliate_id.raw_value">
                        <div>
                            <strong>Affiliate:</strong>
                            <field name="affiliate_id" context="{'show_clean_name': True}"/>
                        </div>
                    </t>
                    <t t-if="record.contact_id.raw_value">
                        <div>
                            <strong>Contact:</strong>
                            <field name="contact_id" context="{'show_clean_name': True}"/>
                        </div>
                    </t>
                    <t t-if="record.patient_id.raw_value">
                        <div>
                            <strong>Patient:</strong>
                            <field name="patient_id" context="{'show_clean_name': True}"/>
                        </div>
                    </t>
                </div>
            </xpath>
            <!-- <xpath expr="//div[hasclass('oe_kanban_bottom_right')]" position="inside">
                <t t-if="record.rush_3day.raw_value">
                    <span class="badge rounded-pill text-bg-danger">3‑Day Rush</span>
                </t>
            </xpath> -->
            <!-- <div class="oe_kanban_bottom_right">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div> -->
        </field>
    </record>
    <!-- Sale Order View -->
    <record id="inherit_cpq_view_order_line_form" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.cpq</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="create_revision" invisible="state not in ['cancel' ,'sent']" string="Create Revision" type="object" />
                <button name="%(mrp.mrp_production_action)s" type="action" context="{'search_default_sale_id': active_id}" string="Manufacturing Orders" icon="fa-industry" class="oe_stat_button"/>
                <!-- print the standard Sale Order report -->
                <button name="sale.action_report_saleorder" type="action" string="Print Sale Order" class="btn btn-primary" invisible="state == 'cancel'"/>
            </xpath>
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button name="action_view_revisions" type="object" class="oe_stat_button" icon="fa-file-archive-o" invisible="not has_old_revisions or revision_count == 0">
                    <field name="revision_count" widget="statinfo" string="View Revisions" />
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <!-- Affiliates of selected Account -->
                <field name="affiliate_id" domain="[('parent_id', '=', partner_id), ('is_affiliate', '=', True)]" context="{'show_clean_name': True}"/>
                <!-- Contacts: only children of selected Affiliate or Account -->
                <field name="contact_id" domain="[('is_contact', '=', True), ('parent_id', '=', (affiliate_id or partner_id))]" context="{'show_clean_name': True}"/>
                <field name="patient_id" domain="[('is_patient', '=', True), '|', ('primary_contact_id', '=', contact_id), ('parent_id', '=', (affiliate_id or partner_id))]" context="{'show_clean_name': True}"/>
                
                <field name="ship_to_patient" invisible="not patient_id"/>
                <field name="current_revision_id" invisible="not current_revision_id" />
                <field name="has_old_revisions" invisible="1" />
                <!-- <field name="rush_3day"/>
                <field name="rush_due_date" readonly="1"/> -->
            </xpath>
            <!-- <xpath expr="//field[@name='patient_id']" position="after">
                <field name="ship_to_patient" invisible="not patient_id"/>
            </xpath> -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <!-- <field name="ship_to_patient" invisible="not patient_id"/> -->
                <field name="rush_3day"/>
                <field name="rush_due_date" readonly="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="cpq_order_qr_image" widget="image" class="oe_avatar" options='{"zoom": true, "size": [128, 128]}'/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-warning">cpq_unconfigured</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="cpq_unconfigured" column_invisible="1"/>
                <field name="cpq_laterality" column_invisible="1"/>
                <button name="edit_cpq_configuration" title="Reconfigure" type="object" class="btn-secondary" icon="fa-cogs" invisible="not product_template_id_cpq_ok"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree/field[@name='product_template_id']" position="before">
                <field name="product_template_id_cpq_ok" column_invisible="1" />
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="before">
                <field name="cpq_qr_code_image" widget="image" class="oe_avatar" options='{"zoom": true, "size": [30, 40]}'/>
            </xpath>
            <!-- <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath> -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="cpq_laterality" string="Side" column_invisible="1"/>
                <field name="cpq_configuration_summary" class="cpq-config-summary-tree" widget="html" options="{'sanitize': False}" string="Configuration Summary" readonly="1"/>
                <!-- <field name="cpq_configuration_summary" class="cpq-config-summary-tree" widget="html" string="Configuration Summary" readonly="1"/> -->
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='cpq_configuration_summary']" position="after">
                <field name="cpq_unconfigured" string="Missing Config" widget="boolean" readonly="1" column_invisible="1" options="{'terminology': 'Alert'}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="price_unit_display" string="Unit Price" readonly="1" invisible="not product_template_id_cpq_ok"/>
                <field name="computed_amount"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='tax_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='price_subtotal']" position="attributes">
                <attribute name="string">Subtotal</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='discount']" position="after">
                <field name="price_subtotal_no_discount" column_invisible="1" />
                <field name="price_total_no_discount" column_invisible="1" />
            </xpath>
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <field name="product_template_id_cpq_ok" invisible="1"/>
                <button name="toggle_debug_cpq_json" string="Toggle Custom JSON" type="object" class="btn-secondary" />
                <notebook>
                    <page string="Custom Details" invisible="not product_template_id_cpq_ok">
                        <group>
                            <field name="cpq_laterality" readonly="1"/>
                            <field name="cpq_configuration_summary" string="Config Summary" widget="html" readonly="1" class="cpq-config-summary"/>
                            <field name="cpq_configuration_json" invisible="1"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <!-- Sale Order Discount View -->
    <record id="sale_order_view_form_display_discount" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='tax_totals']" position="after">
                    <field name="display_discount_with_tax" invisible="1" position="attributes">
                    </field>
                    <field name="price_subtotal_no_discount" invisible="display_discount_with_tax" position="attributes">
                    </field>
                    <field name="discount_subtotal" invisible="display_discount_with_tax" position="attributes">
                    </field>
                    <field name="price_total_no_discount" invisible="not display_discount_with_tax" position="attributes">
                    </field>
                    <field name="discount_total" invisible="not display_discount_with_tax" position="attributes">
                    </field>
                </xpath>
            </data>
        </field>
    </record>
    <!-- Sale Order Stock View -->
    <record id="view_order_form_inherit_sale_stock" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
        <field name="arch" type="xml">
            <group name="sale_shipping" position="inside">
                <field name="picking_note" readonly="state not in ('draft','sent')" />
                <field name="picking_customer_note" readonly="state not in ('draft','sent')" />
            </group>
        </field>
    </record>

</odoo>
