<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--  Sequence for Prescription  -->
    <record id="seq_podiatry_prescription" model="ir.sequence">
        <field name="name">Podiatry Prescription</field>
        <field name="code">podiatry.prescriptions</field>
        <field name="prefix">PRN</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <!--  Sequence for Appointment  -->
    <record id="seq_podiatry_appointment" model="ir.sequence">
        <field name="name">Podiatry Appointment</field>
        <field name="code">podiatry.appointment</field>
        <field name="prefix">DAP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
