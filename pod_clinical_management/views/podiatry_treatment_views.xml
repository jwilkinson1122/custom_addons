<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Tree View-->
    <record id="podiatry_treatment_view_tree" model="ir.ui.view">
        <field name="name">podiatry.treatment.view.tree</field>
        <field name="model">podiatry.treatment</field>
        <field name="arch" type="xml">
            <tree string="Podiatry Treatment" editable="bottom">
                <field name="name" required="True"/>
                <field name="treatment_categ_id" required="True"/>
                <field name="cost"/>
            </tree>
        </field>
    </record>
</odoo>
