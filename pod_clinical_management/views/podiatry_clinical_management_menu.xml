<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Menu Action view for Podiatry Appointments-->
    <record id="podiatry_appointment_menu_action" model="ir.actions.act_window">
        <field name="name">Doctors Appointment</field>
        <field name="res_model">podiatry.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': True}</field>
    </record>
    <!--Menu Action view for Podiatry Doctors-->
    <record id="podiatry_doctor_menu_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!--Menu Action view for Podiatry Patients-->
    <record id="podiatry_patients_menu_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('is_patient','=',True)]</field>
        <field name="context">{'default_company_type':'person'}</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!--Menu Action view for Podiatry Prescription-->
    <record id="podiatry_prescription_menu_action" model="ir.actions.act_window">
        <field name="name">Podiatry Prescription</field>
        <field name="res_model">podiatry.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': True}</field>
    </record>
    <!--Menu Action view for Podiatry Specialist-->
    <record id="podiatry_specialist_menu_action" model="ir.actions.act_window">
        <field name="name">Specialized</field>
        <field name="res_model">podiatry.specialist</field>
        <field name="view_mode">tree</field>
    </record>
    <!--Menu Action view for Treatment Category-->
    <record id="treatment_category_menu_action" model="ir.actions.act_window">
        <field name="name">Treatment Category</field>
        <field name="res_model">treatment.category</field>
        <field name="view_mode">tree</field>
    </record>
    <!--Menu Action view for Podiatry Treatment-->
    <record id="podiatry_treatment_menu_action" model="ir.actions.act_window">
        <field name="name">Podiatry Treatment</field>
        <field name="res_model">podiatry.treatment</field>
        <field name="view_mode">tree</field>
    </record>
    <!--Menu Action view for Podiatry Medicines-->
    <record id="medicines_menu_action" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.template</field>
        <field name="domain">[('is_medicine','=',True)]</field>
        <field name="context">{'default_is_medicine':True, 'default_detailed_type': 'product'}</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!--Menu Action view for Medical Frequency-->
    <record id="medicine_frequency_menu_action" model="ir.actions.act_window">
        <field name="name">Medicine Frequency</field>
        <field name="res_model">medicine.frequency</field>
        <field name="view_mode">tree</field>
    </record>
    <!--Menu Action view for Insurance Company-->
    <record id="insurance_company_menu_action" model="ir.actions.act_window">
        <field name="name">Insurance Company</field>
        <field name="res_model">insurance.company</field>
        <field name="view_mode">tree</field>
    </record>
    <!--Menu Action view for Podiatry Time Shifts-->
    <record id="podiatry_time_shift_menu_action" model="ir.actions.act_window">
        <field name="name">Podiatry Time Shift</field>
        <field name="res_model">podiatry.time.shift</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!--Menu Action view for Medical Questions-->
    <record id="medical_questions_menu_action" model="ir.actions.act_window">
        <field name="name">Medical Questions</field>
        <field name="res_model">medical.questions</field>
        <field name="view_mode">tree</field>
    </record>
    <!--Menu Action view for X-Ray Reports-->
    <record id="report_menu_action" model="ir.actions.act_window">
        <field name="name">report</field>
        <field name="res_model">xray.report</field>
        <field name="view_mode">form</field>
    </record>
    <!-- Added Menus-->
    <menuitem id="podiatrist_menu_root" web_icon="pod_clinical_management,static/description/icon.png" name="Podiatry Clinic"/>
    <menuitem id="podiatrist_menu_root" name="Podiatry Clinic" action="podiatry_appointment_menu_action"/>
    <menuitem id="appointments_main_menu" name="Appointments" parent="podiatrist_menu_root" sequence="1" action="podiatry_appointment_menu_action"/>
    <menuitem id="prescriptions_main_menu" name="Prescriptions" parent="podiatrist_menu_root" sequence="2" action="podiatry_prescription_menu_action"/>
    <menuitem id="patients_main_menu" name="Patients" parent="podiatrist_menu_root" sequence="3" action="podiatry_patients_menu_action"/>
    <menuitem id="podiatrist_main_menu" name="Podiatrist" parent="podiatrist_menu_root" sequence="4" action="podiatry_doctor_menu_action"/>
    <menuitem id="config_main_menu" name="Configuration" parent="podiatrist_menu_root" sequence="5"/>
    <menuitem id="practitioners_main_menu" name="Physicians" parent="config_main_menu" sequence="1"/>
    <menuitem id="department_main_menu" name="Department" parent="practitioners_main_menu" sequence="1" action="hr.hr_department_tree_action"/>
    <menuitem id="specialist_main_menu" name="Specialized" parent="practitioners_main_menu" sequence="2" action="podiatry_specialist_menu_action"/>
    <menuitem id="podiatry_time_shift" name="Time Shift" parent="practitioners_main_menu" sequence="3" action="podiatry_time_shift_menu_action"/>
    <menuitem id="medical_procedures_main_menu" name="Medical Procedures" parent="config_main_menu" sequence="2"/>
    <menuitem id="treatment_categories_main_menu" name="Treatment Categories" parent="medical_procedures_main_menu" sequence="1" action="treatment_category_menu_action"/>
    <menuitem id="treatment_main_menu" name="Treatment" parent="medical_procedures_main_menu" sequence="2" action="podiatry_treatment_menu_action"/>
    <menuitem id="medicines_main_menu" name="Medicines" parent="medical_procedures_main_menu" sequence="3" action="medicines_menu_action"/>
    <menuitem id="medicine_frequency_main_menu" name="Medicament Frequency" parent="medical_procedures_main_menu" sequence="4" action="medicine_frequency_menu_action"/>
    <menuitem id="medical_questions_main_menu" name="Medical Questions" parent="medical_procedures_main_menu" sequence="5" action="medical_questions_menu_action"/>
    <menuitem id="insurance_main_menu" name="Insurance" parent="config_main_menu" sequence="3"/>
    <menuitem id="insuarnce_company_main_menu" name="Insurance Company" parent="insurance_main_menu" sequence="1" action="insurance_company_menu_action"/>
</odoo>
