<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Set the record rule for visible only the corresponding doctor appointments -->
    <record id="own_podiatry_appointments" model="ir.rule">
        <field name="name">Own Appointments</field>
        <field name="model_id" ref="model_podiatry_appointment"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('pod_clinical_managementgroup_podiatry_doctor'))]"/>
    </record>
    <!-- To see all the appointments for the manager -->
    <record id="see_all_podiatry_appointments" model="ir.rule">
        <field name="name">All Appointments</field>
        <field ref="model_podiatry_appointment" name="model_id"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('pod_clinical_managementgroup_podiatry_manager'))]"/>
    </record>
    <!-- Set the record rule for visible only the corresponding doctor prescriptions -->
    <record id="own_podiatry_prescription" model="ir.rule">
        <field name="name">Own Prescriptions</field>
        <field name="model_id" ref="model_podiatry_prescription"/>
        <field name="domain_force">[('prescribed_doctor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('pod_clinical_managementgroup_podiatry_doctor'))]"/>
    </record>
    <!-- To see all the prescriptions for the manager -->
    <record id="see_all_podiatry_prescriptions" model="ir.rule">
        <field name="name">All Prescriptions</field>
        <field ref="model_podiatry_prescription" name="model_id"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('pod_clinical_managementgroup_podiatry_manager'))]"/>
    </record>
</odoo>