<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_podiatry" model="ir.ui.view">
        <field name="name">res.partner.form.podiatry</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page string="NWPL" name="nwpl">
                    <group string="Membership">
                        <field name="nwpl_membership_number" string="Number" invisible="is_company"/>
                        <field name="nwpl_uuid" string="UUID" class="oe_edit_only"/>
                        <field name="nwpl_internal_url" string="Internal URL" widget="url" class="oe_read_only"/>
                        <field name="nwpl_external_url" string="External URL" widget="url" class="oe_read_only"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
