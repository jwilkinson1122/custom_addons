<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="email_template_new_season_badbertrixpractice" model="mail.template">
        <field name="name">New season - Welcome (NW Podiatric)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="email_from">{{ user.company_id.email_formatted }}</field>
        <field name="partner_to">{{ object.responsible_id.id if object.responsible_id.email else object.id }}</field>
        <field name="subject">Launch of the new season!</field>
        <field name="lang">{{ object.lang }}</field>
        <field name="kind">new_season</field>
        <field name="body_html" type="html">
            <t t-call="practice.email_default_layout">
                <t t-set="_season" t-value="ctx.get('season_id')"/>
                <t t-set="sender" t-value="user"/>
                <t t-set="company" t-value="_o.company_id if _o else sender.company_id"/>
                <t t-set="title_1" t-value="'Podiatry'"/>
                <t t-set="title_2" t-value="'Lancement de la nouvelle saison%s' % ((': ' + _season.name) if _season else '')"/>
                <t t-set="body_payload">
                    <div>
                        <p>
                Dear <t t-out="object.name.split()[0] or 'member'">member</t>,
                        </p>
                        <p>
                After several sunny weeks away from the field, it's finally time to get back to your favorite sport!
                        </p>
                        <p>
                Attached you will find the launch letter for this new season containing all the practical information.
                        </p>
                        <p>
                In order to update our database and registrations with the league, please also provide us with your contact details (name, first name, address, email, mobile number), either by sending us the <a href="profile_badbertrixpractice/static/pdf/inscription_nwpl.pdf?download=true" target="_blank">league document</a>, either by simply returning this email.
                        </p>
                        <t t-if="_season and _season.period_category_ids">
                            <p>
                                <t t-set="default_category" t-value="_season.period_category_ids.filtered(lambda pc: pc.default).category_id"/>
                Affiliations are divided into the following categories:
                                <ul>
                                    <li t-foreach="_season.period_category_ids" t-as="period_category">
                                        <span t-out="period_category.category_id.name" style="font-weight: bolder;">Category X</span>
                                        <ul>
                                            <li>
                                                <u>Amount due:</u>
                                                <span t-out="format_amount(period_category.price_due, period_category.currency_id)">XXX $</span>
                                            </li>
                                            <li t-if="period_category.category_id.description">
                                                <u>Description:</u>
                                                <span t-out="period_category.category_id.description">Category Description</span>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                Could you indicate the category of your choice when replying to this email?
                                <t t-if="default_category">
                    (If omitted, the category <i t-out="default_category.name">Category X</i> will be the one chosen by default.)
                                </t>
                            </p>
                        </t>
                        <p>
                            <u>In short:</u>
                            <ul>
                                <li>Training resumes for the <span style="font-weight: bolder;">young people</span> (-18 years) from Saturday <span style="font-weight: bolder;">03 September<span style="font-weight: normal;"> from 9 a.m. to 10 a.m.</span>
                                    <span style="font-weight: 400;">.</span>
                                </span>
                            </li>
                            <li>Resumption of the 3 training sessions <span style="font-weight: bolder;">adults</span> per week. The first dates are:</li>
                            <ul style="margin:0px 0 0px 0;box-sizing:border-box;">
                                <li>Monday <span style="font-weight: normal;">05 September</span>
                                </li>
                                <li>Tuesday September 6<br/>
                                </li>
                                <li>Thursday <span style="font-weight: bolder;">01 September</span>
                                    <br/>
                                </li>
                            </ul>
                            <li>Supervised training for adults will be given on Mondays from 8:00 p.m. to 9:15 p.m.<br/>
                            </li>
                            <li>Home affiliate matches will be played on Thursdays (on average one Thursday out of four).</li>
                        </ul>
                    </p>
                    <p>
                Looking forward to seeing many of you (again) on the fields!
                    </p>
                    <p>
                Sportingly,
                    </p>
                </div>
            </t>
        </t>
    </field>
</record>
</odoo>
