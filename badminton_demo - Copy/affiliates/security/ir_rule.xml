<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="affiliate_internal_rule" model="ir.rule">
        <field name="name">Internal User can only view teams if is player/referee/responsible</field>
        <field name="model_id" ref="model_affiliate"/>
        <field name="domain_force">[
            '|', '|',
            ('player_ids', 'in', user.partner_id.id),
            ('referee_ids', 'in', user.partner_id.id),
            ('responsible_id', '=', user.partner_id.id),
        ]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="affiliate_user_rule" model="ir.rule">
        <field name="name">Affiliate User can only alter teams if is responsible</field>
        <field name="model_id" ref="model_affiliate"/>
        <field name="domain_force">[('responsible_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('affiliates.group_affiliates_affiliate_user'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="affiliate_manager_rule" model="ir.rule">
        <field name="name">Affiliate Manager has full access on teams</field>
        <field name="model_id" ref="model_affiliate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('affiliates.group_affiliates_affiliate_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="affiliate_event_delete_rule" model="ir.rule">
        <field name="name">Refuse to delete an Affiliate Event if not in draft/cancelled</field>
        <field name="model_id" ref="model_affiliate_event"/>
        <field name="domain_force">[('state', 'in', ('draft', 'cancelled'))]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="affiliate_event_internal_rule" model="ir.rule">
        <field name="name">Internal User can only view events if is player/referee/responsible</field>
        <field name="model_id" ref="model_affiliate_event"/>
        <field name="domain_force">[
            '|', '|',
            ('partner_ids', 'in', user.partner_id.id),
            ('referee_id', '=', user.partner_id.id),
            ('affiliate_id.responsible_id', '=', user.partner_id.id),
        ]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="affiliate_event_user_rule" model="ir.rule">
        <field name="name">Affiliate User can only alter events if is responsible</field>
        <field name="model_id" ref="model_affiliate_event"/>
        <field name="domain_force">[('affiliate_id.responsible_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('affiliates.group_affiliates_affiliate_user'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="affiliate_event_manager_rule" model="ir.rule">
        <field name="name">Affiliate Manager has full access on events</field>
        <field name="model_id" ref="model_affiliate_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('affiliates.group_affiliates_affiliate_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
