<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Categories -->
        <record id="module_category_affiliate" model="ir.module.category">
            <field name="name">Affiliate</field>
            <field name="description">Helps you manage affiliate groups.</field>
            <!-- <field name="sequence">10</field> -->
        </record>

        <!-- Groups -->
        <record id="group_affiliates_affiliate_user" model="res.groups">
            <field name="name">User</field>
            <field name="comment">Affiliate users for the module Affiliates. They usually have only a read access to the application.</field>
            <field name="category_id" ref="module_category_affiliate"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_affiliates_affiliate_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="comment">Affiliate managers for the module Affiliates. On top of the affiliate users, managers can usually create/modify/delete records.</field>
            <field name="category_id" ref="module_category_affiliate"/>
            <field name="implied_ids" eval="[(4, ref('group_affiliates_affiliate_user'))]"/>
        </record>

        <!-- Add "Affiliate / User" group to "Default User Template" -->
        <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[Command.link(ref('affiliates.group_affiliates_affiliate_user'))]"/>
        </record>
    </data>
</odoo>
