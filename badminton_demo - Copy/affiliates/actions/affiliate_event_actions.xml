<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_affiliate_event" model="ir.actions.act_window">
        <field name="name">All Affiliate Events</field>
        <field name="res_model">affiliate.event</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_state_draft_search': 1,
            'search_default_state_opened_search': 1,
            'search_default_state_confirmed_search': 1,
            'search_default_current_season_search': 1,
            'search_default_affiliate_groupby': 1,
        }
        </field>
    </record>

    <record id="action_affiliate_event_my" model="ir.actions.act_window">
        <field name="name">My Affiliate Events</field>
        <field name="res_model">affiliate.event</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_state_draft_search': 1,
            'search_default_state_opened_search': 1,
            'search_default_state_confirmed_search': 1,
            'search_default_current_season_search': 1,
            'search_default_my_events_search': 1,
        }
        </field>
    </record>

    <record id="action_affiliate_event_active_affiliate" model="ir.actions.act_window">
        <field name="name">Affiliate Events - Active Affiliate</field>
        <field name="res_model">affiliate.event</field>
        <field name="view_mode">tree,form</field>        <!-- TODO Add custom kanban view (grouped by state)? -->
        <field name="domain">[('affiliate_id', '=', active_id)]</field>
        <field name="context">{
            'default_affiliate_id': active_id,
            'search_default_state_draft_search': 1,
            'search_default_state_opened_search': 1,
            'search_default_state_confirmed_search': 1,
            'from_affiliate': True,
        }</field>
    </record>
</odoo>
