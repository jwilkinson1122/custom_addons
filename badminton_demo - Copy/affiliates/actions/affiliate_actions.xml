<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_affiliates" model="ir.actions.act_window">
            <field name="name">Affiliates</field>
            <field name="res_model">affiliate</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{
            'search_default_my_favorites_search': 1,
        }
            </field>
        </record>

        <record id="action_competition_configuration" model="ir.actions.act_window">
            <field name="name">Competition</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'affiliates'}</field>
        </record>
    </data>
</odoo>
