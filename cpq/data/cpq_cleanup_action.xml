    <!-- Action Window to trigger the server action -->
    <record id="action_cpq_cleanup_manual" model="ir.actions.act_window">
        <field name="name">CPQ Cleanup: Disable cpq_ok for Non-CPQ Templates</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="server_action_id" ref="ir_actions_server_cpq_cleanup"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_cpq_cleanup_action" name="CPQ Cleanup Tool" parent="product.menu_product_config" action="action_cpq_cleanup_manual" sequence="100" groups="base.group_system"/>
