    <t t-name="cpq.ProductTmplAttrib-color" owl="1">
        <t t-if="!props.hideLabel">
            <strong t-esc="props.attribute.name" class="form-label d-block mb-2" />
        </t>
        <ul class="list-inline">
            <li t-foreach="props.attribute.ptav_ids" t-as="ptav" t-key="ptav.id" class="list-inline-item me-1">
                <label t-attf-style="background-color: {{ptav.is_custom ? '' : ptav.html_color}}; width: 40px; height: 40px;"
                    class="css_attribute_color"
                    t-att-class="{ 'css_attribute_color': 1, 'active': props.selected.hasOwnProperty(ptav.id) }"
                    t-att-title="ptav.name">
                    <input type="radio" class="form-check-input"
                        t-att-id="ptav.id" t-att-value="ptav.id"
                        t-att-checked="props.selected[ptav.id] ? 'selected' : undefined"
                        t-att-name="'ptal-' + props.id" t-on-change="props.onSelect"
                        t-attf-style="accent-color: {{ ptav.html_color || '' }}" />
                </label>
            </li>
        </ul>
    </t>

</templates>