                    <input type="radio" class="form-check-input" t-att-id="ptav.id" t-att-value="ptav.id" t-att-checked="props.selected[ptav.id] ? 'selected' : undefined" t-att-name="'ptal-' + props.id" t-on-change="props.onSelect" t-attf-style="accent-color: {{ ptav.html_color ? ptav.html_color : '' }}" />
