<?xml version='1.0' encoding='utf-8' ?>
<templates xml:space="preserve">
    <t t-name="cpq.ProductTmplAttrib" owl="1">
        <div>
            <div class="mb-3">
                <t t-call="{{ getPTAVTemplate() }}" />
            </div>

            <div class="mb-3" t-if="props.attribute.ptav_ids.some((e) =&gt; e.is_custom)">
                <div t-foreach="props.attribute.ptav_ids.filter((e) =&gt; e.is_custom)" t-as="ptav" t-key="ptav.id">
                    <t t-if="ptav.is_custom and typeof props.selected[ptav.id] === 'string' and props.selected[ptav.id].trim()">

                    <!-- <t t-if="props.selected.hasOwnProperty(ptav.id)"> -->
                        <strong t-esc="ptav.name" class="form-label" />
                        <t t-if="[false, 'char'].includes(ptav.cpq_custom_type) ">
                            <input type="text" class="form-control o_input" t-on-input="(ev) =&gt; props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]" />
                        </t>
                        <t t-elif="['float', 'integer'].includes(ptav.cpq_custom_type)">
                            <input type="number" class="form-control o_input" t-attf-step="{{ ptav.cpq_custom_type === 'float' ? 0.01 : 1 }}" t-on-input="(ev) =&gt; props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]" />
                        </t>
                        <t t-elif="ptav.cpq_custom_type === 'many2one'">
                            <b>unsupported</b>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
