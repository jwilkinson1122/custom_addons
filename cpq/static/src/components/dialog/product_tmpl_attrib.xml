<?xml version='1.0' encoding='utf-8' ?>
<templates xml:space="preserve">

    <!-- Base Attribute Component -->
    <t t-name="cpq.ProductTmplAttrib" owl="1">
        <div>
            <div class="mb-3">
                <t t-call="{{ getPTAVTemplate() }}" />
            </div>
            <div class="mb-3" t-if="props.attribute.values.some(e => e.is_custom and ['char', 'float', 'integer'].includes(e.cpq_custom_type))">
                <div t-foreach="props.attribute.values" t-as="ptav" t-key="ptav.id">
                    <t t-if="ptav.is_custom
                            and props.selected[ptav.id] !== undefined
                            and ['char', 'float', 'integer'].includes(ptav.cpq_custom_type)">
                        <strong t-esc="ptav.name" class="form-label" />
                        <p class="text-muted small mb-1">Enter custom value:</p>
                        <t t-if="[false, 'char'].includes(ptav.cpq_custom_type)">
                            <input type="text" class="form-control o_input" t-on-input="(ev) => props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]" />
                        </t>
                        <t t-elif="['float', 'integer'].includes(ptav.cpq_custom_type)">
                            <input type="number" class="form-control o_input" t-att-step="ptav.cpq_custom_type === 'float' ? 0.01 : 1" t-on-input="(ev) => props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]" />
                        </t>
                        <t t-elif="ptav.cpq_custom_type === 'options'">
                            <select class="form-control" t-on-change="(ev) =&gt; props.onCustom(ptav.id, ev)" t-att-value="props.selected[ptav.id]">
                                <option />
                                <option t-foreach="ptav.cpq_selection_values" t-as="i" t-key="i[0]" t-att-value="i[0]" t-esc="i[1]" t-att-class="{ 'css_not_available': ptav.excluded }" />
                            </select>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
    <t t-name="cpq.ProductTmplAttrib-select" owl="1">
        <t t-if="!props.hideLabel">
            <label t-att-for="'ptal-' + props.attribute.id + '-' + (props.side || 'shared')" class="form-label font-weight-bold">
                <t t-esc="props.attribute.name" />
            </label>
        </t>
        <select class="form-control" t-on-change="props.onSelect" t-att-name="'ptal-' + props.attribute.id + '-' + (props.side || 'shared')" t-att-id="'ptal-' + props.attribute.id + '-' + (props.side || 'shared')">
            <option />
            <option t-foreach="getVisibleValues()" t-as="ptav" t-key="ptav.id" t-att-value="ptav.id" t-att-selected="props.selected[ptav.id] !== undefined" t-att-class="{ 'css_not_available': ptav.excluded }" t-esc="ptav.name" />
        </select>
    </t>
    <!-- Radio Button Template -->
    <t t-name="cpq.ProductTmplAttrib-radio" owl="1">
        <t t-if="!props.hideLabel">
            <strong t-esc="props.attribute.name" class="form-label d-block mb-2" />
        </t>
        <div t-foreach="getVisibleValues()" t-as="ptav" class="form-check form-check-inline" t-key="ptav.id">
            <input type="radio" class="form-check-input" t-att-id="'ptav-' + ptav.id + '-' + (props.side || 'shared')" t-att-value="ptav.id" t-att-checked="props.selected[ptav.id] !== undefined" t-att-name="'ptal-' + props.attribute.id + '-' + (props.side || 'shared')" t-on-change="props.onSelect" t-attf-style="accent-color: {{ ptav.html_color || '' }}" />
            <label class="form-check-label" t-att-for="'ptav-' + ptav.id + '-' + (props.side || 'shared')">
                <span t-esc="ptav.name" />
            </label>
        </div>
    </t>
    <!-- Color Swatch Template -->
    <t t-name="cpq.ProductTmplAttrib-color" owl="1">
        <t t-if="!props.hideLabel">
            <strong t-esc="props.attribute.name" class="form-label d-block mb-2" />
        </t>
        <ul class="list-inline">
            <li t-foreach="getVisibleValues()" t-as="ptav" t-key="ptav.id" class="list-inline-item me-1">
                <label t-attf-style="background-color: {{ptav.is_custom ? '' : ptav.html_color}}; width: 40px; height: 40px;" t-att-class="{ 'css_attribute_color': 1, 'active': props.selected.hasOwnProperty(ptav.id) }" t-att-title="ptav.name">
                    <input type="radio" class="form-check-input" t-att-id="ptav.id" t-att-value="ptav.id" t-att-checked="props.selected[ptav.id] !== undefined" t-att-name="'ptal-' + props.attribute.id" t-on-change="props.onSelect" t-attf-style="accent-color: {{ ptav.html_color || '' }}" />
                </label>
            </li>
        </ul>
    </t>
</templates>
 