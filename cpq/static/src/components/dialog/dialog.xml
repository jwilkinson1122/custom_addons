<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="cpq.ConfigureDialogDialog" owl="1">
        <Dialog size="size" title="title">
            <div class="row position-relative">
                <div class="col">
                    <!-- 🔹 Product Header -->
                    <h3 class="fw-bold mb-3">
                         <div t-if="!state.valid &amp;&amp; Object.keys(state.errors).length &gt; 0" class="alert alert-warning" role="alert">
                            <ul t-foreach="Object.entries(state.errors)" t-as="e" t-key="e[0]" class="list-unstyled mb-0">
                                <li t-esc="e[1]" />
                            </ul>
                        </div>
                        <t t-if="productTemplate and productTemplate.description_sale">
                            <div class="mb-3" t-esc="productTemplate.description_sale" />
                        </t>
                    </h3>

                    <!-- 🔸 Laterality Selection -->
                    <div class="mb-4 border-bottom pb-3">
                        <label class="form-label fw-bold">Laterality</label>
                        <div class="d-flex gap-4">
                            <label class="form-check-label"><input type="radio" name="laterality" class="form-check-input" value="left" t-att-checked="state.laterality === 'left' ? 'checked' : undefined" t-on-change="onLateralityChange"/> Left Only</label>
                            <label class="form-check-label"><input type="radio" name="laterality" class="form-check-input" value="right" t-att-checked="state.laterality === 'right' ? 'checked' : undefined" t-on-change="onLateralityChange"/> Right Only</label>
                            <label class="form-check-label"><input type="radio" name="laterality" class="form-check-input" value="bilateral" t-att-checked="state.laterality === 'bilateral' ? 'checked' : undefined" t-on-change="onLateralityChange"/> Bilateral</label>
                        </div>
                    </div>
                    <!-- 🔸 Split + Quantity Box -->
                    <div class="p-3 bg-light border rounded shadow-sm mb-4">
                        <t t-if="state.laterality === 'bilateral'">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-check-label"><input type="checkbox" t-att-checked="state.split ? 'checked' : undefined" t-on-click="onSplitToggle" /> Customize Left / Right Separately</label>
                                <div class="d-flex gap-2 align-items-center">
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => onDecreaseQuantity()">➖</button>
                                <input class="form-control text-center" style="width: 50px;" name="product_quantity" type="number" t-att-value="state.quantityToMake" t-on-change="onQuantityChange" />
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => onIncreaseQuantity()">➕</button>
                                </div>
                            </div>
                            <t t-if="state.split" t-set="hasCopyButtons" t-value="true">
                                <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-sm btn-outline-primary" t-on-click="copyLeftToRight">⬅️ Copy Left → Right</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="copyRightToLeft">➡️ Copy Right → Left</button>
                                <t t-if="state.undoCache.left or state.undoCache.right">
                                    <button class="btn btn-sm btn-outline-warning" t-on-click="_restoreUndoCache">↩️ Undo Last Split</button>
                                </t>
                                </div>
                            </t>
                        </t>
                    </div>
                    <!-- 🔸 Attributes Group -->
                    <div class="config-section mb-4">
                        <t t-foreach="state.ptalIds" t-as="i" t-key="i.id">
                            <t t-if="state.laterality === 'bilateral' and state.split">
                                <div class="row fw-bold text-center mb-1 bg-light border-bottom py-1">
                                    <div class="col-4">
                                        <strong t-esc="i.name"/>
                                    </div>
                                    <div class="col text-muted">
                                        <small>
                                            <strong>Left</strong>
                                        </small>
                                    </div>
                                    <div class="col text-muted">
                                        <small>
                                            <strong>Right</strong>
                                        </small>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-4"/>
                                    <div class="col">
                                        <ProductTmplAttrib id="'ptav_%s_left' % i.id" attribute="i" selected="state.selected.left || {}" side="'left'" hideLabel="true" onSelect="(ev) => this._addOrUpdateSelected('left', i.id, ev.target.value)" onCustom="(ptavId, ev) => this._addOrUpdateSelected('left', i.id, ptavId, ev.target.value)" />
                                    </div>
                                    <div class="col">
                                        <ProductTmplAttrib id="'ptav_%s_right' % i.id" attribute="i" selected="state.selected.right || {}" side="'right'" hideLabel="true" onSelect="(ev) => this._addOrUpdateSelected('right', i.id, ev.target.value)" onCustom="(ptavId, ev) => this._addOrUpdateSelected('right', i.id, ptavId, ev.target.value)" />
                                    </div>
                                </div>
                            </t>
                            <t t-if="!(state.laterality === 'bilateral' and state.split)">
                                <div class="mb-3">
                                    <strong t-esc="i.name"/>
                                    <ProductTmplAttrib id="'ptav_%s_shared' % i.id" attribute="i" selected="state.selected" side="'shared'" hideLabel="true" onSelect="(ev) => this._handleSharedSelect(i.id, ev)" onCustom="(ptavId, ev) => this._addOrUpdateSelected(i.id, null, ptavId, ev.target.value)" />
                                </div>
                            </t>
                        </t>
                    </div>


