                </div>
                <div class="col-md-4 border-start ps-3">
                    <div class="sticky-summary shadow-sm p-2 bg-white rounded">
                        <t t-set="summaryKeyVal" t-value="summaryKey()" />
                        <SummaryPanel 
                        ptalIds="state.ptalIds" 
                        selected="state.selected" 
                        laterality="state.laterality" 
                        split="state.split" 
                        productTemplate="state.productTemplate"
                        quantityToMake="state.quantityToMake" 
                        matrixPriceTotal="state.matrixPriceTotal"
                        matrixOverrideActive="state.matrixOverrideActive"
                        register="registerSummaryPanel" 
                        t-key="summaryKeyVal"/>
                    </div>
                </div>
                <t t-if="isInitializing">
                    <div class="d-flex justify-content-center align-items-center p-3">
                        <i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
                        <span class="ms-2">Loading configuration...</span>
                    </div>
                </t>
                <t t-if="state.isLoading">
                    <div class="position-fixed top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-flex align-items-center justify-content-center">
                        <div>
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <div class="text-center mt-2">Saving configuration...</div>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button t-if="canCreate()" class="btn btn-primary" t-on-click="onCreate" t-att-disabled="isDisabled">
                    <t t-if="state.isLoading">Saving...</t>
                    <t t-else="">Confirm</t>
                </button>
                <button class="btn btn-secondary" t-on-click="onClose" t-att-disabled="isDisabled">Cancel</button>
                <t t-set="resetButtonDisabled" t-value="state.isLoading || !initialState"/>
                <button class="btn btn-secondary" t-att-title="'Reset this configuration back to its original state.'" t-on-click="resetToDefaults" t-att-disabled="resetButtonDisabled">
                    <t t-if="state.isLoading">Resetting...</t>
                    <t t-else="">Reset</t>
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="cpq.ConfiguratorSummaryPanel" owl="1">
        <div class="config-summary-panel overflow-auto" style="max-height: 60vh;">
            <div t-if="state.toastMessage" class="cpq-toast-message">
                <span t-esc="state.toastMessage"/>
            </div>
            <div class="text-center mb-2">
                <t t-if="productTemplate and productTemplate.display_name">
                    <h6 class="fw-bold mb-0" style="white-space: pre-line;" t-out="productTemplate.display_name" />
                </t>
            </div>
            <div class="text-center mb-3">
                <img t-if="productTemplate?.id" t-att-src="'/web/image/product.template/' + productTemplate.id + '/image_128'" class="img-fluid rounded shadow-sm" style="max-width: 80%;" />
            </div>
            <h5 class="mb-3 d-flex justify-content-between align-items-center">
                Configuration Summary
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="printSummary" title="Print this configuration for customer quote.">
                        🖨️ Print
                    </button>
                    <button class="btn btn-link btn-sm p-0" t-on-click="toggleExpand">
                        <t t-esc="state.expanded ? '▲ Collapse' : '▼ Expand'" />
                    </button>
                </div>
            </h5>
            <t t-if="props.laterality === 'bilateral' and props.split">
                <div class="summary-table-wrapper" t-ref="summaryWrapper" t-att-style="'height: ' + state.height + 'px; overflow: hidden; transition: height 0.4s ease;'">
                    <table class="table table-sm table-bordered align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Attribute</th>
                                <th>Left</th>
                                <th>Right</th>
                                <th>Match</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.summary" t-as="s" t-key="s.key">
                                <tr>
                                    <td class="text-start fw-bold" t-esc="s.label" />
                                    <td>
                                        <span t-esc="s.left ?? '-'"/>
                                    </td>
                                    <td>
                                        <span t-esc="s.right ?? '-'"/>
                                    </td>
                                    <td>
                                        <t t-if="s.left === s.right and s.left !== '-'">
                                            <span class="badge bg-success">✅</span>
                                        </t>
                                        <t t-elif="s.left || s.right">
                                            <span class="badge bg-danger">❌</span>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted">—</span>
                                        </t>
                                    </td>
                                    <td>
                                        <span t-esc="(s.priceExtra ?? 0).toFixed(2)" />$</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-if="!(props.laterality === 'bilateral' and props.split)">
                <div class="summary-table-wrapper" t-ref="summaryWrapper" t-att-style="'height: ' + state.height + 'px; overflow: hidden; transition: height 0.4s ease;'">
                    <table class="table table-sm table-bordered align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Attribute</th>
                                <th>Value</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.summary" t-as="s" t-key="s.key">
                                <tr>
                                    <td class="text-start fw-bold" t-esc="s.label" />
                                    <td>
                                        <span t-esc="s.shared || '-'"/>
                                    </td>
                                    <td>
                                        <span t-esc="s.priceExtra.toFixed(2)" />$</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <div class="mt-3 border-top pt-2">
                <h6 class="fw-bold d-flex justify-content-between align-items-center">Pricing Summary
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleExtras">
                        <t t-esc="state.showExtras ? '− Hide Details' : '+ Show Details'" />
                    </button>
                </h6>
                <ul class="list-group mt-3">
                    <t t-if="state.priceSummary.base > 0">
                        <li class="list-group-item d-flex justify-content-between">
                            💵 Base Price:
                            <span class="fw-semibold" t-esc="formatCurrency(state.priceSummary.base)"/>
                        </li>
                    </t>
                    <t t-if="state.priceSummary.extrasSubtotal > 0">
                        <li class="list-group-item d-flex justify-content-between">
                            🧮 Subtotal (Extras Only):
                            <span class="fw-semibold" t-esc="formatCurrency(state.priceSummary.extrasSubtotal)"/>
                        </li>
                    </t>
                    <li class="list-group-item d-flex justify-content-between">
                        📊 Total x <t t-esc="props.quantityToMake"/>:
                        <span class="fw-bold" t-esc="formatCurrency(state.priceSummary.total)"/>
                    </li>
                    <t t-if="props.matrixOverrideActive">
                        <li class="list-group-item text-center bg-warning-subtle text-dark">
                            ⚡ Price overridden by matrix
                        </li>
                    </t>
                </ul>
            </div>
            <div class="text-end mt-2">
                <a href="#" class="small text-decoration-none" t-on-click.prevent="toggleExpand">
                    <t t-esc="state.expanded ? '▲ Show Less' : '▼ Show More'" />
                </a>
            </div>
        </div>
    </t>

