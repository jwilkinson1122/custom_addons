    <t t-name="cpq.PrintPreviewPanel">
        <div class="rx-preview p-4 border rounded bg-white text-dark" t-att-class="printOnly ? 'print-mode' : ''">
            <h2 class="fw-bold mb-3 text-center">Custom Orthotic Rx</h2>

            <div class="row mb-4">
                <div class="col">
                    <strong>Patient Name:</strong> <t t-esc="patientName || '________________'"/>
                </div>
                <div class="col">
                    <strong>Date:</strong> <t t-esc="orderDate || '__________'"/>
                </div>
            </div>

            <div class="mb-3">
                <strong>Laterality:</strong>
                <ul class="list-unstyled mb-0">
                    <li><t t-if="laterality === 'left'">✅</t> Left Only</li>
                    <li><t t-if="laterality === 'right'">✅</t> Right Only</li>
                    <li><t t-if="laterality === 'bilateral'">✅</t> Bilateral</li>
                </ul>
            </div>

            <!-- Quantity -->
            <div class="mb-3">
                <strong>Pairs to Make:</strong> <t t-esc="quantity || 1"/>
            </div>

            <!-- Selections by Attribute -->
            <t t-foreach="summary" t-as="row">
                <div class="mb-2">
                    <strong><t t-esc="row.attribute"/>:</strong>
                    <span><t t-esc="row.left === row.right ? row.left : ''"/></span>
                    <t t-if="split and row.left !== row.right">
                        <div class="ms-3">
                            <div>👈 Left: <t t-esc="row.left || '-'"/></div>
                            <div>👉 Right: <t t-esc="row.right || '-'"/></div>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Price Summary (Optional) -->
            <t t-if="priceSummary">
                <hr/>
                <div>
                    <strong>💵 Left Total:</strong> $<t t-esc="priceSummary.left.toFixed(2)"/>
                </div>
                <div>
                    <strong>💵 Right Total:</strong> $<t t-esc="priceSummary.right.toFixed(2)"/>
                </div>
                <div class="fw-bold">
                    <strong>📊 Combined Total:</strong> $<t t-esc="priceSummary.total.toFixed(2)"/>
                </div>
            </t>
        </div>
    </t>

</templates>
