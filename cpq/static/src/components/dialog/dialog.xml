<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="cpq.ConfigureDialogDialog" owl="1">
        <Dialog size="size" title="title">
            <div class="row position-relative">
                <div class="col">
                    <!-- ⚠️ Error Display -->
                    <div t-if="!state.valid &amp;&amp; Object.keys(state.errors).length &gt; 0" class="alert alert-warning" role="alert">
                        <ul t-foreach="Object.entries(state.errors)" t-as="e" t-key="e[0]" class="list-unstyled mb-0">
                            <li t-esc="e[1]" />
                        </ul>
                    </div>
                    <!-- 📄 Product Description -->
                    <div t-if="state.productTmplId.description_sale" t-esc="state.productTmplId.description_sale" class="mb-3" />
                    <!-- 👣 Laterality -->
                    <div class="mb-3">
                        <strong>Laterality:</strong>
                        <br/>
                        <div class="form-check form-check-inline">
                            <input type="radio" name="laterality" class="form-check-input" value="left" t-att-checked="state.laterality === 'left' ? 'checked' : undefined" t-on-change="onLateralityChange"/>
                            <label class="form-check-label">Left Only</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input type="radio" name="laterality" class="form-check-input" value="right" t-att-checked="state.laterality === 'right' ? 'checked' : undefined" t-on-change="onLateralityChange"/>
                            <label class="form-check-label">Right Only</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input type="radio" name="laterality" class="form-check-input" value="bilateral" t-att-checked="state.laterality === 'bilateral' ? 'checked' : undefined" t-on-change="onLateralityChange"/>
                            <label class="form-check-label">Bilateral</label>
                        </div>
                    </div>

                    <!-- 🛠️ Split Toggle and Controls -->
                    <t t-if="state.laterality === 'bilateral'" class="mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <input type="checkbox" t-att-checked="state.split ? 'checked' : undefined" t-on-click="onSplitToggle"/>
                            <label>Customize Left / Right Separately</label>
                            <t t-if="state.split">
                                <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="copyLeftToRight">
                                    ⬅️ Copy Left → Right
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="copyRightToLeft">
                                    ➡️ Copy Right → Left
                                </button>
                                <t t-if="state.undoCache.left or state.undoCache.right">
                                    <button type="button" class="btn btn-sm btn-outline-warning" t-on-click="_restoreUndoCache">
                                        ↩️ Undo Last Split
                                    </button>
                                </t>
                            </t>
                        </div>
                    </t>
                    <!-- 🔢 Quantity Input -->
                    <div class="mb-3">
                        <label class="form-label">
                            <t t-esc="state.laterality === 'bilateral' ? 'Pairs to Make:' : 'Quantity to Make:'"/>
                        </label>
                        <input type="number" class="form-control" t-att-value="state.quantityToMake" t-on-input="onQuantityChange" min="1"/>
                    </div>
                    <!-- 🧩 Attribute Configuration -->
                    <t t-foreach="state.ptalIds" t-as="i" t-key="i.id">
                        <t t-if="state.laterality === 'bilateral' and state.split">
                            <div class="row fw-bold text-center mb-1 bg-light border-bottom py-1">
                                <div class="col-4">
                                    <strong t-esc="i.name"/>
                                </div>
                                <div class="col text-muted">
                                    <small>
                                        <strong>Left</strong>
                                    </small>
                                </div>
                                <div class="col text-muted">
                                    <small>
                                        <strong>Right</strong>
                                    </small>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-4"/>
                                <div class="col">
                                    <ProductTmplAttrib id="'ptav_%s_left' % i.id" attribute="i" selected="state.selected.left || {}" side="'left'" hideLabel="true" onSelect="(ev) => this._addOrUpdateSelected('left', i.id, ev.target.value)" onCustom="(ptavId, ev) => this._addOrUpdateSelected('left', i.id, ptavId, ev.target.value)" />
                                </div>
                                <div class="col">
                                    <ProductTmplAttrib id="'ptav_%s_right' % i.id" attribute="i" selected="state.selected.right || {}" side="'right'" hideLabel="true" onSelect="(ev) => this._addOrUpdateSelected('right', i.id, ev.target.value)" onCustom="(ptavId, ev) => this._addOrUpdateSelected('right', i.id, ptavId, ev.target.value)" />
                                </div>
                            </div>
                        </t>
                        <t t-if="!(state.laterality === 'bilateral' and state.split)">
                            <div class="mb-3">
                                <strong t-esc="i.name"/>
                                <ProductTmplAttrib id="'ptav_%s_shared' % i.id" attribute="i" selected="state.selected" side="'shared'" hideLabel="true" onSelect="(ev) => this._handleSharedSelect(i.id, ev)" onCustom="(ptavId, ev) => this._addOrUpdateSelected(i.id, null, ptavId, ev.target.value)" />
                            </div>
                        </t>
                    </t>
                </div>
                <div class="col-md-4 border-start ps-3">
                    <div class="sticky-summary shadow-sm p-2 bg-white rounded">
                        <SummaryPanel ptalIds="state.ptalIds" selected="state.selected" laterality="state.laterality" split="state.split" productTmplId="state.productTmplId" quantityToMake="state.quantityToMake" register="registerSummaryPanel" t-key="summaryKey()" />
                    </div>
                </div>
                <!-- ✅ Loading Overlay -->
                <t t-if="isInitializing">
                    <div class="d-flex justify-content-center align-items-center p-3">
                        <i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
                        <span class="ms-2">Loading configuration...</span>
                    </div>
                </t>

                <t t-if="state.isLoading">
                    <div class="position-fixed top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-flex align-items-center justify-content-center">
                        <div>
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <div class="text-center mt-2">Saving configuration...</div>
                        </div>
                    </div>
                </t>

            </div>

            <!-- ✅ Footer -->
            <t t-set-slot="footer">
                <!-- <button t-on-click="onCreate" t-att-disabled="state.isLoading">Save</button> -->

                <button t-if="canCreate()" class="btn btn-primary" t-on-click="onCreate" t-att-disabled="isDisabled">Confirm</button>
                <button class="btn btn-secondary" t-on-click="onClose" t-att-disabled="isDisabled">Cancel</button>
                <t t-set="resetButtonDisabled" t-value="state.isLoading || !initialState"/>
                <button class="btn btn-secondary" t-att-title="'Reset this configuration back to its original state.'" t-on-click="resetToDefaults" t-att-disabled="resetButtonDisabled">
                    <t t-if="state.isLoading">Resetting...</t>
                    <t t-else="">Reset</t>
                </button>
            </t>

        </Dialog>
    </t>

    <t t-name="cpq.ConfiguratorSummaryPanel" owl="1">
        <div class="config-summary-panel overflow-auto" style="max-height: 60vh;">
            <div t-if="state.toastMessage" class="cpq-toast-message">
                <span t-esc="state.toastMessage"/>
            </div>
            <!-- 🏷️ Product Name -->
            <div class="text-center mb-2">
                <h6 class="fw-bold mb-0" t-esc="props.productTmplId.display_name" />
            </div>
            <!-- 🖼️ Product Image -->
            <div class="text-center mb-3">
                <img t-if="props.productTmplId.product_variant_id" t-att-src="'/web/image/product.product/' + props.productTmplId.product_variant_id.id + '/image_128'" class="img-fluid rounded shadow-sm" style="max-width: 80%;" />
                <img t-else="" t-att-src="'/web/image/product.template/' + props.productTmplId.id + '/image_128'" class="img-fluid rounded shadow-sm" style="max-width: 80%;" />
            </div>
            <!-- 📝 Summary Header with Actions -->
            <h5 class="mb-3 d-flex justify-content-between align-items-center">
                Configuration Summary
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="printSummary">
                        🖨️ Print
                    </button>
                    <button class="btn btn-link btn-sm p-0" t-on-click="toggleExpand">
                        <t t-esc="state.expanded ? '▲ Collapse' : '▼ Expand'" />
                    </button>
                </div>
            </h5>
            <!-- 🚩 Bilateral Split Table -->
            <t t-if="props.laterality === 'bilateral' and props.split">
                <div class="summary-table-wrapper" t-ref="summaryWrapper" t-att-style="'height: ' + state.height + 'px; overflow: hidden; transition: height 0.4s ease;'">
                    <table class="table table-sm table-bordered align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Attribute</th>
                                <th>Left</th>
                                <th>Right</th>
                                <th>Match</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.summary" t-as="s" t-key="s.key">
                                <tr>
                                    <td class="text-start fw-bold" t-esc="s.label" />
                                    <td>
                                        <span t-esc="s.left ?? '-'"/>
                                    </td>
                                    <td>
                                        <span t-esc="s.right ?? '-'"/>
                                    </td>
                                    <td>
                                        <t t-if="s.left === s.right and s.left !== '-'">
                                            <span class="badge bg-success">✅</span>
                                        </t>
                                        <t t-elif="s.left || s.right">
                                            <span class="badge bg-danger">❌</span>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted">—</span>
                                        </t>
                                    </td>
                                    <td>
                                        <span t-esc="(s.priceExtra ?? 0).toFixed(2)" />
$</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <!-- 🌐 Shared View Table -->
            <t t-if="!(props.laterality === 'bilateral' and props.split)">
                <div class="summary-table-wrapper" t-ref="summaryWrapper" t-att-style="'height: ' + state.height + 'px; overflow: hidden; transition: height 0.4s ease;'">
                    <table class="table table-sm table-bordered align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Attribute</th>
                                <th>Value</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.summary" t-as="s" t-key="s.key">
                                <tr>
                                    <td class="text-start fw-bold" t-esc="s.label" />
                                    <td>
                                        <span t-esc="s.shared || '-'"/>
                                    </td>
                                    <td>
                                        <span t-esc="s.priceExtra.toFixed(2)" />
$</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <!-- 💰 Pricing Summary -->
            <div class="mt-3 border-top pt-2">
                <h6 class="fw-bold d-flex justify-content-between align-items-center">Pricing Summary
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleExtras">
                        <t t-esc="state.showExtras ? '− Hide Details' : '+ Show Details'" />
                    </button>
                </h6>
                <!-- 💵 Pricing Summary -->
                <ul class="list-group mt-3">
                    <!-- Base Price -->
                    <t t-if="state.priceSummary.base > 0">
                        <li class="list-group-item d-flex justify-content-between">
                            💵 Base Price:
                            <span class="fw-semibold" t-esc="formatCurrency(state.priceSummary.base)"/>
                        </li>
                    </t>
                    <!-- Extras Subtotal -->
                    <t t-if="state.priceSummary.extrasSubtotal > 0">
                        <li class="list-group-item d-flex justify-content-between">
                            🧮 Subtotal (Extras Only):
                            <span class="fw-semibold" t-esc="formatCurrency(state.priceSummary.extrasSubtotal)"/>
                        </li>
                    </t>
                    <!-- Final Total -->
                    <li class="list-group-item d-flex justify-content-between">
                        📊 Total x <t t-esc="props.quantityToMake"/>
:
                    <span class="fw-bold" t-esc="formatCurrency(state.priceSummary.total)"/>
                </li>
            </ul>
        </div>
        <!-- 🔽 Expand/Collapse Link -->
        <div class="text-end mt-2">
            <a href="#" class="small text-decoration-none" t-on-click.prevent="toggleExpand">
                <t t-esc="state.expanded ? '▲ Show Less' : '▼ Show More'" />
            </a>
        </div>
    </div>
</t>
</templates>
