<odoo>
    <record id="view_res_config_settings_cpq" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cpq</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='product_setting_container']" position="inside">
                <setting id="cpq_product_settings" string="Prefix for CPQ Product Codes" help="Set the prefix for CPQ product codes. This will be used to generate unique product codes for CPQ products. The default is 'CPQ-'.">
                    <field name="cpq_code_prefix" placeholder="CPQ-"/>
                    <field name="cpq_code_preview" readonly="1" nolabel="1" class="text-muted"/>
                    <div class="alert alert-warning o_cpq_code_prefix_warning" style="margin-top: 8px;">
                            ⚠️ Changing the prefix only affects **new** CPQ products. Existing products will retain their current references.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>


