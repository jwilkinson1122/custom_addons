<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_config_setting_view" model="ir.ui.view">
        <field name="name">partner.config.setting.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="before">
                <div id="customer_sequence_settings">
                    <h2>Auto Create Customer Sequence Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="auto_create" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="auto_create" />
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="auto_create_contact" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="auto_create_contact" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
