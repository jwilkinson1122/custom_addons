<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Show always parent_id plus add affiliates -->
    <record id="inherit_view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field eval="1" name="priority" />
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_type']" position="after">
                <field name="is_patient" invisible="1"/>
            </xpath>
            <xpath expr="/form/sheet//div[hasclass('o_row')]/field[@name='parent_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr='//page[@name="contact_addresses"]' position="before">
                <page string="Affiliates" invisible="not is_company" autofocus="autofocus">
                    <div id="o_work_partner_container" class="row col-lg-12">  
                        <div id="o_work_partner_main" class="col-8">
                        </div>
                        <div id="o_partner_right" class="col-4">
                            <separator string="Affiliates Hierarchy" />
                            <field name="affiliate_ids" class="" widget="partner_org_chart" readonly="1" nolabel="1" />
                        </div>
                    </div>
                    <!-- <field name="affiliate_ids" domain="[('is_company', '=', True), ('parent_id', '=', id)]" mode="kanban"/>
                    <field name="affiliate_ids" domain="[('is_company', '=', True), ('parent_id.parent_id', '=', id)]" mode="kanban" string="Indirect Affiliates"/> -->

                    <field name="affiliate_ids" domain="[('is_company', '=', True), ('parent_id', '=', id)]" mode="kanban"/>  <!-- Direct Affiliates -->
                    <field name="affiliate_ids" domain="[('is_company', '=', True), ('parent_id.parent_id', '=', id)]" mode="kanban" string="Indirect Affiliates"/> <!-- Indirect Affiliates -->

                    <!-- <separator string="Indirect Affiliates" /> -->
                 
                </page>
            </xpath>
            <xpath expr='//page[@name="contact_addresses"]' position="after">
                <page string="Patients" invisible="is_patient">
                    <group>
                        <separator string="Direct Patients" />
                        <field name="patient_ids" widget="kanban" domain="[('responsible_contact_id', '=', id)]"/>
                        <separator string="Indirect Patients" />
                        <field name="patient_ids" widget="kanban" domain="[('responsible_contact_id.parent_id', '=', id)]" string="Indirect Patients"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="autofocus"></attribute>
                <attribute name="string">Contacts</attribute>
            </xpath>
        </field>
    </record>

    <record id="partner_org_chart_inherit_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_affiliate.inherit_view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='o_work_partner_main']" position="inside">
                <xpath expr="//field[@name='affiliate_ids'][@mode='kanban']" position="move" />
            </xpath>
        </field>
    </record>

    <record id="inherit_base_view_partner_form" model="ir.ui.view">
		<field name="name">res.partner.form</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="base.view_partner_form" />
		<field name="arch" type="xml">
            <xpath expr="//field[@name='child_ids']" position="attributes">
                <attribute name="domain">[('is_company', '=', False), ('parent_id', '=', id)]</attribute>
                <attribute name="mode">kanban</attribute>
            </xpath>
			<xpath expr="//field[@name='child_ids']" position="before">
				<div id="o_work_partner_container" class="row col-lg-12">  
					<div id="o_work_partner_main" class="col-8">
					</div>
					<div id="o_partner_right" class="col-4">
						<separator string="Contacts Hierarchy" />
						<field name="child_ids" class="" widget="partner_org_chart" readonly="1" nolabel="1" />
					</div>
				</div>
			</xpath>
            <xpath expr="//field[@name='child_ids']" position="after">
                <field name="child_ids" domain="[('is_company', '=', False), ('parent_id.parent_id', '=', id)]" mode="kanban" string="Indirect Contacts"/>
            </xpath>
		</field>
	</record>

    <record id="partner_org_chart_inherit_base_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_affiliate.inherit_base_view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='o_work_partner_main']" position="inside">
                <xpath expr="//field[@name='child_ids'][@mode='kanban']" position="move" />
            </xpath>
        </field>
    </record>

    <!-- Companies (Only Parent Companies) -->
    <record id="action_companies" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('is_company', '=', True), ('parent_id', '=', False)]</field> <!-- Ensure parent_id is False -->
        <field name="context">{'default_company_type':'company'}</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

