<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_podiatry_laterality_wizard_form" model="ir.ui.view">
        <field name="name">podiatry.laterality.wizard.form</field>
        <field name="model">podiatry.laterality.wizard</field>
        <field name="arch" type="xml">
            <form string="Laterality Product Selection">
                <group>
                    <field name="laterality"/>
                    <field name="category_id"/>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Add Products" type="object" name="add_products_to_matrix" class="btn-primary"/>
                    <button string="Cancel" type="object" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
