                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="partner_company_action" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_company', '=', True), ('id', '!=', 1)]</field>
        <field name="context">{
            'default_company_type':'company',
            'default_is_company':True,
            'default_type': '',
            }</field>
        <field name="search_view_id" ref="res_partner_search_view" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new company
            </p>
            <p>
                An Company is the parent entity of affiliates and establishes the hierarchical relationship.
            </p>
        </field>
    </record>

    <record id="partner_affiliate_action" model="ir.actions.act_window">
        <field name="name">Affiliates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_company', '=', True), ('is_affiliate_company', '=', True), ('id', '!=', 1)]</field>
        <field name="context">{
            'default_company_type':'company',
            'default_is_company':True,
            'default_is_affiliate_company': True,
            'default_type':'',
            }</field>
        <field name="search_view_id" ref="res_partner_search_view" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new account affiliate
            </p>
            <p>A Affiliate gives details and position information for a physical place where services are provided and resources and participants may be stored, found, contained or accommodated.</p>
        </field>
    </record>

    <record id="partner_contact_action" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_contact', '=', True)]</field>
        <field name="context">{
            'default_company_type':'person',
            'default_is_contact': True,
            'default_type':'contact',
            }</field>
        <field name="search_view_id" ref="res_partner_search_view" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Add a new customer company contact
            </p>
            <p>Contact covers all individuals who are engaged in the healthcare process and healthcare-related services as part of their formal responsibilities.</p>
        </field>
    </record>

    <record id="partner_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{
            'default_company_type':'person',
            'default_is_patient': True,
            'default_type':'patient',
            }</field>
        <field name="search_view_id" ref="res_partner_search_view" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new company patient in your address book
            </p>
            <p>A Patient is a person receiving or registered to receive medical treatment.</p>
        </field>
    </record>

    <!-- Sales partner menu -->
    <menuitem id="sale_partners_menu" name="Customers" parent="sale.sale_menu_root" sequence="0">
        <menuitem id="sale.res_partner_menu" name="Companies" action="partner_company_action" sequence="1"/>
        <menuitem id="sale_partner_affiliates_menu" name="Affiliates" action="partner_affiliate_action" sequence="2" />
        <menuitem id="sale_partner_contacts_menu" name="Contacts" action="partner_contact_action" sequence="3" />
        <menuitem id="sale_partner_patients_menu" name="Patients" action="partner_patient_action" sequence="4" />
    </menuitem>

    <!-- Define root menu for contacts -->
    <menuitem id="contacts.menu_contacts" name="Customers" web_icon="contacts,static/description/icon.png" groups="base.group_user,base.group_partner_manager" sequence="20"/>
    <menuitem id="partner_companies_menu" name="Companies" parent="contacts.menu_contacts" action="partner_company_action" sequence="1" />
    <menuitem id="partner_affiliates_menu" name="Affiliates" parent="contacts.menu_contacts" action="partner_affiliate_action" sequence="2"/>
    <menuitem id="contacts.res_partner_menu_contacts" name="Contacts" parent="contacts.menu_contacts" action="partner_contact_action" sequence="3"/>
    <menuitem id="partner_patients_menu" name="Patients" parent="contacts.menu_contacts" action="partner_patient_action" sequence="4"/>
    <menuitem id="contacts.res_partner_menu_config" name="Configuration" parent="contacts.menu_contacts" groups="base.group_system" sequence="10"/>

</odoo>
