<odoo>
    <record id="product_template_form_view_inherit_section" model="ir.ui.view">
        <field name="name">product.template.form.inherit.section</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="section_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_product_section_configuration" model="ir.actions.act_window">
        <field name="name">Product Section Configuration</field>
        <field name="res_model">product.section.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_product_section_configuration" name="Product Section Configuration" parent="sale.prod_config_main" sequence="0" action="action_product_section_configuration"/>

    <record id="view_product_section_configuration_tree" model="ir.ui.view">
        <field name="name">product.section.configuration.tree</field>
        <field name="model">product.section.configuration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="section_id"/>
                <field name="section_name"/>
                <field name="description"/>
                <field name="product_category_id"/>
                <field name="is_required"/>
            </tree>
        </field>
    </record>

    <record id="view_product_section_configuration_form" model="ir.ui.view">
        <field name="name">product.section.configuration.form</field>
        <field name="model">product.section.configuration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="section_id"/>
                        <field name="section_name"/>
                        <field name="description"/>
                        <field name="product_category_id"/>
                        <field name="is_required"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_order_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.wizard.form</field>
        <field name="model">sale.order.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="sale_order_id" readonly="1"/>
                </group>
                <notebook>
                    <page string="Sections">
                        <field name="section_selection_ids" widget="grouped_list" context="{'group_by': 'section_name'}">
                            <tree editable="bottom">
                                <field name="section_name" string="Section" optional="show"/>
                                <field name="section_product_ids" column_invisible="True"/>
                                <field name="product_id" domain="[('product_tmpl_id', 'in', section_product_ids)]"/>
                                <field name="available_attribute_ids" column_invisible="True"/>
                                <field name="attribute_ids" widget="many2many_tags"/>
                                <field name="price" readonly="1"/>
                                <field name="quantity"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <div class="footer-buttons">
                        <button name="clear_all" string="Clear All" type="object" class="btn-danger"/>
                        <button name="submit_wizard" string="Submit" type="object" class="btn-success"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </div>
                    <div class="footer-right">
                        <field name="total_price" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </div>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_sale_order_wizard" model="ir.actions.act_window">
        <field name="name">Configure Sales Order</field>
        <field name="res_model">sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_sale_order_id': active_id if active_model == 'sale.order' else False,
            'form_view_initial_mode': 'edit'
        }</field>
    </record>

    <record id="view_order_form_with_wizard" model="ir.ui.view">
        <field name="name">sale.order.form.wizard.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <button name="%(action_open_sale_order_wizard)d" type="action" string="Rx Wizard" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
