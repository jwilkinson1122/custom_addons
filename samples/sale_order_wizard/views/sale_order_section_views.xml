<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_section_tree" model="ir.ui.view">
        <field name="name">sale.order.section.tree</field>
        <field name="model">sale.order.section</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="section_name"/>
                <field name="description"/>
                <field name="product_category_id"/>
                <field name="is_required"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_order_section_form" model="ir.ui.view">
        <field name="name">sale.order.section.form</field>
        <field name="model">sale.order.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="section_name"/>
                        <field name="description"/>
                        <field name="product_category_id"/>
                        <field name="is_required"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_order_section" model="ir.actions.act_window">
        <field name="name">Sale Order Sections</field>
        <field name="res_model">sale.order.section</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sale_order_section" name="Sale Order Sections" parent="sale.prod_config_main" sequence="0" action="action_sale_order_section"/>
</odoo>
