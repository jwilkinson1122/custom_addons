<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="inherit_base_view_partner_form" model="ir.ui.view">
		<field name="name">res.partner.form</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="base.view_partner_form" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='affiliate_ids']" position="before">
				<div id="o_work_partner_container" class="row col-lg-12"> <!-- These two div are used to position org_chart -->
					<div id="o_work_partner_main" class="col-8">
					</div>
					<div id="o_partner_right" class="col-4">
						<separator string="Organization Chart" />
						<field name="affiliate_ids" class="" widget="partner_org_chart"
							readonly="1" nolabel="1" />
					</div>
				</div>
			</xpath>
		</field>
	</record>

	<record id="partner_org_chart_inherit_base_view_partner_form"
		model="ir.ui.view">
		<field name="name">res.partner</field>
		<field name="model">res.partner</field>
		<field name="inherit_id"
			ref="partner_org_chart.inherit_base_view_partner_form" />
		<field name="arch" type="xml">
			<xpath expr="//div[@id='o_work_partner_main']" position="inside">
				<xpath expr="//field[@name='affiliate_ids'][@mode='kanban']"
					position="move" />
			</xpath>
		</field>
	</record>

</odoo>