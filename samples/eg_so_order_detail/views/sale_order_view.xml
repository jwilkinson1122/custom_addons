<odoo>

    <record id="sale_order_detail_tree_view" model="ir.ui.view">
        <field name="name">sale.order.detail.tree.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
            <field name="order_detail"/>
            </xpath>
        </field>
    </record>


    <record id="sale_orders_detail_tree_view" model="ir.ui.view">
        <field name="name">sale.orders.detail.tree.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="order_detail"/>
            </xpath>
        </field>
    </record>
</odoo>