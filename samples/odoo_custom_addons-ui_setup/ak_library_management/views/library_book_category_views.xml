<?xml version="1.0"?>
<odoo>
    <data>
	    <!--book category form view-->
        <record model="ir.ui.view" id="view_library_book_category_form">
            <field name="name">Library Book Category</field>
            <field name="model">library.book.category</field>
            <field name="arch" type="xml">
                <form string="Books Category">
                    <sheet>
                        <group>
                            <field name="name" required="True"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
	    <!--book category list view-->
        <record model="ir.ui.view" id="view_library_book_category_tree">
            <field name="name">Library Book Category List</field>
            <field name="model">library.book.category</field>
            <field name="arch" type="xml">
                <list string="Books Category">
                    <field name="name"/>
                </list>
            </field>
        </record>
	    <!--action -->
        <record model="ir.actions.act_window" id="action_library_book_category">
                <field name="name">Book Category</field>
                <field name="res_model">library.book.category</field>
        </record>
	    <!--config menu and category menu-->
        <menuitem id="menu_configuration" name="Configuration" parent="menu_library" sequence='8'/>
        <menuitem
            name="Book Category"
            id="menu_library_book_category"
            action="action_library_book_category"
            parent="menu_configuration"
            sequence='9'/>
    </data>
</odoo>


