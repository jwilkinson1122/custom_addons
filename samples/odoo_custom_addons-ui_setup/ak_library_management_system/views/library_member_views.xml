<?xml version="1.0"?>
<odoo>
    <data>
        <!--member form view-->
        <record model="ir.ui.view" id="view_library_member_form">
            <field name="name">Library Member</field>
            <field name="model">library.member</field>
            <field name="arch" type="xml">
                <form string="Member">
                    <sheet>
                        <group>
                            <field name="name" required="True"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="membership_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!--member list view-->
        <record model="ir.ui.view" id="view_library_member_tree">
            <field name="name">Library Member List</field>
            <field name="model">library.member</field>
            <field name="arch" type="xml">
                <list string="Member">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                </list>
            </field>
        </record>
        <!--action-->
        <record model="ir.actions.act_window" id="action_library_member">
                <field name="name">Library Member</field>
                <field name="res_model">library.member</field>
        </record>
        <!--member menu-->
        <menuitem
            name="Member"
            id="menu_member_library"
            action="action_library_member"
            parent="menu_library"
            sequence='6'/>
    </data>
</odoo>
