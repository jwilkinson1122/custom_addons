<odoo>
    <record id="kw_matrix_widget_demo_list" model="ir.ui.view">
        <field name="name">kw_matrix_widget_demo list</field>
        <field name="model">kw.matrix.widget.demo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="kw_view_event_catalog_form" model="ir.ui.view">
        <field name="name">kw.matrix.widget.demo.form</field>
        <field name="model">kw.matrix.widget.demo</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <field name="matrix_data" widget="kw_matrix_widget"/>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window"
            id="kw_matrix_widget_demo_action_window">
        <field name="name">Matrix widget demo</field>
        <field name="res_model">kw.matrix.widget.demo</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Matrix widget demo" id="kw_matrix_widget_demo_menu_1_list"
              action="kw_matrix_widget_demo_action_window"/>
</odoo>
