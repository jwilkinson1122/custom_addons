<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="prescription_floor_view_tree" model="ir.ui.view">
        <field name="name">prescription.floor.view.tree</field>
        <field name="model">prescription.floor</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>
    <!--    floor menu action-->
    <record id="prescription_floor_action" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">prescription.floor</field>
        <field name="view_mode">tree</field>
    </record>

    <!--    Floor Menu-->
    <menuitem id="prescription_floor_menu" name="Floors" action="prescription_floor_action" parent="prescription_config_menu" sequence="50"/>
</odoo>