<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="prescription_service_view_tree" model="ir.ui.view">
            <field name="name">prescription.service.view.tree</field>
            <field name="model">prescription.service</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="unit_price"/>
                    <field name="taxes_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="prescription_service_action" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="res_model">prescription.service</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem id="prescription_service_menu" name="Services" action="prescription_service_action" parent="prescription_config_menu" sequence="40"/>
    </data>
</odoo>