<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="prescription_room_view_tree" model="ir.ui.view">
            <field name="name">prescription.room.view.tree</field>
            <field name="model">prescription.room</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="room_type"/>
                    <!--                    <field name="floor_id"/>-->
                    <field name="list_price"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>
        <!--prescription room view id-->
        <record id="prescription_room_view_form" model="ir.ui.view">
            <field name="name">prescription.room.view.form</field>
            <field name="model">prescription.room</field>
            <field name="arch" type="xml">
                <form string="Prescription Room">
                    <header>
                        <field name="status" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet>
                        <field name="room_image" widget="image" class="oe_avatar" options="{'preview_image': 'room_image'}"/>
                        <div class="oe_title">
                            <label for="name" string="Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                            <h2>
                                <field name="is_room_avail" invisible="1"/>
                            </h2>
                        </div>
                        <notebook>
                            <page name="information_prescription_room" string="Information">
                                <group>
                                    <group>
                                        <field name="floor_id" string="floor"/>
                                        <field name="user_id" select="2" string="Room Manager"/>
                                        <!--                                        <field name="taxes_ids" widget="many2many_tags" string="Customer Taxes"/>-->
                                    </group>
                                    <group>
                                        <field name="room_type"/>
                                        <field name="list_price" widget="monetary" string="Rent"/>
                                        <field name="num_person"/>
                                        <field name="uom_id" invisible="1"/>
                                    </group>
                                </group>
                            </page>
                            <!--                            <page string="Amenities">-->
                            <!--                                <group>-->
                            <!--                                    <field name="room_amenities_ids" widget="many2many_tags" string="Room Amenities"/>-->
                            <!--                                </group>-->
                            <!--                            </page>-->
                            <page string="Descriptions">
                                <separator string="Description"/>
                                <field name="description" colspan="4" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!--    Prescription Room menu action-->
        <record id="prescription_room_action" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">prescription.room</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_is_room_avail':True}</field>
        </record>
        <!--Room Menu-->
        <menuitem id="prescription_room_menu" name="Room" action="prescription_room_action" parent="prescription_config_menu" sequence="20"/>
    </data>
</odoo>