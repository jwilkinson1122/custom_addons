<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--    repair request tree view-->
    <record id="repair_request_view_tree" model="ir.ui.view">
        <field name="name">repair.request.view.tree</field>
        <field name="model">repair.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="repair_type"/>
                <field name="team_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <!--    repair request form view-->
    <record id="repair_request_view_form" model="ir.ui.view">
        <field name="name">repair.request.view.form</field>
        <field name="model">repair.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!--                        ada group yang perlu di tambahkan-->
                    <button name="action_assign_repair" string="Assign To" invisible="state != 'draft'" type="object" class="btn-primary"/>
                    <button name="action_start_repair" string="Start" type="object" invisible="state != 'assign'" class="btn-primary"/>
                    <button name="action_done_repair" string="Completed" invisible="state != 'ongoing'" type="object" class="btn-primary"/>
                    <button name="action_maintain_request" string="Maintain Request" invisible="state != 'ongoing'" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft, ongoing,done"/>
                    <button name="action_assign_support" string="Request Support" invisible="state != 'ongoing'" type="object" class="btn-primary"/>
                    <button name="action_assign_assign_support" string="Assign Support" invisible="state != 'support'" type="object" class="btn-primary"/>

                </header>
                <sheet>
                    <h2>
                        <field name="sequence"/>
                    </h2>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="repair_type"/>
                            <field name="room_id" invisible="repair_type != 'room'"/>
                            <field name="prescription" invisible="repair_type != 'prescription'"/>
                            <field name="orthotic_id" invisible="repair_type != 'orthotic'"/>
                        </group>
                        <group>
                            <field name="head_id"/>
                            <field name="assigned_id" domain="[('id', 'in',domain_partner_ids)]" options="{'no_create': True}"/>
                            <field name="domain_partner_ids" invisible="1"/>
                            <field name="support_team_ids" widget="many2many_tags" domain="[('id', 'in',domain_partner_ids),
                                   ('id', '!=', assigned_id)]" invisible=" state not in ['support']" options="{'no_create': True}"/>
                            <field name="support_reason" invisible="state not in ['ongoing']"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!--    repair Team Tree view-->
    <record id="repair_team_view_tree" model="ir.ui.view">
        <field name="name">repair.team.view.tree</field>
        <field name="model">repair.team</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="team_head_id"/>
            </tree>
        </field>
    </record>
    <!--    repair request menu action-->
    <record id="repair_request_action" model="ir.actions.act_window">
        <field name="name">Repair Request</field>
        <field name="res_model">repair.request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!--    menu repair request-->
    <menuitem id="repair_request_menu" name="Repair Request" parent="prescription_config_menu_repair" action="repair_request_action"/>

</odoo>