<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--    inherited Orthotic Vehicle form view to add extra fields-->
    <record id="orthotic_model_view_form" model="ir.ui.view">
        <field name="name">
            orthotic.model.view.form.inherit.odoo.prescription.management
        </field>
        <field name="model">orthotic.model</field>
        <field name="inherit_id" ref="orthotic.orthotic_model_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_year']" position="after">
                <field name="price_per_km" widget="monetary"/>
                <field name="uom_id"/>
            </xpath>
        </field>
    </record>

    <!-- Manufacturer Menu action -->
    <record id="orthotic_model_brand_action" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">orthotic.model.brand</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!--    orthotic menu action-->
    <record id="orthotic_model_action" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">orthotic.model</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!--    Vehicles menu-->
    <menuitem id="orthotic_model_menu" name="Vehicles" action="orthotic_model_action" parent="orthotic_menu" sequence="10"/>

    <!--    manufacturer menu-->
    <menuitem id="orthotic_model_brand_menu" name="Manufacturers" action="orthotic_model_brand_action" parent="orthotic_menu" sequence="10"/>
</odoo>