<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_partner_role">
        <field name="name">Partner Role</field>
        <field name="description">Helps you controlling who can see opportunities expected revenues</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_crm_hide_revenues_field" model="res.groups">
        <field name="name">Disallowed User from Seeing Opportunity Revenues</field>
        <field name="category_id" ref="module_category_partner_role"/>
    </record>

    <record id="group_crm_show_revenues_field" model="res.groups">
        <field name="name">Allowed User to See Opportunity Revenues</field>
        <field name="category_id" ref="module_category_partner_role"/>
        <field name="implied_ids" eval="[(4, ref('group_crm_hide_revenues_field'))]"/>
        <!-- remove to show a checkbox style instead of selection list but this will only be shown in debug mode and when user selects this group the assigned user WILL BE IN THE IMPLIED GROUP -->
    </record>

</odoo>
