<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="podiatry_patient_pathology_view_form" model="ir.ui.view">
        <field name="name">podiatry.patient.pathology.view.form</field>
        <field name="model">podiatry.patient.pathology</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            Pathology Details for
                            <field name="patient_name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group col="2">
                            <field name="patient_id" invisible="1"/>
                            <span colspan="2">
                                <label for="pathology_date"/>
                                <field name="pathology_date" widget="date" class="oe_inline"/>
                                <field name="pathology_date_na" class="oe_inline"/>
                                <label for="pathology_date_na"/>
                            </span>
                            <field name="diagnosis"/>
                            <field name="resolution_date"/>
                        </group>
                        <group>
                            <field name="internal_notes" widget="html"/>
                            <field name="external_notes" widget="html"/>
                            <field name="treatment_professional_ids" widget="many2many_tags_avatar"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="podiatry_patient_pathology_view_tree" model="ir.ui.view">
        <field name="name">podiatry.patient.pathology.view.tree</field>
        <field name="model">podiatry.patient.pathology</field>
        <field name="arch" type="xml">
            <tree string="Patient Pathology History" editable="bottom" multi_edit="True">
                <field name="patient_id" invisible="1"/>
                <field name="pathology_date" widget="date"/>
                <field name="diagnosis"/>
                <field name="resolution_date" widget="date"/>
                <field name="treatment_professional_ids" widget="many2many_avatar_user"/>
                <field name="activity_ids" widget="list_activity"/>
                <button name="action_view_pathology_form" type="object" title="Details" string="Details" context="{'default_patient_id': patient_id}"/>
            </tree>
        </field>
    </record>
</odoo>