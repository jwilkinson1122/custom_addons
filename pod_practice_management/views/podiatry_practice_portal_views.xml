<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="portal_my_home" inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Practices</t>
                    <t t-set="url">/my/practices</t>
                    <t t-set="placeholder_count">practices_count</t>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Patients</t>
                    <t t-set="url">/my/patients</t>
                    <t t-set="placeholder_count">patients_count</t>
                </t>
            </xpath>
        </template>
        <template id="portal_my_practices">
            <t t-call="portal.portal_layout">
                <h1>Your Practices</h1>
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>Practice Name</th>
                            <th>Parent Organization</th>
                            <th>Total Patients</th>
                            <th>Not Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="practices" t-as="practice">
                            <tr>
                                <td>
                                    <strong>
                                        <a t-attf-href="/my/practice?practice_id={{ practice.id }}" t-field="practice.name"/>
                                    </strong>
                                </td>
                                <td>
                                    <span t-field="practice.parent_id"/>
                                </td>
                                <td>
                                    <span t-field="practice.patient_count"/>
                                </td>
                                <td>
                                    <span t-field="practice.inactive_count"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </template>
        <template id="portal_my_practice_patients">
            <t t-call="portal.portal_layout">
                <h1>
                    <span t-field="practice.name"/>
 Patients</h1>
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>Last Name</th>
                            <th>First Name</th>
                            <th>Active Pathologies</th>
                            <th>Active Status</th>
                            <th>Practice Status</th>
                            <th>Estimated Return Date</th>
                            <th>Last Consultation Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="patients" t-as="patient">
                            <t t-set="stage" t-value="patient.stage"/>
                            <t t-set="url" t-value="'/my/patient?patient_id=' + str(patient.id) + '&amp;practice_id=' + str(practice.id)"/>
                            <tr t-attf-class="{{ ('text-danger' if stage == 'inactive'
                                                 else 'text-warning') if stage != 'active'
                                                 else '' }}">
                                <td>
                                    <strong>
                                        <span t-field="patient.last_name"/>
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        <span t-field="patient.first_name"/>
                                    </strong>
                                </td>
                                <td class="text-center">
                                    <a t-if="patient.active_pathology_count" t-attf-href="{{ url }}">
                                        <span t-field="patient.active_pathology_count"/>
                                        <span class="fa fa-external-link"></span>
                                    </a>
                                    <span t-else="">0</span>
                                </td>
                                <td>
                                    <span t-field="patient.active_status"/>
                                </td>
                                <td>
                                    <span t-field="patient.last_consultation_date" t-options="{'widget': 'date'}"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </template>
        <template id="portal_my_patients">
            <t t-call="portal.portal_layout">
                <h1>Your Patients</h1>
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>Last Name</th>
                            <th>First Name</th>
                            <th>Practices</th>
                            <th>Active Pathologies</th>
                            <th>Active Status</th>
                            <th>Practice Status</th>
                            <th>Estimated Return Date</th>
                            <th>Last Consultation Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="patients" t-as="patient">
                            <t t-set="stage" t-value="patient.stage"/>
                            <t t-set="url" t-value="'/my/patient?patient_id=' + str(patient.id)"/>
                            <tr t-attf-class="{{ ('text-danger' if stage == 'inactive'
                                                 else 'text-warning') if stage != 'active'
                                                 else '' }}">
                                <td>
                                    <strong>
                                        <span t-field="patient.last_name"/>
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        <span t-field="patient.first_name"/>
                                    </strong>
                                </td>
                                <td>
                                    <ul class="list-unstyled">
                                        <t t-foreach="patient.sudo().practice_ids" t-as="practice">
                                            <li>
                                                <a t-attf-href="/my/practice?practice_id={{ practice.id }}" t-field="practice.name"/>
                                            </li>
                                        </t>
                                    </ul>
                                </td>
                                <td class="text-center">
                                    <a t-if="patient.active_pathology_count" t-attf-href="{{ url }}">
                                        <span t-field="patient.active_pathology_count"/>
                                        <span class="fa fa-external-link"></span>
                                    </a>
                                    <span t-else="">0</span>
                                </td>
                                <td>
                                    <span t-field="patient.active_status"/>
                                </td>
                                <td>
                                    <span t-field="patient.active_date" t-options="{'widget': 'date'}"/>
                                </td>
                                <td>
                                    <span t-field="patient.last_consultation_date" t-options="{'widget': 'date'}"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </template>
        <template id="portal_my_patient_pathologies">
            <t t-call="portal.portal_layout">
                <h1>Pathology Record for <span t-field="patient.name"/>
                </h1>
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th width="30%">Active Pathology</th>
                            <th width="70%">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="pathologies" t-as="pathology">
                            <tr>
                                <td>
                                    <span t-field="pathology.diagnosis" class="text-wrap"/>
                                </td>
                                <td>
                                    <span t-raw="pathology.external_notes" class="text-wrap"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </template>
        <template id="portal_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <!-- Show link back to practices if practice is set, otherwise just title the Practices-->
                <t t-if="page_name == 'my_practices'">
                    <li t-attf-class="breadcrumb-item #{'active ' if not practice else ''}">
                        <a t-if="practice" t-attf-href="/my/practices">Practices</a>
                        <t t-else="">Practices</t>
                    </li>
                    <!-- Show the practice name as the title if we're looking at a specific practice -->
                    <li t-if="practice" class="breadcrumb-item active" t-esc="practice.name"/>
                </t>
                <!-- If just listing patients, show the "Patients" title -->
                <li t-if="page_name == 'my_patients'" class="breadcrumb-item active">Patients</li>
                <t t-if="page_name == 'my_patient'">
                    <!-- The single patient page can be reached from the patients list or the practices list.
                         If it was reached from the practices list, the practice parameter will be set and should be the first
                         breadcrumb -->
                    <t t-if="practice">
                        <li class="breadcrumb-item">
                            <a href="/my/practices">Practices</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a t-attf-href="/my/practice?practice_id={{ practice.id }}">
                                <span t-field="practice.name"/>
                            </a>
                        </li>
                    </t>
                    <li t-else="" class="breadcrumb-item">
                        <a t-attf-href="/my/patients">Patients</a>
                    </li>
                    <li class="breadcrumb-item active">
                        <span t-field="patient.name"/>
                    </li>
                </t>
            </xpath>
        </template>
    </data>
</odoo>