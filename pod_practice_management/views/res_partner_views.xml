<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_podiatry_practices" model="ir.ui.view">
        <field name="name">res.partner.view.form.podiatry.practices</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <page name="contact_addresses" position="after">
                <page name="Locations">
                    <field invisible="is_company == False" name="owned_practice_ids" string="Practices"/>
                    <field invisible="is_company == True" name="practices_served_ids" string="Practices Served">
                        <tree editable="bottom" create="False" delete="True">
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="manager_id"/>
                            <field name="primary_physician_id"/>
                            <field name="patient_count"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
