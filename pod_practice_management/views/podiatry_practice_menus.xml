        </menuitem> -->

        <menuitem id="podiatry_practice_organizations" name="Accounts" parent="contacts.menu_contacts" groups="pod_practice_management.group_podiatry_practice_user" action="action_view_organization" sequence="1" />

        <menuitem id="podiatry_practice_practices" name="Practices" parent="contacts.menu_contacts" groups="pod_practice_management.group_podiatry_practice_user" action="action_view_practice" sequence="2"/>


        <!-- <menuitem id="res_partner_menu_contacts" name="Contacts" action="action_contacts" parent="menu_contacts" sequence="2"/> -->


        <menuitem id="contacts.res_partner_menu_contacts" name="Contacts" parent="contacts.menu_contacts" groups="pod_practice_management.group_podiatry_practice_user" action="action_view_contact" sequence="3"/>

        <menuitem id="podiatry_practice_patients" name="Patients" parent="contacts.menu_contacts" groups="pod_practice_management.group_podiatry_practice_user" action="action_view_patient" sequence="4"/>

        <menuitem id="contacts.res_partner_menu_config" name="Configuration" parent="contacts.menu_contacts" groups="base.group_system" sequence="10"/>


    </data>
</odoo>
