        <record id="action_view_contact" model="ir.actions.act_window">
            <field name="name">Contacts</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form,activity</field>
            <field name="domain">[('is_company', '=', False), ('id', '!=', 1)]</field>
            <field name="search_view_id" ref="base.view_res_partner_filter"/>
            <field name="context">{'default_is_company': False, 'default_company_type':'person'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
            Create a Contact in your address book
                </p>
                <p>
            Odoo helps you track all activities related to your contacts.
                </p>
            </field>
        </record>

        <record id="action_view_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">podiatry.patient</field>
            <field name="view_mode">tree,kanban,form</field>
        </record>

        <!-- <menuitem id="podiatry_practice_root" web_icon="pod_practice_management,static/description/icon.png" name="Podiatry Practice" groups="pod_practice_management.group_podiatry_practice_user" action="action_view_organization">
            <menuitem id="podiatry_practice_organizations" name="Accounts" groups="pod_practice_management.group_podiatry_practice_user" action="action_view_organization"/>
            <menuitem id="podiatry_practice_practices" name="Practices" groups="pod_practice_management.group_podiatry_practice_user" action="action_view_practice"/>
