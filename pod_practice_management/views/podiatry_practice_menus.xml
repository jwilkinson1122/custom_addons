<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="action_view_organization" model="ir.actions.act_window">
            <field name="name">Accounts</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('is_company', '=', True), ('id', '!=', 1)]</field>
            <field name="context">{'default_is_company': True, 'default_company_type':'company'}</field>
        </record>


        <record id="action_view_practice" model="ir.actions.act_window">
            <field name="name">Practices</field>
            <field name="res_model">podiatry.practice</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="practices_view_search"/>
        </record>
        <record id="action_view_practice_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="act_window_id" ref="action_view_practice"/>
            <field name="view_id" ref="podiatry_practice_view_kanban"/>
        </record>
        <record id="action_view_practice_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">tree</field>
            <field name="act_window_id" ref="action_view_practice"/>
            <field name="view_id" ref="podiatry_practice_view_list"/>
        </record>
        <record id="action_view_practice_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">form</field>
            <field name="act_window_id" ref="action_view_practice"/>
            <field name="view_id" ref="podiatry_practice_view_form"/>
        </record>

