    <record id="partner_company_action" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="domain">[('is_company', '=', True), ('id', '!=', 1), ('user_ids', '=', False)]</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a Customer Company in your address book
            </p>
            <p>
            Odoo helps you track all activities related to your customers companies.
            </p>
        </field>
    </record>

