<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="partner_type_account" model="res.partner.type">
      <field name="name">Account</field>
      <field name="code">ACCOUNT</field>
      <field name="is_account" eval="True"/>
      <field name="is_affiliate" eval="False"/>
      <field name="is_contact" eval="False"/>
      <field name="is_patient" eval="False"/>
      <field name="company_type">company</field>
    </record>
    <record id="partner_type_affiliate" model="res.partner.type">
      <field name="name">Affiliate</field>
      <field name="code">AFFILIATE</field>
      <field name="is_account" eval="False"/>
      <field name="is_affiliate" eval="True"/>
      <field name="is_contact" eval="False"/>
      <field name="is_patient" eval="False"/>
      <field name="company_type">company</field>
      <!-- <field name="can_have_parent" eval="True"/>
      <field name="parent_is_required" eval="True"/> -->
      <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account')])]"/>
    </record>
    <record id="partner_type_contact" model="res.partner.type">
      <field name="name">Contact</field>
      <field name="code">CONTACT</field>
      <field name="is_account" eval="False"/>
      <field name="is_affiliate" eval="False"/>
      <field name="is_contact" eval="True"/>
      <field name="is_patient" eval="False"/>
      <field name="company_type">person</field>
      <field name="can_have_parent" eval="True"/>
      <field name="parent_is_required" eval="True"/>
      <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account'), ref('partner_type_affiliate')])]"/>
    </record>
    <record id="partner_type_patient" model="res.partner.type">
      <field name="name">Patient</field>
      <field name="code">PATIENT</field>
      <field name="is_account" eval="False"/>
      <field name="is_affiliate" eval="False"/>
      <field name="is_contact" eval="False"/>
      <field name="is_patient" eval="True"/>
      <field name="company_type">person</field>
      <field name="can_have_parent" eval="True"/>
      <field name="parent_is_required" eval="True"/>
      <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account'), ref('partner_type_affiliate')])]"/>
    </record>
</odoo>