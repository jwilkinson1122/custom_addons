<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <record id="seq_res_partner_account" model="ir.sequence">
        <field name="name">Account Code</field>
        <field name="code">res.partner.account</field>
        <field name="prefix">ID</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_res_partner_affiliate" model="ir.sequence">
        <field name="name">Affiliate Code</field>
        <field name="code">res.partner.affiliate</field>
        <field name="prefix"></field>
        <field name="padding">2</field>
    </record>

    <record id="seq_res_partner_contact" model="ir.sequence">
        <field name="name">Contact Code</field>
        <field name="code">res.partner.contact</field>
        <field name="prefix">CT</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_res_partner_patient" model="ir.sequence">
        <field name="name">Patient Code</field>
        <field name="code">res.partner.patient</field>
        <field name="prefix">PT</field>
        <field name="padding">4</field>
    </record>

</odoo>

