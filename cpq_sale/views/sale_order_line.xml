<?xml version='1.0' encoding='utf-8' ?>
<odoo>

    <record id="sale_order_line_tree_view_cpq" model="ir.ui.view">
        <field name="name">sale.order.line.tree.cpq</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom']" position="after">
                <field name="cpq_product_created" widget="boolean_button" readonly="1" options="{'terminology': 'Promoted'}"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_form_view_cpq" model="ir.ui.view">
        <field name="name">sale.order.line.form.cpq</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//form//sheet//group" position="inside">
                <field name="cpq_configuration_json" invisible="1"/>
                <button name="action_open_create_product_wizard" string="Create Product from Configuration" type="object" class="btn-primary" invisible="not cpq_configuration_json"/>
            </xpath>
        </field>
    </record>
    
    <record id="action_batch_create_product_from_cpq_lines" model="ir.actions.server">
        <field name="name">Batch Create CPQ Products</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="binding_model_id" ref="sale.model_sale_order_line"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'name': 'Batch Create CPQ Products',
                'type': 'ir.actions.act_window',
                'res_model': 'batch.create.product.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_sale_order_line_ids': active_ids},
            }
        </field>
    </record>
    
</odoo>
