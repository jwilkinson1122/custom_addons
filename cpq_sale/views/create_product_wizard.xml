<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="view_create_product_wizard" model="ir.ui.view">
        <field name="name">create.product.wizard.form</field>
        <field name="model">create.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Product Creation">
                <group>
                    <field name="sale_order_line_id" readonly="1"/>
                    <field name="configuration_summary" readonly="1" widget="html"/>
                </group>
                <separator string="Product Preview"/>
                <group>
                    <field name="preview_name" readonly="1"/>
                    <field name="preview_internal_ref" readonly="1"/>
                </group>
                <footer>
                    <button string="Create Product" type="object" name="action_confirm_create" class="btn-primary"/>
                    <button string="Print Summary" type="object" name="action_print_summary" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>