    <!-- 🌟 Form View -->
    <record id="product_template_only_form_view_inherited" model="ir.ui.view">
        <field name="name">product_template_only_form_view_inherited</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- ✅ CPQ Options Checkbox -->
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="cpq_ok"/>
                    <label for="cpq_ok"/>
                </span>
            </xpath>

            <!-- ✅ Configurator Button -->
            <xpath expr="//header" position="inside">
                <button name="action_configure_cpq" class="btn btn-secondary" type="object" icon="fa-wrench" string="Configure Product" invisible="cpq_ok == False"/>
            </xpath>

            <!-- ✅ Sale Description Template -->
            <xpath expr="//field[@name='description_sale']/parent::group" position="after">
                <group string="Configurable Sale Description Template" name="cpq_sale_description" invisible="cpq_ok == False">
                    <field name="cpq_description_sale_tmpl" nolabel="1"/>
                </group>
            </xpath>

            <!-- ✅ CPQ General Info -->
            <xpath expr="//page[@name='general_information']/group" position="after">
                <group colspan="2" name="cpq_general_information" string="Configurable Options">
                    <field name="cpq_ref" invisible="cpq_ok == False"/>
                    <p colspan="2" class="oe_grey">
                        The reference for this configurable template. This is shared by all variants.
                    </p>

                    <field name="cpq_ref_mode" invisible="cpq_ok == False"/>
                    <p colspan="2" class="oe_grey">
                        When enabled, dynamically generate variant internal references.
                    </p>

                    <field name="cpq_ref_tmpl" invisible="cpq_ok == False or cpq_ref_mode != 'inline'"/>
                    <field name="cpq_ref_code" options="{'mode': 'python'}" widget="ace" invisible="cpq_ok == False or cpq_ref_mode != 'code'"/>
                </group>
            </xpath>

            <!-- ✅ Hide default_code for CPQ -->
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="invisible">product_variant_count &gt; 1 or cpq_ok == True</attribute>
            </xpath>

            <!-- ✅ Variants Page Warning -->
            <xpath expr="//page[@name='variants']" position="inside">
                <p class="oe_grey oe_edit_only" invisible="cpq_ok != True">
                    <strong>Warning:</strong> Removing attributes or attribute values from a configurable product should be carefully carried out, especially if there are BoMs involved.
                    Removing an attribute will automatically archive any products which are now invalid.
                </p>
            </xpath>

            <!-- ✅ CPQ Variant Creation Control -->
            <xpath expr="//page[@name='variants']//field[@name='attribute_line_ids']" position="before">
                <group>
                    <field name="no_create_variants"/>
                </group>
            </xpath>

            <!-- ✅ Tooltip Display -->
            <xpath expr="//field[@name='product_tooltip']" position="before">
                <field name="cpq_tooltip" string="" class="font-italic text-muted"/>
            </xpath>

        </field>
    </record>

    <!-- 🌟 Kanban View -->
    <record id="product_template_kanban_view_inherited" model="ir.ui.view">
        <field name="name">product.template.product.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="cpq_ok"/>
            </xpath>
            <xpath expr="//div[hasclass('o_kanban_record_headings')]" position="after">
                <a name="action_configure_cpq" type="object" invisible="cpq_ok == False" style="margin-right: 8px">
                    <i class="fa fa-wrench fa-lg" title="Configure Product"/>
                </a>
            </xpath>
        </field>
    </record>

    <!-- 🌟 Tree View (from cpq_sale, this is good) -->

    <!-- 🌟 Action to show only CPQ products -->
    <record id="action_product_template_tree_view_cpq_only" model="ir.actions.act_window">
        <field name="name">CPQ Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('cpq_ok', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <!-- ✅ Product Template Tree View with buttons -->
    <record id="product_template_tree_view_cpq_configure" model="ir.ui.view">
        <field name="name">product.template.tree.cpq.configure</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="cpq_ok" invisible="1"/>
                <button name="action_config_start_global" string="🛠️ New Configuration" type="object" class="btn-primary" title="Start a new configuration" context="{'active_model': 'sale.order'}"/>
                <!-- <button name="action_configure_cpq" string="Configure Product" type="object" class="btn-primary" icon="fa-cogs" context="{'active_model': 'sale.order', 'active_id': active_id}"/> -->
                <button name="action_configure_cpq" string="Configure Product" type="object" class="btn-primary" icon="fa-cogs" context="{'active_model': 'product.template', 'active_id': id}"/>

            </xpath>
            <xpath expr="//tree" position="attributes">
                <attribute name="multi_edit">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- 🌟 Search View -->
    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product_template_search_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='consumable']" position="after">
                <separator/>
                <filter string="Configurable Products" name="cpq_products" domain="[('cpq_ok', '=', True)]"/>
            </xpath>
        </field>
    </record>


</odoo>
