<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="inherit_cpq_view_order_line_form" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.cpq</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='order_line']" position="before">
                <button class="oe_highlight" name="action_config_start" string="Configure Product" style="margin-top: 15px;" type="object" invisible="state != 'draft'"/>
            </xpath> -->
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-warning">cpq_unconfigured</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="cpq_unconfigured" invisible="1"/>
                <field name="cpq_laterality" column_invisible="1"/>
                <!-- <field name="cpq_laterality" column_invisible="1"/> -->
                <button name="edit_cpq_configuration" title="Reconfigure" type="object" class="btn-secondary" icon="fa-cogs" invisible="not product_template_id_cpq_ok"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree/field[@name='product_template_id']" position="before">
                <field name="product_template_id_cpq_ok" column_invisible="1" />
            </xpath>
            <!-- <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="order_line_image" widget="image" style="height:30px;width:30px ;" readonly="1"/>
            </xpath> -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="cpq_laterality" string="Side" column_invisible="1"/>
                <field name="cpq_configuration_summary" class="cpq-config-summary-tree" string="Configuration Summary" widget="html" readonly="1"/>

                <!-- <field name="cpq_configuration_summary" class="cpq-config-summary-tree" style="white-space: normal; width: 500px; word-break: break-word; padding: 4px; line-height: 1.4;" string="Configuration Summary" widget="html" readonly="1"/> -->
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='cpq_configuration_summary']" position="attributes">
                <attribute name="widget">html</attribute>
                <attribute name="readonly">1</attribute>
                <attribute name="class">cpq-config-summary-tree</attribute>
                <attribute name="style">width: 600px; max-width: 800px; white-space: normal;</attribute>
            </xpath>
            <!-- <xpath expr="//field[@name='cpq_configuration_summary']" position="attributes">
                <attribute name="style">width: 600px; max-width: 800px; white-space: normal;</attribute>
            </xpath> -->

            <xpath expr="//field[@name='order_line']/tree/field[@name='cpq_configuration_summary']" position="after">
                <field name="cpq_unconfigured" string="Missing Config" widget="boolean" readonly="1" invisible="not cpq_unconfigured" options="{'terminology': 'Alert'}"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="replace">
                <!-- Standard price field for non-CPQ -->
                <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="product_template_id_cpq_ok" readonly="1"/>
                <!-- CPQ-friendly display for CPQ lines -->
                <field name="price_unit_display" string="Unit Price" readonly="1" invisible="not product_template_id_cpq_ok"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='tax_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='price_subtotal']" position="attributes">
                <attribute name="string">Subtotal</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <field name="product_template_id_cpq_ok" invisible="1"/>
                <button name="toggle_debug_cpq_json" string="Toggle CPQ JSON" type="object" class="btn-secondary" />
                <notebook>
                    <page string="CPQ Details" invisible="not product_template_id_cpq_ok">
                        <group>
                            <field name="cpq_laterality" readonly="1"/>
                            <field name="cpq_configuration_summary" string="Config Summary" widget="html" readonly="1" class="cpq-config-summary"/>
                            <field name="cpq_configuration_json" invisible="1"/>
                        </group>
                    </page>
                </notebook>
            </xpath>


        </field>
    </record>
</odoo>
