<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template id="report_saleorder_cpq_summary" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="mt32">
                <h3>🧩 CPQ Configuration Summary</h3>
                <p><strong>Order:</strong> <t t-esc="doc.order_id.name"/></p>
                <p><strong>Date:</strong> <t t-esc="doc.order_id.date_order"/></p>
                <p><strong>Customer:</strong> <t t-esc="doc.order_id.partner_id.name"/></p>
                <hr/>
                <t t-foreach="doc.order_line" t-as="line">
                    <t t-if="line.cpq_summary_printable">
                        <div class="mt16 mb16">
                            <h4>Product: <t t-esc="line.name"/></h4>
                            <div t-raw="line.cpq_summary_printable"/>
                            <t t-if="line.cpq_qr_image">
                                <div class="mt8">
                                    <!-- <img t-att-src="'data:image/png;base64,%s' % line.cpq_qr_image" alt="CPQ QR Code" style="width: 128px; height: 128px;"/> -->
                                    <img t-att-src="'data:image/png;base64,%s' % line.cpq_qr_image.decode('utf-8')" style="max-width: 128px; margin-top: 10px;" />
                                </div>
                                
                            </t>
                        </div>
                        <hr/>
                    </t>
                </t>
            </div>
        </xpath>
    </template>
