<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <!-- Inject CPQ summary inside the line description cell -->
        <xpath expr="//td[@name='td_name']" position="inside">

            <t t-if="line.cpq_configuration_summary">
                <strong>Configuration:</strong>
                <br/>

                <div style="margin-top: 4px; line-height: 1.4; font-size: 85%; color: #555; border-top: 1px solid #ccc; padding-top: 4px;">
                    <t t-raw="line.cpq_configuration_summary"/>
                </div>
            </t>
        </xpath>
        <!-- <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row mt-4 mb-2 sale-order-informations</attribute>
        </xpath> -->
        <xpath expr="//td[@name='td_priceunit']" position="replace">
            <td class="text-end" name="td_priceunit">
                <t t-if="line.product_template_id.cpq_ok and not line.cpq_configuration_json">
                    <span class="text-danger">⚠️ Not configured</span>
                </t>
                <t t-elif="line.product_template_id.cpq_ok and line.price_unit == 0.0">
                    <span class="text-muted">⚙️ Configure to see price</span>
                </t>
                <t t-else="">
                    <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                </t>
            </td>
        </xpath>


    </template>


    <!-- <template id="report_saleorder_document_hide_salesperson" inherit_id="sale.report_saleorder_document">
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                <span t-field="line.price_total" />
            </td>
        </xpath>
    </template> -->

</odoo>
