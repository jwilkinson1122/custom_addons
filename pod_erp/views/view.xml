<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="topcover_brand_view_form" model="ir.ui.view">
            <field name="name">topcover.brand.view.form</field>
            <field name="model">topcover.brand</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="image" widget="image"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="topcover_collection_view_form" model="ir.ui.view">
            <field name="name">topcover.collection.view.form</field>
            <field name="model">topcover.collection</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="brand"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="topcover_brand_action" model="ir.actions.act_window">
            <field name="name">brand</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">topcover.brand</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="topcover_collection_action" model="ir.actions.act_window">
            <field name="name">collection</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">topcover.collection</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="topcover_material_action" model="ir.actions.act_window">
            <field name="name">topcover_material</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">topcover.material</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="topcover_shape_action" model="ir.actions.act_window">
            <field name="name">topcover_shape</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">topcover.length</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="topcover_type_action" model="ir.actions.act_window">
            <field name="name">topcover_type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">topcover.type</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="topcover_manufacturer_action" model="ir.actions.act_window">
            <field name="name">manufacturer</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">topcover.manufacturer</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="lens_type_action" model="ir.actions.act_window">
            <field name="name">Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">lens.type</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lens_style_action" model="ir.actions.act_window">
            <field name="name">Style</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">lens.style</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="lens_material_action" model="ir.actions.act_window">
            <field name="name">Material</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">lens.material</field>
            <field name="view_mode">tree,form</field>
        </record>
     

        <record id="erp_topcovers_action" model="ir.actions.act_window">
            <field name="name">Top Covers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="domain">[('categ_id','=','Top Covers')]</field>
            <field name="context">{'def_categ_id':'Top Covers' }</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="erp_lens_action" model="ir.actions.act_window">
            <field name="name">Lens</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="domain">[('categ_id','=','Lens')]</field>
            <field name="context">{'def_categ_id':'Lens' }</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="erp_treatment_action" model="ir.actions.act_window">
            <field name="name">Treatment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="domain">[('categ_id','=','Lens Treatment')]</field>
            <field name="context">{'def_categ_id':'Lens Treatment' }</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="erp_service_action" model="ir.actions.act_window">
            <field name="name">Service</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="domain">[('categ_id','=','Service')]</field>
            <field name="context">{'def_categ_id':'Service' }</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="erp_miscellaneous_action" model="ir.actions.act_window">
            <field name="name">Miscellaneous</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="domain">[('categ_id','=','Miscellaneous')]</field>
            <field name="context">{'def_categ_id':'Miscellaneous' }</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="product_topcovers" name="Top Covers" parent="pod_erp_config"
                  sequence="4"/>
        <menuitem id="product_lenses" name="Lens" parent="pod_erp_config"
                  sequence="10"/>


        <menuitem id="product_topcovers_brand" name="Brands" parent="product_topcovers" action="topcover_brand_action"
                  sequence="4"/>
        <menuitem id="product_topcovers_collection" name="Collections" parent="product_topcovers"
                  action="topcover_collection_action"
                  sequence="5"/>
        <menuitem id="product_topcovers_type" name="Types" parent="product_topcovers"
                  action="topcover_type_action"
                  sequence="6"/>
        <menuitem id="product_topcovers_material" name="Materials" parent="product_topcovers"
                  action="topcover_material_action"
                  sequence="7"/>
        <menuitem id="product_topcovers_manufacturer" name="Manufacturer" parent="product_topcovers"
                  action="topcover_manufacturer_action"
                  sequence="8"/>
        <menuitem id="product_topcovers_shape" name="Shape" parent="product_topcovers"
                  action="topcover_shape_action"
                  sequence="9"/>

        <menuitem id="product_lenses_type" name="Type" parent="product_lenses" action="lens_type_action"
                  sequence="11"/>
        <menuitem id="product_lenses_style" name="Style" parent="product_lenses" action="lens_style_action"
                  sequence="12"/>
        <menuitem id="product_lenses_material" name="Material" parent="product_lenses" action="lens_material_action"
                  sequence="13"/>
     


        <menuitem id="pod_erp_products" name="Products" parent="pod_erp_root"
                  sequence="5"/>
        <menuitem id="pod_erp_product_topcover" name="Top Covers" parent="pod_erp_products" action="erp_topcovers_action"
                  sequence="1"/>
        <menuitem id="pod_erp_product_lens" name="Lens" parent="pod_erp_products" action="erp_lens_action"
                  sequence="2"/>

        <menuitem id="pod_erp_product_treatment" name="Lens Treatment" parent="pod_erp_products"
                  action="erp_treatment_action"
                  sequence="4"/>
        <menuitem id="pod_erp_product_service" name="Service" parent="pod_erp_products"
                  action="erp_service_action"
                  sequence="5"/>
        <menuitem id="pod_erp_product_miscellaneous" name="Miscellaneous" parent="pod_erp_products"
                  action="erp_miscellaneous_action"
                  sequence="6"/>
    </data>
</odoo>
