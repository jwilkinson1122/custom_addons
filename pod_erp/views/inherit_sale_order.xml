<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="complete_pair_order_view" model="ir.ui.view">
        <field name="name">Complete Pair Order</field>
        <field name="model">complete.pair.order</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="prescription" required="1"/>
                </group>
                <group>
                    <field name="topcover" required="1"/>
                </group>
                <group>
                    <field name="lens" required="1"/>
                </group>
                <footer>
                    <button name="show_btn" class="oe_highlight" string="Add to Order" type="object"/>
                    <button class="oe_highlight" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="complete_pair_order_wizard" model="ir.actions.act_window">
        <field name="name">Complete Pair Order wizard</field>
        <field name="res_model">complete.pair.order</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="complete_pair_order_view"/>
    </record>

    
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field string="Prescription" name="prescription_id"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field string="Optometrist" name="practitioner"/>
                <field name="prescription_date" string="Prescription Date"/>
                <field name="commitment_date"/>
                <field name="po_ref"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="print_prescription_report_ticket_size" class="btn btn-success" string="Print Measure" type="object"></button>
                <button name="print_opthamologic_prescription_report_ticket_size" class="btn btn-success" string="Print Opthamologic" type="object"></button>
                <button name="print_sale_order_report" class="btn btn-success" string="Print Sale Order" type="object" invisible="state != 'sale'"/>
                <button name="print_purchase_order_report" class="btn btn-success" string="Print Purchase Order" type="object" invisible="not po_ref and state != 'sale'"/>

            </xpath>
            <xpath expr="//group[@name='sale_header']" position="after">
                <hr/>
                <button name="%(complete_pair_order_wizard)d" class="btn btn-info padding_5px" type="action" string="Complete Pair" context="{'is_complete_pair': True}"/>
            </xpath>
        </field>
    </record>
</odoo>