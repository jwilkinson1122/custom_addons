<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Refuse access to patient records that are not part of contact user's practices -->
        <record id="restrict_contact_access_to_practice_patients" model="ir.rule">
            <field name="name">Restrict Practice Contact Access to Their Patients Only</field>
            <field name="model_id" ref="model_res_patient"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [('practice_ids.contact_ids.user_ids', 'in', user.id)]
            </field>
        </record>
        <record id="restrict_contact_access_to_practices" model="ir.rule">
            <field name="name">Restrict Practice Contact Access to Their Practices Only</field>
            <field name="model_id" ref="model_res_practice"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [('contact_ids.user_ids', 'in', user.id)]
            </field>
        </record>
        <record id="restrict_contact_access_to_practice_pathologies" model="ir.rule">
            <field name="name">Restrict Practice Contact Access to Their Practices Only</field>
