            <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [('patient_id.practice_ids.contact_ids.user_ids', 'in', user.id)]
            </field>
        </record>
        <record id="restrict_patient_contact_access_to_allowed_internal_users" model="ir.rule">
            <field name="name">Restrict Patient Contact Access to Allowed Internal
                Users
            </field>
            <field name="model_id" ref="model_res_patient_contact"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [('patient_id.practice_ids.contact_ids.user_ids', 'in', user.id)]
            </field>
        </record>
        <record id="allow_practice_access_to_admins" model="ir.rule">
            <field name="name">Allow Practice Access to Administrators</field>
            <field name="model_id" ref="model_res_practice"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('pod_practice_management.group_res_practice_admin')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)]
            </field>
        </record>
        <record id="allow_patient_access_to_admins" model="ir.rule">
            <field name="name">Allow Patient Access to Administrators</field>
            <field name="model_id" ref="model_res_patient"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('pod_practice_management.group_res_practice_admin')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)]
            </field>
        </record>
        <record id="allow_pathology_access_to_admins" model="ir.rule">
            <field name="name">Allow Pathology Access to Administrators</field>
            <field name="model_id" ref="model_res_patient_pathology"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('pod_practice_management.group_res_practice_admin')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)]
            </field>
        </record>
        <record id="allow_patient_contact_access_to_admins" model="ir.rule">
            <field name="name">Allow Podiatry Patient Contact Access to Administrators
            </field>
            <field name="model_id" ref="model_res_patient_contact"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('pod_practice_management.group_res_practice_admin')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
