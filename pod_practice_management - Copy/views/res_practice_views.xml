<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="practices_view_search" model="ir.ui.view">
        <field name="name">practices.view.search</field>
        <field name="model">res.practice</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id" string="Parent Organization"/>
                <field name="manager_id"/>
                <field name="primary_physician_id"/>
                <filter context="{'group_by': 'parent_id'}" name="groupby_parent_id"/>
                <filter context="{'group_by': 'manager_id'}" name="groupby_manager_id"/>
                <filter context="{'group_by': 'primary_physician_id'}" name="groupby_primary_physician_id"/>
            </search>
        </field>
    </record>
    <record id="res_practice_view_kanban" model="ir.ui.view">
        <field name="name">res.practice.view.kanban</field>
        <field name="model">res.practice</field>
        <field name="arch" type="xml">
            <kanban archivable="false" default_group_by="parent_id" default_order="name" group_create="false" group_delete="false">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="manager_name"/>
                <field name="primary_physician_name"/>
                <field name="patient_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div>
                                <strong class="o_kanban_record_title">
                                    <span>
                                        <field name="name"/>
                                    </span>
                                </strong>
                            </div>
                            <div>
                                <span class="o_kanban_record_subtitle">
                                    <field name="parent_id"/>
                                </span>
                            </div>
                            <div>
                                <span>
                                    Practice Manager:
                                    <field name="manager_name"/>
                                </span>
                            </div>
                            <div>
                                <span>
                                    Primary Physician:
                                    <field name="primary_physician_name"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="text-success">
                                        Patients:
                                        <field name="patient_count"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="res_practice_view_list" model="ir.ui.view">
        <field name="name">res.practice.view.list</field>
        <field name="model">res.practice</field>
        <field name="arch" type="xml">
            <tree string="Podiatry Practices">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="manager_id"/>
                <field name="primary_physician_id"/>
                <field name="patient_count"/>
            </tree>
        </field>
    </record>
    <record id="res_practice_view_form" model="ir.ui.view">
        <field name="name">res.practice.view.form</field>
        <field name="model">res.practice</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_button_box"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                            <field name="id"/>
                        </h1>
                    </div>
                    <group string="Practice Information">
                        <field name="parent_id"/>
                        <field name="patient_count"/>
                    </group>
                    <br></br>
                    <notebook>
                        <page name="contact" string="Contact Information">
                            <field name="contact_ids" nolabel="1">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="mobile" widget="phone"/>
                                    <field name="has_portal_access"/>
                                    <field name="partner_id"/>
                                    <button class="oe_highlight" groups="pod_practice_management.group_res_practice_admin,base.group_system" icon="fa-user-plus" invisible="has_portal_access == True" name="action_grant_portal_access" title="Grant Portal Access" type="object"/>
                                    <button class="oe_highlight" groups="pod_practice_management.group_res_practice_admin,base.group_system" icon="fa-ban" invisible="has_portal_access == False" name="action_revoke_portal_access" title="Revoke Portal Access" type="object"/>
                                </tree>
                            </field>
                        </page>
                        <page name="user_access" string="User Access" groups="pod_practice_management.group_res_practice_admin,base.group_system">
                            <field name="allowed_user_ids"/>
                        </page>
                    </notebook>
                    <br></br>
                    <notebook>
                        <page name="patients" string="Patients">
                            <field name="patient_ids" nolabel="1" context="{'tree_view_ref': 'pod_practice_management.res_patient_view_list_embedded'}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="res_practice_contact_view_form" model="ir.ui.view">
        <field name="name">res.practice.contact.view.form</field>
        <field name="model">res.practice.contact</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="parent_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
