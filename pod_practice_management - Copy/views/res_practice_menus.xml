<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="action_view_practice" model="ir.actions.act_window">
            <field name="name">Podiatry Practices</field>
            <field name="res_model">res.practice</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="practices_view_search"/>
        </record>
        <record id="action_view_practice_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="act_window_id" ref="action_view_practice"/>
            <field name="view_id" ref="res_practice_view_kanban"/>
        </record>
        <record id="action_view_practice_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">tree</field>
            <field name="act_window_id" ref="action_view_practice"/>
            <field name="view_id" ref="res_practice_view_list"/>
        </record>
        <record id="action_view_practice_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">form</field>
            <field name="act_window_id" ref="action_view_practice"/>
            <field name="view_id" ref="res_practice_view_form"/>
        </record>
        <record id="action_view_organization" model="ir.actions.act_window">
            <field name="name">Organizations</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('is_company', '=', True)]</field>
        </record>
        <record id="action_view_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">res.patient</field>
            <field name="view_mode">tree,kanban,form</field>
        </record>
        <menuitem id="res_practice_root" web_icon="pod_practice_management,static/description/icon.png" name="Podiatry Practice" groups="pod_practice_management.group_res_practice_user" action="action_view_practice">
            <menuitem id="res_practice_organizations" name="Organizations" groups="pod_practice_management.group_res_practice_user" action="action_view_organization"/>
            <menuitem id="res_practice_practices" name="Practices" groups="pod_practice_management.group_res_practice_user" action="action_view_practice"/>
            <menuitem id="res_practice_patients" name="Patients" groups="pod_practice_management.group_res_practice_user" action="action_view_patient"/>
        </menuitem>
    </data>
</odoo>
