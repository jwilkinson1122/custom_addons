<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lab_test_create_wizard_view" model="ir.ui.view">
        <field name="name">lab.test.create.wizard.view</field>
        <field name="model">lab.test.create</field>
        <field name="arch" type="xml">
            <form string="Create Lab Test">
                <separator colspan="4" string="Do you want to generate the test(s) ?" />
                <newline />
                <separator string="Create Tests" colspan="6" />
                <footer>
                    <button name="create_lab_test" string="Create Lab Test" type="object" class="oe_highlight" />
                        or
                    <button special="cancel" string="Cancel" class="oe_highlight" />
                </footer>
            </form>
        </field>
    </record>


    <record id="action_create_lab_result2" model="ir.actions.act_window">
        <field name="name">Create Lab Result</field>
        <field name="res_model">lab.test.create</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem name="Laboratory" id="main_menu_conf_laboratory"
            parent = "pod_mgmt_system.main_menu_configartion" sequence='0'
           />

</odoo>
