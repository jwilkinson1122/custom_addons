<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="preinatal_tree_view" model="ir.ui.view">
        <field name="name">preinatal.tree.view</field>
        <field name="model">preinatal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="gestational_weeks" />
                <field name="admission_date" />
            </tree>
        </field>
    </record>

    <record id="preinatal_form_view" model="ir.ui.view">
        <field name="name">preinatal.form.view</field>
        <field name="model">preinatal</field>
        <field name="arch" type="xml">
            <form>
                <field name="gestational_weeks" />
                <field name="admission_date" />
            </form>
        </field>
    </record>

</odoo>
