    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field string="Prescription" name="prescription_id"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field string="Optometrist" name="doctor"/>
                <field name="prescription_date" string="Prescription Date"/>
                <field name="commitment_date"/>
                <field name="po_ref"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="print_prescription_report_ticket_size" class="btn btn-success" string="Print Measure" type="object"></button>
                <button name="print_opthamologic_prescription_report_ticket_size" class="btn btn-success" string="Print Opthamologic" type="object"></button>
                <button name="print_sale_order_report" class="btn btn-success" string="Print Sale Order" type="object" invisible="state != 'sale'"/>
                <button name="print_purchase_order_report" class="btn btn-success" string="Print Purchase Order" type="object" invisible="not po_ref and state != 'sale'"/>

            </xpath>
            <xpath expr="//group[@name='sale_header']" position="after">
                <hr/>
                <button name="%(complete_pair_order_wizard)d" class="btn btn-info padding_5px" type="action" string="Complete Pair" context="{'is_complete_pair': True}"/>
                <button name="%(contact_lens_wizard)d" class="btn btn-info padding_5px" string="Contact Lens" type="action" style="margin-left: 3px;" context="{'is_contact_lens': True}"/>
                <button name="%(frame_only_order_wizard)d" class="btn btn-info padding_5px" string="Frame Only" type="action" style="margin-left: 3px;" context="{'is_frame': True}"/>
                <button name="%(lens_only_order_wizard)d" class="btn btn-info padding_5px" string="Lens Only" type="action" style="margin-left: 3px;" context="{'is_lens': True}"/>
                <button name="%(service_order_wizard)d" class="btn btn-info padding_5px" string="Services" type="action" style="margin-left: 3px;" context="{'is_services': True}"/>
                <button name="%(miscellaneous_order_wizard)d" class="btn btn-info padding_5px" string="Miscellaneous" type="action" style="margin-left: 3px;" context="{'is_miscellaneous': True}"/>
            </xpath>
        </field>
    </record>
</odoo>