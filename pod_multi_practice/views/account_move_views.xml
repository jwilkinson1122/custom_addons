<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="view_move_form_practice_inherit" model="ir.ui.view">
			<field name="name">view.move.form.inherit</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_move_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='invoice_date']" position="after">
					<field name="practice_id" options="{'no_create': True}" required="1"/>
				</xpath>
				<xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="attributes">
					<attribute name="domain">[('deprecated', '=', False), ('account_type', 'not in', ('asset_receivable', 'liability_payable')), ('company_id', '=', parent.company_id), '|', ('practice_id', '=', parent.practice_id),('practice_id', '=', False)]</attribute>
				</xpath>
			</field>
		</record>

		<record id="view_out_invoice_tree_inherit_practice" model="ir.ui.view">
			<field name="name">view.out.invoice.tree</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_out_invoice_tree"/>
			<field name="arch" type="xml">
				<field name="company_id" position="after">
					<field name="practice_id" optional="show"/>
				</field>
			</field>
		</record>

		<record id="view_in_invoice_tree_inherit_practice" model="ir.ui.view">
			<field name="name">view.in.invoice.tree</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_in_invoice_tree"/>
			<field name="arch" type="xml">
				<field name="company_id" position="after">
					<field name="practice_id" optional="show"/>
				</field>
			</field>
		</record>

		<record id="view_account_invoice_filter_inherit_practice" model="ir.ui.view">
			<field name="name">.view.account.invoice.filter.inherit</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_account_invoice_filter"/>
			<field name="arch" type="xml">
				<xpath expr="//search/group" position="inside">
					<filter string="Practice" name="Practice" context="{'group_by':'practice_id'}"/>
				</xpath>
			</field>
		</record>

		<record id="view_move_line_form_inherit" model="ir.ui.view">
			<field name="name">view.move.line.form.inherit</field>
			<field name="model">account.move.line</field>
			<field name="inherit_id" ref="account.view_move_line_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='partner_id']" position="after">
					<field name="practice_id"/>
				</xpath>
			</field>
		</record>
		<record id="view_account_move_line_filter_inherit" model="ir.ui.view">
			<field name="name">.view.account.move.line.filter.inherit</field>
			<field name="model">account.move.line</field>
			<field name="inherit_id" ref="account.view_account_move_line_filter"/>
			<field name="arch" type="xml">
				<xpath expr="//search/group" position="inside">
					<filter string="Practice" name="Practice" context="{'group_by':'practice_id'}"/>
				</xpath>
			</field>
		</record>
		<record id="view_account_move_filter_inherit" model="ir.ui.view">
			<field name="name">.view.account.move.filter.inherit</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_account_move_filter"/>
			<field name="arch" type="xml">
				<xpath expr="//search/group" position="inside">
					<filter string="Practice" name="Practice" context="{'group_by':'practice_id'}"/>
				</xpath>
			</field>
		</record>

	</data>
</odoo>