<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_practice_form" model="ir.ui.view">
            <field name="name">res.practice.form</field>
            <field name="model">res.practice</field>
            <field name="arch" type="xml">
                <form string="Practice">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="parent_practice_id" options="{'no_create': True}" />
                            <field name="child_practice_ids" readonly="1"/>
                        </group>
                        <notebook colspan="4">
                            <page string="Contact Information" name="contact_info">
                                <group>
                                    <group>
                                        <label for="street" string="Address"/>
                                        <div class="o_address_format">
                                            <field name="street" placeholder="Street..." class="o_address_street"/>
                                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                            <field name="city" placeholder="City" class="o_address_city"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True}'/>
                                        </div>
                                    </group>
                                    <group>
                                        <field name="partner_id" options='{"no_create": True}'/>
                                        <field name="phone" class="o_force_ltr"/>
                                        <field name="email"/>
                                        <field name="website" string="Website" widget="url" placeholder="e.g. https://www.odoo.com"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!--        tree view       -->
        <record id="view_practice_tree" model="ir.ui.view">
            <field name="name">res.practice.tree</field>
            <field name="model">res.practice</field>
            <field name="arch" type="xml">
                <tree string="Practices" sample="1">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="phone"/>
                </tree>
            </field>
        </record>
        <!--        search view     -->
        <record id="res_practice_search" model="ir.ui.view">
            <field name="name">res.practice.search</field>
            <field name="model">res.practice</field>
            <field name="arch" type="xml">
                <search string="Practices">
                    <field name="name" string="Practice"/>
                    <group expand="1" string="Group By">
                        <filter string="Company" name="groupby_company" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <!--        View action for practice views        -->
        <record id="action_res_practice_form" model="ir.actions.act_window">
            <field name="name">Practices</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.practice</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Create a new Practice
                </p>
                <p>
                Create and manage practices for the companies that will be managed by Odoo from here.
                </p>
            </field>
        </record>
        <!--        Menu item       -->
        <menuitem action="action_res_practice_form" id="menu_action_res_practice_form" parent="contacts.menu_contacts" sequence="1"/>
    </data>
</odoo>