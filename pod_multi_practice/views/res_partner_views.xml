<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="vat" position="after">
                    <field name="is_multiple_company" invisible="1"/>
                    <field name="is_practice_partner" invisible="1" />
                    <field name="practice_ids" options="{'no_create': True}" readonly="parent_id != False" force_save="1"/>
                    <field name="allowed_practice_ids" invisible="1"/>
                </field>
                <page name="contact_addresses" position="after">
                    <page name="Locations">
                        <field invisible="is_company == False" name="child_practice_ids" string="Practices"/>
                        <field invisible="is_company == True" name="practices_served_ids" string="Practices Served">
                            <tree editable="bottom" create="False" delete="True">
                                <field name="name"/>
                                <field name="parent_practice_id"/>
                                <field name="manager_id"/>
                                <field name="primary_physician_id"/>
                                <field name="patient_count"/>
                            </tree>
                        </field>
                    </page>
                </page>
            </field>
        </record>
    </data>
</odoo>
