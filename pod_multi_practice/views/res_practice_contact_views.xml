<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_practice_contact_view_form" model="ir.ui.view">
        <field name="name">res.practice.contact.view.form</field>
        <field name="model">res.practice.contact</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="parent_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
