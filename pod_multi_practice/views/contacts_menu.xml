<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <record id="action_view_accounts" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_company', '=', True)]</field>
    </record>

    <record id="action_view_practice" model="ir.actions.act_window">
        <field name="name">Podiatry Practices</field>
        <field name="res_model">res.practice</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="practices_view_search"/>
    </record>
    <record id="action_view_practice_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="action_view_practice"/>
        <field name="view_id" ref="res_practice_view_kanban"/>
    </record>
    <record id="action_view_practice_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="action_view_practice"/>
        <field name="view_id" ref="res_practice_view_list"/>
    </record>
    <record id="action_view_practice_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_view_practice"/>
        <field name="view_id" ref="res_practice_view_form"/>
    </record>

    <record id="action_view_patients" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.patient</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <!-- Define root menu for contacts -->

    <menuitem id="res_practice_menu_1" name="Accounts" parent="contacts.menu_contacts" action="action_view_accounts" sequence="1" />

    <menuitem id="res_practice_menu_2" name="Practices" parent="contacts.menu_contacts" action="action_view_practice" sequence="2"/>

    <menuitem id="contacts.res_partner_menu_contacts" name="Contacts" parent="contacts.menu_contacts" sequence="3"/>

    <menuitem id="res_patients_menu" name="Patients" parent="contacts.menu_contacts" action="action_view_patients" sequence="4"/>

    <!-- <menuitem id="suppliers_menu" name="Suppliers" parent="contacts.menu_contacts" action="contact_supplier_action" sequence="5"/> -->

    <menuitem id="contacts.res_partner_menu_config" name="Configuration" parent="contacts.menu_contacts" groups="base.group_system" sequence="10"/>






</odoo>
