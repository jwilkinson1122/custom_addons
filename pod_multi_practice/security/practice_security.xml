<?xml version="1.0" ?>
<odoo>

    <data noupdate="1">

        <!-- Record Rules For Practice -->
        <record id="res_practice_rule_portal" model="ir.rule">
            <field name="name">practice rule portal</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal')])]"/>
            <field name="domain_force">[('id','in', user.practice_ids.ids)]</field>
        </record>
        <record id="res_practice_rule_employee" model="ir.rule">
            <field name="name">practice rule employee</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="domain_force">[('id','in', user.practice_ids.ids)]</field>
        </record>
        <record id="res_practice_rule_public" model="ir.rule">
            <field name="name">practice rule public</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_public')])]"/>
            <field name="domain_force">[('id','in', user.practice_ids.ids)]</field>
        </record>
        <record id="res_practice_rule_erp_manager" model="ir.rule">
            <field name="name">practice rule erp manager</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- Multi - Practice Rules -->

        <record id="product_practice_rule" model="ir.rule">
            <field name="name">Product multi-practice</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="domain_force">['|',('practice_id','=',False),('practice_id', 'in', user.practice_ids.ids)]</field>
        </record>

        <record model="ir.rule" id="sale_order_practice_rule">
