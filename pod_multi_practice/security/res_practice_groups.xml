<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="module_category_podiatry_management" model="ir.module.category">
            <field name="name">Podiatry Practice Management</field>
        </record>

        <!-- Renaming group IDs to avoid duplicate constraint violations -->
        <record id="group_res_podiatry_user" model="res.groups">
            <field name="name">Podiatry Internal User</field>
            <field name="category_id" ref="module_category_podiatry_management"/>
            <field name="implied_ids" eval="[Command.set([ref('base.group_user'), ref('base.group_partner_manager')])]"/>
        </record>

        <record id="group_res_internal_user_podiatry" model="res.groups">
            <field name="name">Internal Podiatry User</field>
            <field name="category_id" ref="module_category_podiatry_management"/>
            <field name="implied_ids" eval="[Command.link(ref('group_res_podiatry_user'))]"/>
        </record>

        <record id="group_res_admin_podiatry" model="res.groups">
            <field name="name">Podiatry Administrator</field>
            <field name="category_id" ref="module_category_podiatry_management"/>
            <field name="implied_ids" eval="[Command.link(ref('group_res_internal_user_podiatry'))]"/>
        </record>
    </data>
</odoo>
