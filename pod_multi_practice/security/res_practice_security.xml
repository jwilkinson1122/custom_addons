        <!-- Record Rules For Practice -->
        <record id="res_practice_rule_portal" model="ir.rule">
            <field name="name">practice rule portal</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal')])]"/>
            <field name="domain_force">[('id','in', user.practice_ids.ids)]</field>
        </record>
        <record id="res_practice_rule_employee" model="ir.rule">
            <field name="name">practice rule employee</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="domain_force">[('id','in', user.practice_ids.ids)]</field>
        </record>
        <record id="res_practice_rule_public" model="ir.rule">
            <field name="name">practice rule public</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_public')])]"/>
            <field name="domain_force">[('id','in', user.practice_ids.ids)]</field>
        </record>
        <record id="res_practice_rule_erp_manager" model="ir.rule">
            <field name="name">practice rule erp manager</field>
            <field name="model_id" ref="model_res_practice"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- Refuse access to patient records that are not part of contact user's practices -->
        <record id="restrict_contact_access_to_practice_patients" model="ir.rule">
            <field name="name">Restrict Practice Contact Access to Their Patients Only</field>
            <field name="model_id" ref="model_res_patient"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [('practice_ids.contact_ids.user_ids', 'in', user.id)]
            </field>
        </record>
        <record id="restrict_contact_access_to_practices" model="ir.rule">
            <field name="name">Restrict Practice Contact Access to Their Practices Only</field>
            <field name="model_id" ref="model_res_practice"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [('contact_ids.user_ids', 'in', user.id)]
            </field>
        </record>
        <record id="restrict_contact_access_to_practice_pathologies" model="ir.rule">
            <field name="name">Restrict Practice Contact Access to Their Practices Only</field>
            <field name="model_id" ref="model_res_patient_pathology"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                [('patient_id.practice_ids.contact_ids.user_ids', 'in', user.id)]
            </field>
        </record>
