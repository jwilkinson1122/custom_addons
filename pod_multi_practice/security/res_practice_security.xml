        <record id="allow_practice_access_to_admins" model="ir.rule">
            <field name="name">Allow Practice Access to Administrators</field>
            <field name="model_id" ref="model_res_practice"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('pod_multi_practice.group_res_admin_podiatry')])]"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
