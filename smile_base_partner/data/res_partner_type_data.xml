<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

  <record id="partner_type_account" model="res.partner.type">
    <field name="name">Account</field>
    <field name="code">ACCOUNT</field>
    <field name="is_account" eval="True"/>
    <field name="is_affiliate" eval="False"/>
    <field name="is_supplier" eval="False"/>
  </record>
  <record id="partner_type_affiliate" model="res.partner.type">
    <field name="name">Affiliate</field>
    <field name="code">AFFILIATE</field>
    <field name="company_type">company</field>
    <field name="is_account" eval="False"/>
    <field name="is_affiliate" eval="True"/>
    <field name="is_supplier" eval="False"/>
    <field name="parent_is_required" eval="True"/>
    <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account')])]"/>
  </record>
  <record id="partner_type_supplier" model="res.partner.type">
    <field name="name">Supplier</field>
    <field name="code">SUPPLIER</field>
    <field name="is_account" eval="False"/>
    <field name="is_affiliate" eval="False"/>
    <field name="is_supplier" eval="True"/>
  </record>

  <record id="partner_type_contact" model="res.partner.type">
    <field name="name">Contact</field>
    <field name="code">CONTACT</field>
    <field name="company_type">person</field>
    <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account'), ref('partner_type_affiliate')])]"/>
    <field name="type">contact</field>
  </record>
  <record id="partner_type_patient" model="res.partner.type">
    <field name="name">Patient</field>
    <field name="code">PATIENT</field>
    <field name="company_type">person</field>
    <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account'), ref('partner_type_affiliate')])]"/>
    <field name="type">patient</field>
  </record>
  <record id="partner_type_invoice" model="res.partner.type">
    <field name="name">Invoice address</field>
    <field name="code">INVOICE</field>
    <field name="company_type">company</field>
    <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account'), ref('partner_type_affiliate'), ref('partner_type_supplier')])]"/>
    <field name="type">invoice</field>
  </record>
  <record id="partner_type_delivery" model="res.partner.type">
    <field name="name">Shipping address</field>
    <field name="code">DELIVERY</field>
    <field name="company_type">company</field>
    <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account'), ref('partner_type_affiliate'), ref('partner_type_supplier')])]"/>
    <field name="type">delivery</field>
  </record>
  <record id="partner_type_other" model="res.partner.type">
    <field name="name">Other address</field>
    <field name="code">OTHER</field>
    <field name="company_type">company</field>
    <field name="parent_type_ids" eval="[(6, 0, [ref('partner_type_account'), ref('partner_type_affiliate'), ref('partner_type_supplier')])]"/>
    <field name="type">other</field>
  </record>

</odoo>
