<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <h2>
                    <field name="ref" readonly="1"/>
                </h2>
                <div class="oe_title mb24">
                    <!-- <field name="company_type" options="{'horizontal': true}" widget="radio" groups="base.group_no_one"/> -->
                    <field name="company_type" options="{'horizontal': true}" widget="radio" invisible="1"/>
                    <field name="active" invisible="1"/>

                    <field name="is_account" invisible="1" />
                    <field name="is_company" invisible="1" />
                    <field name="is_affiliate" invisible="1" />
                    <field name="is_supplier" invisible="1" />
                    <!-- <field name="partner_type_id" class="oe_inline" widget="selection" domain="[('company_type', '=', company_type)]"/>
                    <field name="parent_relation_label" class="oe_inline" nolabel="1" invisible="can_have_parent == False or partner_type_id == False"/> -->

                    <h1>
                        <field id="company" name="name" options="{'line_breaks': False}" widget="text" default_focus="1" placeholder="e.g. Fab Foot Clinic" invisible="not is_company" required="is_company" />
                        <field id="individual" name="name" options="{'line_breaks': False}" widget="text" default_focus="1" placeholder="e.g. Brandon Freeman" invisible="is_company" required="type == 'contact' and not is_company" />
                    </h1>
                    <!-- <field name="partner_type_id" class="oe_inline" widget="selection" domain="[('company_type', '=', company_type)]"/>
                    <field name="parent_relation_label" class="oe_inline" nolabel="1" invisible="can_have_parent == False or partner_type_id == False"/> -->

                    <div class="o_row" style="margin-top:10px; margin-bottom:10px">
                        <field name="partner_type_id" class="oe_inline" widget="selection" domain="[('company_type', '=', company_type)]"/>
                        <field name="parent_relation_label" class="oe_inline" nolabel="1" invisible="can_have_parent == False or partner_type_id == False"/>
                        <field name="parent_id" placeholder="Parent Account" domain="[('is_account', '=', True), ('is_company', '=', True), ('id', '!=', 1)]" invisible="not is_company" class="fw-bold" />
                        <field name="parent_id" placeholder="Account / Location" domain="[('is_company', '=', True), ('id', '!=', 1)]" required="parent_is_required" invisible="is_company" class="fw-bold" />
                    </div>
                    <field name="can_have_parent" invisible="1"/>
                    <field name="parent_is_required" invisible="1"/>
                    <field name="parent_type_ids" invisible="1"/>
                </div>
            </xpath>
            <!-- <field name="parent_id" position="after">
                <field name="can_have_parent" invisible="1"/>
                <field name="parent_is_required" invisible="1"/>
                <field name="parent_type_ids" invisible="1"/>
            </field>
            <field name="parent_id" position="before">
                <field name="is_account" invisible="1"/>
                <field name="is_affiliate" invisible="1"/>
                <field name="is_supplier" invisible="1"/>
                <field name="partner_type_id" class="oe_inline" widget="selection" domain="[('company_type', '=', company_type)]"/>
                <field name="parent_relation_label" class="oe_inline" nolabel="1" invisible="can_have_parent == False or partner_type_id == False"/>
            </field>
            <field name="parent_id" position="attributes">
                <attribute name="invisible">can_have_parent == False or partner_type_id == False</attribute>
                <attribute name="required">parent_is_required</attribute>
                <attribute name="class">oe_inline</attribute>
                <attribute name="placeholder"></attribute>
                <attribute name="domain">[('is_account', '=', True), ('is_company', '=', True), ('id', '!=', 1)]</attribute>
            </field> -->
            <div name="button_box" position="inside">
                <!-- <button name="view_affiliates" type="object" class="oe_stat_button" icon="fa-building" invisible="affiliates_count == 0">
                    <span>
                        <field name="affiliates_count" widget="statinfo" nolabel="1"/>
                        <field name="affiliates_label"/>
                    </span>
                </button> -->
                <button name="view_affiliates" type="object" class="oe_stat_button" icon="fa-building" invisible="company_type == 'person'">
                    <span>
                        <field name="affiliates_count" widget="statinfo" nolabel="1"/>
                        <field name="affiliates_label"/>
                    </span>
                </button>
            </div>
            <!-- <field name="type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field> -->
            <xpath expr="//field[@name='child_ids']/form//field[@name='type']" position="before">
                <field name="partner_type_id" required="1" domain="[('company_type', '=', 'person')]" string="Address type" widget="radio" options="{'horizontal': true}"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_partner_address_form" model="ir.ui.view">
        <field name="name">res.partner.form.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_address_form"/>
        <field name="arch" type="xml">
            <!-- <field name="type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field> -->
            <field name="type" position="before">
                <field name="partner_type_id" required="1" domain="[('company_type', '=', 'person')]" class="oe_inline"/>
            </field>
        </field>
    </record>
    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">res.partner.select</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="type_person" position="after">
                <!-- <filter name="exclude_my_company" string="Exclude My Company" domain="[('id', '!=', 1)]"/> -->

                <filter name="is_account" string="Account" domain="[('is_account','=',1), '|', ('is_company', '=', True), ('parent_id', '=', False), ('id', '!=', 1)]" help="Accounts"/>
                <filter name="is_affiliate" string="Affiliate" domain="[('is_affiliate','=',1), '|', ('is_company', '=', True), ('parent_id', '=', True), ('id', '!=', 1)]" help="Affiliates"/>
                <filter name="is_supplier" string="Vendor" domain="[('is_supplier','=',1), '|', ('is_company', '=', True), ('parent_id', '=', False), ('id', '!=', 1)]" help="Vendors"/>
            </filter>
        </field>
    </record>
    <record id="view_res_partner_search" model="ir.ui.view">
        <field name="name">res.partner.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="is_account" position="attributes">
                <attribute name="domain">[('is_account', '=', True), '|', ('is_company', '=', True), ('parent_id', '=', False), ('id', '!=', 1)]</attribute>
            </filter>
            <filter name="is_affiliate" position="attributes">
                <attribute name="domain">[('is_affiliate', '=', True), '|', ('is_company', '=', True), ('parent_id', '=', True), ('id', '!=', 1)]</attribute>
            </filter>
            <filter name="is_supplier" position="attributes">
                <attribute name="domain">[('is_supplier', '=', True), '|', ('is_company', '=', True), ('parent_id', '=', False), ('id', '!=', 1)]</attribute>
            </filter>
            <!-- <filter name="is_account" position="attributes">
                <attribute name="domain">[('is_account', '=', True), '|', ('parent_id', '=', False), ('is_company', '=', True)]</attribute>
            </filter>
            <filter name="is_affiliate" position="attributes">
                <attribute name="domain">[('is_affiliate', '=', True), '|', ('parent_id', '=', True), ('is_company', '=', True)]</attribute>
            </filter>
            <filter name="is_supplier" position="attributes">
                <attribute name="domain">[('is_supplier', '=', True), '|', ('parent_id', '=', False), ('is_company', '=', True)]</attribute>
            </filter> -->
        </field>
    </record>
    <record id="action_accounts" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('company_type', '=', 'company'), ('id', '!=', 1)]</field>
        <field name="context">{'default_company_type': 'company', 'default_is_company': True}</field>
        <!-- <field name="domain">[('company_type', '=', 'company'), ('is_account', '=', True), ('id', '!=', 1)]</field>
        <field name="context">{'default_company_type': 'company', 'default_is_account': True}</field> -->
    </record>
    <!-- <record id="action_affiliates" model="ir.actions.act_window">
        <field name="name">Affiliates</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('company_type', '=', 'company'), ('is_affiliate', '=', True), ('id', '!=', 1)]</field>
        <field name="context">{'default_company_type': 'company', 'default_is_affiliate': True}
        </field>
    </record> -->
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_res_partner_search"/>
        <field name="domain">[('company_type', '=', 'person'), ('is_company', '=', False), ('id', '!=', 1)]</field>
        <field name="context">{'default_company_type': 'person', 'default_type': 'contact'}</field>
    </record>
    <record id="action_patients" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('company_type', '=', 'person'), ('is_company', '=', False), ('id', '!=', 1)]</field>
        <field name="context">{'default_company_type': 'person', 'default_type':'patient'}
        </field>
    </record>

    <menuitem id="contacts.menu_contacts" name="Customers" sequence="20" web_icon="contacts,static/description/icon.png" groups="base.group_user,base.group_partner_manager"/>
    <!-- <menuitem id="customer_companies_menu" name="Companies &amp; Affiliates" parent="contacts.menu_contacts" action="action_accounts" sequence="1"/> -->
    <menuitem id="customer_companies_menu" name="Companies" parent="contacts.menu_contacts" action="action_accounts" sequence="1"/>

    <menuitem id="contacts.res_partner_menu_contacts" name="Contacts" parent="contacts.menu_contacts" sequence="2"/>
    <menuitem id="customer_contacts_menu" name="Contacts" parent="contacts.res_partner_menu_contacts" action="contacts.action_contacts" sequence="10"/>
    <menuitem id="customer_patients_menu" name="Patients" parent="contacts.res_partner_menu_contacts" action="action_patients" sequence="20"/>


